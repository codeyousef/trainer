import trainer.gpu_tensor_ops.{tensorGpuAttentionContext, tensorGpuBinary, tensorGpuGeluBackward, tensorGpuMatmul, tensorGpuNormalizeRows}
import trainer.tensor.{Tensor, tensorGeluDerivativeScalar, tripletMarginLossBackend, tripletMarginLossRows}
import trainer.tensor_kernels.{trainerTensorKernelDeclarationCount}

fun expect(condition: Bool, message: String) r: Void {
    if not condition {
        abort(message)
    }
}

fun approx(value: Float, expected: Float) r: Bool {
    let diff = if value > expected { value - expected } else { expected - value }
    return diff < 0.001
}

fun expectApproxArray(values: Array<Float>, expected: Array<Float>, message: String) r: Void {
    expect(values.length() == expected.length(), message + " length")
    var i = 0
    while i < values.length() {
        expect(approx(values[i], expected[i]), message)
        i = i + 1
    }
}

fun main() -> Int {
    expect(trainerTensorKernelDeclarationCount() >= 16, "gpu tensor kernel declarations available")
    let a = Array<Float>()
    a.push(1.0)
    a.push(2.0)
    a.push(3.0)
    a.push(4.0)
    let b = Array<Float>()
    b.push(5.0)
    b.push(6.0)
    b.push(7.0)
    b.push(8.0)

    let added = tensorGpuBinary(a, b, 2, 2, "tensorElementwiseAdd")
    if added.ok == 0 {
        println("SKIP test_gpu_tensor: GPU dispatch unavailable")
        return 0
    }
    expect(approx(added.values[0], 6.0), "gpu add 0")
    expect(approx(added.values[3], 12.0), "gpu add 3")

    let product = tensorGpuMatmul(a, b, 2, 2, 2)
    expect(product.ok == 1, "gpu matmul dispatch")
    expect(approx(product.values[0], 19.0), "gpu matmul 00")
    expect(approx(product.values[1], 22.0), "gpu matmul 01")
    expect(approx(product.values[2], 43.0), "gpu matmul 10")
    expect(approx(product.values[3], 50.0), "gpu matmul 11")

    let gradVals = Array<Float>()
    gradVals.push(1.0)
    gradVals.push(2.0)
    gradVals.push(3.0)
    gradVals.push(4.0)
    let weightVals = Array<Float>()
    weightVals.push(0.5)
    weightVals.push(1.0)
    weightVals.push(1.5)
    weightVals.push(2.0)
    weightVals.push(2.5)
    weightVals.push(3.0)
    let gradOut = Tensor.fromArray(2, 2, gradVals, "gpu")
    let denseWeight = Tensor.fromArray(2, 3, weightVals, "gpu")
    let gradInput = gradOut.denseInputGradient(denseWeight)
    expect(approx(gradInput.at(0, 0), 4.5), "gpu dense input grad 00")
    expect(approx(gradInput.at(1, 2), 16.5), "gpu dense input grad 12")

    let inputVals = Array<Float>()
    inputVals.push(1.0)
    inputVals.push(0.0)
    inputVals.push(2.0)
    inputVals.push(0.5)
    inputVals.push(1.5)
    inputVals.push(-1.0)
    let denseInput = Tensor.fromArray(2, 3, inputVals, "gpu")
    let gradWeight = gradOut.denseWeightGradient(denseInput)
    expect(approx(gradWeight.at(0, 0), 2.5), "gpu dense weight grad 00")
    expect(approx(gradWeight.at(1, 1), 6.0), "gpu dense weight grad 11")
    let biasGrad = gradOut.denseBiasGradient()
    expect(approx(biasGrad[0], 4.0) and approx(biasGrad[1], 6.0), "gpu dense bias grad")
    let geluPreVals = Array<Float>()
    geluPreVals.push(-1.0)
    geluPreVals.push(0.0)
    geluPreVals.push(1.0)
    geluPreVals.push(2.0)
    let geluGradVals = Array<Float>()
    geluGradVals.push(1.0)
    geluGradVals.push(0.5)
    geluGradVals.push(-0.25)
    geluGradVals.push(2.0)
    let geluPre = Tensor.fromArray(2, 2, geluPreVals, "gpu")
    let geluGrad = Tensor.fromArray(2, 2, geluGradVals, "gpu")
    let fusedGeluBack = tensorGpuGeluBackward(geluPreVals, geluGradVals, 2, 2)
    expect(fusedGeluBack.ok == 1, "gpu fused gelu backward dispatch")
    expect(approx(fusedGeluBack.values[0], tensorGeluDerivativeScalar(-1.0)), "gpu fused gelu backward negative")
    let geluBack = geluPre.geluBackward(geluGrad)
    expect(approx(geluBack.at(0, 0), tensorGeluDerivativeScalar(-1.0)), "gpu gelu backward negative")
    expect(approx(geluBack.at(0, 1), 0.5 * tensorGeluDerivativeScalar(0.0)), "gpu gelu backward zero")
    expect(approx(geluBack.at(1, 0), -0.25 * tensorGeluDerivativeScalar(1.0)), "gpu gelu backward positive")
    expect(approx(geluBack.at(1, 1), 2.0 * tensorGeluDerivativeScalar(2.0)), "gpu gelu backward large")
    let softIn = Tensor.fromArray(2, 2, a, "gpu")
    let softmax = softIn.softmaxRows()
    let softGradVals = Array<Float>()
    softGradVals.push(0.2)
    softGradVals.push(-0.1)
    softGradVals.push(0.4)
    softGradVals.push(-0.2)
    let softGrad = Tensor.fromArray(2, 2, softGradVals, "gpu")
    let softBack = softmax.softmaxBackwardRows(softGrad)
    let row0Dot = softmax.at(0, 0) * 0.2 + softmax.at(0, 1) * -0.1
    let row1Dot = softmax.at(1, 0) * 0.4 + softmax.at(1, 1) * -0.2
    expect(approx(softBack.at(0, 0), softmax.at(0, 0) * (0.2 - row0Dot)), "gpu softmax backward 00")
    expect(approx(softBack.at(0, 1), softmax.at(0, 1) * (-0.1 - row0Dot)), "gpu softmax backward 01")
    expect(approx(softBack.at(1, 0), softmax.at(1, 0) * (0.4 - row1Dot)), "gpu softmax backward 10")
    expect(approx(softBack.at(1, 1), softmax.at(1, 1) * (-0.2 - row1Dot)), "gpu softmax backward 11")
    let normVals = Array<Float>()
    normVals.push(3.0)
    normVals.push(4.0)
    normVals.push(0.0)
    normVals.push(0.0)
    let normalizedRows = tensorGpuNormalizeRows(normVals, 2, 2)
    expect(normalizedRows.ok == 1, "gpu normalize rows dispatch")
    expect(approx(normalizedRows.values[0], 0.6), "gpu normalize row 00")
    expect(approx(normalizedRows.values[1], 0.8), "gpu normalize row 01")
    expect(approx(normalizedRows.values[2], 0.0) and approx(normalizedRows.values[3], 0.0), "gpu normalize zero row")
    let qCtx = Array<Float>()
    qCtx.push(1.0)
    qCtx.push(0.0)
    qCtx.push(0.0)
    qCtx.push(1.0)
    qCtx.push(0.0)
    qCtx.push(1.0)
    qCtx.push(1.0)
    qCtx.push(0.0)
    let kCtx = Array<Float>()
    kCtx.push(1.0)
    kCtx.push(0.0)
    kCtx.push(0.0)
    kCtx.push(1.0)
    kCtx.push(0.0)
    kCtx.push(1.0)
    kCtx.push(1.0)
    kCtx.push(0.0)
    let vCtx = Array<Float>()
    vCtx.push(1.0)
    vCtx.push(2.0)
    vCtx.push(3.0)
    vCtx.push(4.0)
    vCtx.push(5.0)
    vCtx.push(6.0)
    vCtx.push(7.0)
    vCtx.push(8.0)
    let expectedContext = Array<Float>()
    expectedContext.push(2.320)
    expectedContext.push(3.320)
    expectedContext.push(4.320)
    expectedContext.push(5.320)
    expectedContext.push(3.679)
    expectedContext.push(4.679)
    expectedContext.push(5.679)
    expectedContext.push(6.679)
    let fusedContext = tensorGpuAttentionContext(qCtx, kCtx, vCtx, 2, 4, 2)
    expect(fusedContext.ok == 1, "gpu fused attention context dispatch")
    expectApproxArray(fusedContext.values, expectedContext, "gpu fused attention context")
    let qLoss = Array<Float>()
    qLoss.push(1.0)
    qLoss.push(0.0)
    let pLoss = Array<Float>()
    pLoss.push(1.0)
    pLoss.push(0.0)
    let nLoss = Array<Float>()
    nLoss.push(0.0)
    nLoss.push(1.0)
    expect(approx(tripletMarginLossBackend(qLoss, pLoss, nLoss, 0.2, "gpu"), 0.0), "gpu triplet loss easy")
    let batchQ = Array<Float>()
    batchQ.push(1.0)
    batchQ.push(0.0)
    batchQ.push(0.0)
    batchQ.push(1.0)
    let batchP = Array<Float>()
    batchP.push(1.0)
    batchP.push(0.0)
    batchP.push(1.0)
    batchP.push(0.0)
    let batchN = Array<Float>()
    batchN.push(0.0)
    batchN.push(1.0)
    batchN.push(0.0)
    batchN.push(1.0)
    let batchLosses = tripletMarginLossRows(batchQ, batchP, batchN, 2, 2, 0.2, "gpu")
    expect(batchLosses.length() == 2, "gpu triplet loss rows count")
    expect(approx(batchLosses[0], 0.0), "gpu triplet loss rows easy")
    expect(approx(batchLosses[1], 1.2), "gpu triplet loss rows hard")
    println("PASS test_gpu_tensor")
    return 0
}
