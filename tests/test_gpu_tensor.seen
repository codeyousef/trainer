import trainer.gpu_tensor_ops.{tensorGpuBinary, tensorGpuMatmul}
import trainer.tensor.{Tensor, tensorGeluDerivativeScalar}
import trainer.tensor_kernels.{trainerTensorKernelDeclarationCount}

fun expect(condition: Bool, message: String) r: Void {
    if not condition {
        abort(message)
    }
}

fun approx(value: Float, expected: Float) r: Bool {
    let diff = if value > expected { value - expected } else { expected - value }
    return diff < 0.001
}

fun main() -> Int {
    expect(trainerTensorKernelDeclarationCount() >= 13, "gpu tensor kernel declarations available")
    let a = Array<Float>()
    a.push(1.0)
    a.push(2.0)
    a.push(3.0)
    a.push(4.0)
    let b = Array<Float>()
    b.push(5.0)
    b.push(6.0)
    b.push(7.0)
    b.push(8.0)

    let added = tensorGpuBinary(a, b, 2, 2, "tensorElementwiseAdd")
    if added.ok == 0 {
        println("SKIP test_gpu_tensor: GPU dispatch unavailable")
        return 0
    }
    expect(approx(added.values[0], 6.0), "gpu add 0")
    expect(approx(added.values[3], 12.0), "gpu add 3")

    let product = tensorGpuMatmul(a, b, 2, 2, 2)
    expect(product.ok == 1, "gpu matmul dispatch")
    expect(approx(product.values[0], 19.0), "gpu matmul 00")
    expect(approx(product.values[1], 22.0), "gpu matmul 01")
    expect(approx(product.values[2], 43.0), "gpu matmul 10")
    expect(approx(product.values[3], 50.0), "gpu matmul 11")

    let gradVals = Array<Float>()
    gradVals.push(1.0)
    gradVals.push(2.0)
    gradVals.push(3.0)
    gradVals.push(4.0)
    let weightVals = Array<Float>()
    weightVals.push(0.5)
    weightVals.push(1.0)
    weightVals.push(1.5)
    weightVals.push(2.0)
    weightVals.push(2.5)
    weightVals.push(3.0)
    let gradOut = Tensor.fromArray(2, 2, gradVals, "gpu")
    let denseWeight = Tensor.fromArray(2, 3, weightVals, "gpu")
    let gradInput = gradOut.denseInputGradient(denseWeight)
    expect(approx(gradInput.at(0, 0), 4.5), "gpu dense input grad 00")
    expect(approx(gradInput.at(1, 2), 16.5), "gpu dense input grad 12")

    let inputVals = Array<Float>()
    inputVals.push(1.0)
    inputVals.push(0.0)
    inputVals.push(2.0)
    inputVals.push(0.5)
    inputVals.push(1.5)
    inputVals.push(-1.0)
    let denseInput = Tensor.fromArray(2, 3, inputVals, "gpu")
    let gradWeight = gradOut.denseWeightGradient(denseInput)
    expect(approx(gradWeight.at(0, 0), 2.5), "gpu dense weight grad 00")
    expect(approx(gradWeight.at(1, 1), 6.0), "gpu dense weight grad 11")
    let biasGrad = gradOut.denseBiasGradient()
    expect(approx(biasGrad[0], 4.0) and approx(biasGrad[1], 6.0), "gpu dense bias grad")
    let geluPreVals = Array<Float>()
    geluPreVals.push(-1.0)
    geluPreVals.push(0.0)
    geluPreVals.push(1.0)
    geluPreVals.push(2.0)
    let geluGradVals = Array<Float>()
    geluGradVals.push(1.0)
    geluGradVals.push(0.5)
    geluGradVals.push(-0.25)
    geluGradVals.push(2.0)
    let geluPre = Tensor.fromArray(2, 2, geluPreVals, "gpu")
    let geluGrad = Tensor.fromArray(2, 2, geluGradVals, "gpu")
    let geluBack = geluPre.geluBackward(geluGrad)
    expect(approx(geluBack.at(0, 0), tensorGeluDerivativeScalar(-1.0)), "gpu gelu backward negative")
    expect(approx(geluBack.at(0, 1), 0.5 * tensorGeluDerivativeScalar(0.0)), "gpu gelu backward zero")
    expect(approx(geluBack.at(1, 0), -0.25 * tensorGeluDerivativeScalar(1.0)), "gpu gelu backward positive")
    expect(approx(geluBack.at(1, 1), 2.0 * tensorGeluDerivativeScalar(2.0)), "gpu gelu backward large")
    println("PASS test_gpu_tensor")
    return 0
}
