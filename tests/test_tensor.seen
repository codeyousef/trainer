import trainer.math_utils.{cosine}
import trainer.optimizer.{AdamW, clipGlobalNorm}
import trainer.dense_lora.{DenseDeltaAdapter, LayerNormDeltaAdapter}
import trainer.tensor.{Parameter, Tensor, tensorGeluDerivativeScalar, tripletMarginLoss}

fun expect(condition: Bool, message: String) r: Void {
    if not condition {
        abort(message)
    }
}

fun closeEnough(value: Float, expected: Float) r: Bool {
    let diff = value - expected
    if diff < 0.0 {
        return (0.0 - diff) < 0.0001
    }
    return diff < 0.0001
}

fun main() -> Int {
    let aVals = Array<Float>()
    aVals.push(1.0)
    aVals.push(2.0)
    aVals.push(3.0)
    aVals.push(4.0)
    let bVals = Array<Float>()
    bVals.push(5.0)
    bVals.push(6.0)
    bVals.push(7.0)
    bVals.push(8.0)
    let a = Tensor.fromArray(2, 2, aVals)
    let b = Tensor.fromArray(2, 2, bVals)
    let c = a.matmul(b)
    expect(c.at(0, 0) == 19.0, "matmul 00")
    expect(c.at(0, 1) == 22.0, "matmul 01")
    expect(c.at(1, 0) == 43.0, "matmul 10")
    expect(c.at(1, 1) == 50.0, "matmul 11")
    let transposed = a.transpose()
    expect(transposed.shape.rows == 2 and transposed.shape.cols == 2, "transpose shape")
    expect(transposed.at(0, 1) == 3.0 and transposed.at(1, 0) == 2.0, "transpose values")
    let columnSums = a.columnSums()
    expect(columnSums[0] == 4.0 and columnSums[1] == 6.0, "column reduction")

    let gradVals = Array<Float>()
    gradVals.push(1.0)
    gradVals.push(2.0)
    gradVals.push(3.0)
    gradVals.push(4.0)
    let weightVals = Array<Float>()
    weightVals.push(0.5)
    weightVals.push(1.0)
    weightVals.push(1.5)
    weightVals.push(2.0)
    weightVals.push(2.5)
    weightVals.push(3.0)
    let gradOut = Tensor.fromArray(2, 2, gradVals)
    let denseWeight = Tensor.fromArray(2, 3, weightVals)
    let gradInput = gradOut.denseInputGradient(denseWeight)
    expect(closeEnough(gradInput.at(0, 0), 4.5), "dense input grad 00")
    expect(closeEnough(gradInput.at(0, 2), 7.5), "dense input grad 02")
    expect(closeEnough(gradInput.at(1, 1), 13.0), "dense input grad 11")
    expect(closeEnough(gradInput.at(1, 2), 16.5), "dense input grad 12")
    let inputVals = Array<Float>()
    inputVals.push(1.0)
    inputVals.push(0.0)
    inputVals.push(2.0)
    inputVals.push(0.5)
    inputVals.push(1.5)
    inputVals.push(-1.0)
    let denseInput = Tensor.fromArray(2, 3, inputVals)
    let gradWeight = gradOut.denseWeightGradient(denseInput)
    expect(closeEnough(gradWeight.at(0, 0), 2.5), "dense weight grad 00")
    expect(closeEnough(gradWeight.at(0, 1), 4.5), "dense weight grad 01")
    expect(closeEnough(gradWeight.at(0, 2), -1.0), "dense weight grad 02")
    expect(closeEnough(gradWeight.at(1, 0), 4.0), "dense weight grad 10")
    expect(closeEnough(gradWeight.at(1, 1), 6.0), "dense weight grad 11")
    expect(closeEnough(gradWeight.at(1, 2), 0.0), "dense weight grad 12")
    let biasGrad = gradOut.denseBiasGradient()
    expect(closeEnough(biasGrad[0], 4.0) and closeEnough(biasGrad[1], 6.0), "dense bias grad")
    let geluPreVals = Array<Float>()
    geluPreVals.push(-1.0)
    geluPreVals.push(0.0)
    geluPreVals.push(1.0)
    geluPreVals.push(2.0)
    let geluGradVals = Array<Float>()
    geluGradVals.push(1.0)
    geluGradVals.push(0.5)
    geluGradVals.push(-0.25)
    geluGradVals.push(2.0)
    let geluPre = Tensor.fromArray(2, 2, geluPreVals)
    let geluGrad = Tensor.fromArray(2, 2, geluGradVals)
    let geluBack = geluPre.geluBackward(geluGrad)
    expect(closeEnough(geluBack.at(0, 0), tensorGeluDerivativeScalar(-1.0)), "gelu backward negative")
    expect(closeEnough(geluBack.at(0, 1), 0.5 * tensorGeluDerivativeScalar(0.0)), "gelu backward zero")
    expect(closeEnough(geluBack.at(1, 0), -0.25 * tensorGeluDerivativeScalar(1.0)), "gelu backward positive")
    expect(closeEnough(geluBack.at(1, 1), 2.0 * tensorGeluDerivativeScalar(2.0)), "gelu backward large")
    let added = a.add(b)
    expect(added.at(0, 0) == 6.0 and added.at(1, 1) == 12.0, "elementwise add")
    let diff = b.sub(a)
    expect(diff.at(0, 0) == 4.0 and diff.at(1, 1) == 4.0, "elementwise sub")
    let product = a.mulElementwise(b)
    expect(product.at(0, 1) == 12.0 and product.at(1, 0) == 21.0, "elementwise mul")
    let scaled = a.scale(0.5)
    expect(scaled.at(0, 0) == 0.5 and scaled.at(1, 1) == 2.0, "tensor scale")
    let sums = a.sumRows()
    expect(sums[0] == 3.0 and sums[1] == 7.0, "row reduction")
    let mask = Array<Int>()
    mask.push(1)
    mask.push(0)
    let pooled = a.meanPool(mask)
    expect(pooled[0] == 1.0 and pooled[1] == 2.0, "masked mean pooling")
    let softmax = a.softmaxRows()
    let row0SoftmaxSum = softmax.at(0, 0) + softmax.at(0, 1)
    expect(row0SoftmaxSum > 0.999 and row0SoftmaxSum < 1.001, "softmax row sum")
    expect(softmax.at(0, 1) > softmax.at(0, 0), "softmax order")
    let softGradVals = Array<Float>()
    softGradVals.push(0.2)
    softGradVals.push(-0.1)
    softGradVals.push(0.4)
    softGradVals.push(-0.2)
    let softGrad = Tensor.fromArray(2, 2, softGradVals)
    let softBack = softmax.softmaxBackwardRows(softGrad)
    let row0Dot = softmax.at(0, 0) * 0.2 + softmax.at(0, 1) * -0.1
    let row1Dot = softmax.at(1, 0) * 0.4 + softmax.at(1, 1) * -0.2
    expect(closeEnough(softBack.at(0, 0), softmax.at(0, 0) * (0.2 - row0Dot)), "softmax backward 00")
    expect(closeEnough(softBack.at(0, 1), softmax.at(0, 1) * (-0.1 - row0Dot)), "softmax backward 01")
    expect(closeEnough(softBack.at(1, 0), softmax.at(1, 0) * (0.4 - row1Dot)), "softmax backward 10")
    expect(closeEnough(softBack.at(1, 1), softmax.at(1, 1) * (-0.2 - row1Dot)), "softmax backward 11")
    let normalized = a.layerNormRows()
    expect(normalized.at(0, 0) < -0.99 and normalized.at(0, 1) > 0.99, "layer norm row")
    let kept = a.dropoutDeterministic(1.0, 42)
    expect(kept.at(1, 1) == 4.0, "dropout keep all")
    let sim = cosine(a.row(0), a.row(0))
    expect(sim > 0.999, "cosine self")
    let q = Array<Float>()
    q.push(1.0)
    q.push(0.0)
    let p = Array<Float>()
    p.push(1.0)
    p.push(0.0)
    let n = Array<Float>()
    n.push(0.0)
    n.push(1.0)
    expect(tripletMarginLoss(q, p, n, 0.2) == 0.0, "triplet loss easy")
    let hardLoss = tripletMarginLoss(q, n, p, 0.2)
    expect(hardLoss > 1.19 and hardLoss < 1.21, "triplet loss hard")
    let top = a.topKInnerProductIndices(q, 2)
    expect(top[0] == 1 and top[1] == 0, "top-k inner product")
    let param = Parameter.zeros(1)
    param.value[0] = 1.0
    param.grad[0] = 0.1
    let adam = AdamW.new(0.01, 0.1)
    adam.step(param)
    expect(param.value[0] > 0.9889 and param.value[0] < 0.9891, "adamw first step")
    let clipParam = Parameter.zeros(2)
    clipParam.grad[0] = 3.0
    clipParam.grad[1] = 4.0
    let norm = clipGlobalNorm(clipParam, 1.0)
    expect(norm > 4.999 and norm < 5.001, "clip norm return")
    expect(clipParam.grad[0] > 0.599 and clipParam.grad[0] < 0.601, "clip grad x")
    expect(clipParam.grad[1] > 0.799 and clipParam.grad[1] < 0.801, "clip grad y")
    let denseBaseWeight = Array<Float>()
    denseBaseWeight.push(2.0)
    denseBaseWeight.push(-1.0)
    denseBaseWeight.push(0.5)
    denseBaseWeight.push(4.0)
    let denseBaseBias = Array<Float>()
    denseBaseBias.push(-1.0)
    denseBaseBias.push(3.0)
    let zeroDenseGrad = Array<Float>()
    zeroDenseGrad.push(0.0)
    zeroDenseGrad.push(0.0)
    zeroDenseGrad.push(0.0)
    zeroDenseGrad.push(0.0)
    let zeroBiasGrad = Array<Float>()
    zeroBiasGrad.push(0.0)
    zeroBiasGrad.push(0.0)
    let denseDelta = DenseDeltaAdapter.identity(2, 2)
    expect(denseDelta.applyBaseParameterGradients(denseBaseWeight, denseBaseBias, zeroDenseGrad, zeroBiasGrad, 0.1, 0.1, 0.0), "dense base parameter update")
    expect(closeEnough(denseDelta.weightDelta[0], -0.02), "dense base weight decay delta")
    expect(closeEnough(denseDelta.weightDelta[1], 0.01), "dense base negative weight decay delta")
    expect(closeEnough(denseDelta.biasDelta[0], 0.01), "dense base bias decay delta")
    expect(closeEnough(denseDelta.biasDelta[1], -0.03), "dense base positive bias decay delta")
    let lnBaseWeight = Array<Float>()
    lnBaseWeight.push(1.5)
    lnBaseWeight.push(0.5)
    let lnBaseBias = Array<Float>()
    lnBaseBias.push(0.4)
    lnBaseBias.push(-0.2)
    let zeroLnGrad = Array<Float>()
    zeroLnGrad.push(0.0)
    zeroLnGrad.push(0.0)
    let lnDelta = LayerNormDeltaAdapter.identity(2)
    expect(lnDelta.applyBaseParameterGradients(lnBaseWeight, lnBaseBias, zeroLnGrad, zeroLnGrad, 0.1, 0.1, 0.0), "layernorm base parameter update")
    expect(closeEnough(lnDelta.weightDelta[0], -0.015), "layernorm base weight decay delta")
    expect(closeEnough(lnDelta.weightDelta[1], -0.005), "layernorm base second weight decay delta")
    expect(closeEnough(lnDelta.biasDelta[0], -0.004), "layernorm base bias decay delta")
    expect(closeEnough(lnDelta.biasDelta[1], 0.002), "layernorm base negative bias decay delta")
    println("PASS test_tensor")
    return 0
}
