import trainer.config.{TrainerConfig, readConfig, writeTrainerConfigJson}
import trainer.calibration.{DomainThreshold, loadThresholds, thresholdsJson}
import trainer.encoder.{Encoder}
import trainer.io.file.{deleteFile, exists}
import trainer.io_utils.{writeAtomicText}
import trainer.jsonl.{PairExample, TripletExample, readTripletsLimited}
import trainer.miner.{MiningEmbeddingMatrix, buildPositiveEmbeddingMatrix, buildPositiveEmbeddingMatrixBackend, findNegativeIndexWithMatrix, initializedFloatArray, initializedIntArray, insertTopCandidate, mineHardNegatives, normalizedTopK}
import trainer.pipeline.{Pipeline}
import trainer.tokenizer.{Tokenizer}
import trainer.training.{batchesPerEpoch, countTrainableTriplets, effectiveBatchSize}

fun expect(condition: Bool, message: String) r: Void {
    if not condition {
        abort(message)
    }
}

fun closeEnough(value: Float, expected: Float) r: Bool {
    let diff = if value > expected { value - expected } else { expected - value }
    return diff < 0.001
}

fun matrixRowSquareSum(matrix: MiningEmbeddingMatrix, row: Int) r: Float {
    var sum = 0.0
    if not matrix.ok or row < 0 or row >= matrix.rows {
        return sum
    }
    var col = 0
    while col < matrix.cols {
        let value = matrix.values[row * matrix.cols + col]
        sum = sum + value * value
        col = col + 1
    }
    return sum
}

fun stringContains(text: String, needle: String) r: Bool {
    if needle.length() == 0 {
        return true
    }
    if needle.length() > text.length() {
        return false
    }
    var i = 0
    while i <= text.length() - needle.length() {
        var matched = true
        var j = 0
        while j < needle.length() {
            if text.charAt(i + j) != needle.charAt(j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    return false
}

fun cleanPipelineOutputs() r: Void {
    let _ = deleteFile("/tmp/seen_trainer_test/out/mined.jsonl")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/training_config.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/thresholds.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/eval_results.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/modules.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/sentence_bert_config.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/1_Pooling/config.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/README.md")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/adapter.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/layer_adapter.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/minilm_layer_adapter.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_trainer_capabilities.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/minilm_parameter_registry.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/minilm_weight_map.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/model.safetensors.manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_adapter_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_layer_adapter_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_layer_adapter_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_dense_adapter_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_dense_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_embedding_deltas_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_all_layer_deltas_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_intermediate_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_query_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_key_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_value_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_attention_dense_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_attention_layernorm_delta_manifest.json")
    let _ = deleteFile("/tmp/seen_trainer_test/out/model/seen_minilm_layernorm_delta_manifest.json")
}

fun main() -> Int {
    expect(normalizedTopK(16, 3) == 3, "top k clamps to candidate count")
    expect(normalizedTopK(0, 3) == 1, "top k defaults to one candidate")
    let topIdx = initializedIntArray(2, -1)
    let topScores = initializedFloatArray(2, -999999.0)
    insertTopCandidate(topIdx, topScores, 10, 0.2)
    insertTopCandidate(topIdx, topScores, 11, 0.9)
    insertTopCandidate(topIdx, topScores, 12, 0.4)
    expect(topIdx[0] == 11, "top k highest candidate first")
    expect(topIdx[1] == 12, "top k second candidate retained")
    expect(effectiveBatchSize(64, 3) == 3, "small fixtures clamp effective batch")
    expect(batchesPerEpoch(130, 64) == 2, "drop final partial batch")
    let trainableFixture = Array<TripletExample>()
    trainableFixture.push(TripletExample.new("q", "p", "", "d", "s"))
    trainableFixture.push(TripletExample.new("q2", "p2", "n2", "d", "s2"))
    expect(countTrainableTriplets(trainableFixture) == 1, "trainable triplet count ignores empty negatives")

    let miningPairs = Array<PairExample>()
    miningPairs.push(PairExample.new("alpha question", "alpha answer", "alpha", "one"))
    miningPairs.push(PairExample.new("alpha related", "alpha nearby answer", "alpha", "two"))
    miningPairs.push(PairExample.new("beta question", "beta answer", "beta", "three"))
    let miningEncoder = Encoder.new(Tokenizer.load("/tmp/seen_trainer_missing_tokenizer/tokenizer.json", 16), 16)
    let positiveMatrix = buildPositiveEmbeddingMatrix(miningPairs, miningEncoder)
    expect(positiveMatrix.ok, "mining positive matrix built")
    expect(positiveMatrix.rows == 3 and positiveMatrix.cols == 16, "mining matrix shape")
    let gpuPositiveMatrix = buildPositiveEmbeddingMatrixBackend(miningPairs, miningEncoder, "gpu")
    expect(gpuPositiveMatrix.ok, "gpu mining positive matrix built")
    expect(closeEnough(matrixRowSquareSum(gpuPositiveMatrix, 0), 1.0), "backend mining matrix normalized")
    let queryEmbedding = miningEncoder.encode("alpha question")
    let cpuNeg = findNegativeIndexWithMatrix(miningPairs, 0, queryEmbedding, positiveMatrix, 3, "cpu")
    expect(cpuNeg == 2, "matrix mining excludes same domain")
    let gpuNeg = findNegativeIndexWithMatrix(miningPairs, 0, queryEmbedding, positiveMatrix, 3, "gpu")
    expect(gpuNeg == 2, "gpu mining path preserves fallback semantics")

    let preMinedPath = "/tmp/seen_trainer_test/premined.jsonl"
    let preMinedOut = "/tmp/seen_trainer_test/premined_mined.jsonl"
    writeAtomicText(preMinedPath,
        "{\"query_text\":\"kept query\",\"positive_chunk_text\":\"kept positive\",\"hard_negative_chunk_text\":\"kept negative\",\"domain\":\"d\",\"source\":\"s\"}\n"
        + "{\"query_text\":\"second query\",\"positive_chunk_text\":\"second positive\",\"hard_negative_chunk_text\":\"second negative\",\"domain\":\"d2\",\"source\":\"s2\"}\n")
    let preMinedSeedCfg = TrainerConfig.defaults()
    preMinedSeedCfg.trainJsonlPath = preMinedPath
    preMinedSeedCfg.minedJsonlPath = preMinedOut
    preMinedSeedCfg.maxMinedTriplets = 1
    preMinedSeedCfg.embeddingDim = 16
    preMinedSeedCfg.maxSequenceLength = 16
    preMinedSeedCfg.backend = "cpu"
    writeTrainerConfigJson("/tmp/seen_trainer_test/premined_config.json", preMinedSeedCfg, false)
    let preMinedCfg = readConfig("/tmp/seen_trainer_test/premined_config.json")
    expect(preMinedCfg.minedJsonlPath == preMinedOut, "pre-mined mined path config")
    let preMinedResult = mineHardNegatives(preMinedCfg, miningEncoder)
    expect(preMinedResult.count == 1, "pre-mined mining count")
    let preMinedRows = readTripletsLimited(preMinedOut, 0)
    expect(preMinedRows.length() == 1, "pre-mined output row count")
    expect(preMinedRows[0].hardNegativeChunkText == "kept negative", "pre-mined hard negative preserved")

    let escapedThresholds = Array<DomainThreshold>()
    escapedThresholds.push(DomainThreshold.new("quoted \"domain\" \\ source", 0.4, 1))
    let escapedThresholdJson = thresholdsJson(escapedThresholds)
    expect(stringContains(escapedThresholdJson, "\"quoted \\\"domain\\\" \\\\ source\""), "threshold domain json escaping")
    writeAtomicText("/tmp/seen_trainer_test/threshold_load.json", escapedThresholdJson)
    let loadedThresholds = loadThresholds("/tmp/seen_trainer_test/threshold_load.json")
    expect(loadedThresholds.length() == 1, "threshold load count")
    expect(loadedThresholds[0].domain == "quoted \"domain\" \\ source", "threshold load escaped domain")
    expect(closeEnough(loadedThresholds[0].threshold, 0.4), "threshold load score")

    let dataPath = "/tmp/seen_trainer_test/train.jsonl"
    let cfgPath = "/tmp/seen_trainer_test/config.json"
    cleanPipelineOutputs()
    writeAtomicText(dataPath,
        "{\"query_text\":\"alpha question\",\"positive_chunk_text\":\"alpha answer\",\"domain\":\"a\",\"source\":\"one\"}\n"
        + "{\"query_text\":\"beta question\",\"positive_chunk_text\":\"beta answer\",\"domain\":\"b\",\"source\":\"two\"}\n"
        + "{\"query_text\":\"gamma question\",\"positive_chunk_text\":\"gamma answer\",\"domain\":\"c\",\"source\":\"three\"}\n")
    writeAtomicText(cfgPath,
        "{\"train_jsonl_path\":\"" + dataPath + "\","
        + "\"mined_jsonl_path\":\"/tmp/seen_trainer_test/out/mined.jsonl\","
        + "\"output_model_dir\":\"/tmp/seen_trainer_test/out/model\","
        + "\"thresholds_path\":\"/tmp/seen_trainer_test/out/model/thresholds.json\","
        + "\"eval_results_path\":\"/tmp/seen_trainer_test/out/model/eval_results.json\","
        + "\"backend\":\"cpu\","
        + "\"embedding_dim\":16,"
        + "\"max_sequence_length\":16,"
        + "\"quality_margin\":-2.0,"
        + "\"copy_base_artifacts\":false,"
        + "\"epochs\":1"
        + "}")

    let cfg = readConfig(cfgPath)
    expect(cfg.trainJsonlPath == dataPath, "pipeline config train path")
    let pipeline = Pipeline.new(cfg)
    let code = pipeline.runAll()
    expect(code == 0, "runAll should succeed")
    expect(exists("/tmp/seen_trainer_test/out/mined.jsonl"), "mined output")
    expect(exists("/tmp/seen_trainer_test/out/model/thresholds.json"), "thresholds output")
    expect(exists("/tmp/seen_trainer_test/out/model/eval_results.json"), "eval output")
    expect(exists("/tmp/seen_trainer_test/out/model/modules.json"), "package modules")
    println("PASS test_pipeline")
    return 0
}
