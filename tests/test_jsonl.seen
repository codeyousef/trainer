import trainer.io_utils.{writeAtomicText}
import trainer.jsonl.{parseTripletLine, readTripletsLimited, tripletToJson}
import trainer.config.{readConfig}
import trainer.source_adapters.{readSourcePairs}
import trainer.tokenizer.{Tokenizer}

fun expect(condition: Bool, message: String) r: Void {
    if not condition {
        abort(message)
    }
}

fun main() -> Int {
    let line = "{\"query_text\":\"q\",\"positive_chunk_text\":\"p\",\"hard_negative_chunk_text\":\"n\",\"domain\":\"d\",\"source\":\"s\"}"
    let item = parseTripletLine(line)
    expect(item.queryText == "q", "query parse")
    expect(item.positiveChunkText == "p", "positive parse")
    expect(item.hardNegativeChunkText == "n", "negative parse")
    expect(tripletToJson(item) == line, "triplet json round trip")
    let cappedTripletsPath = "/tmp/seen_trainer_capped_triplets.jsonl"
    writeAtomicText(cappedTripletsPath,
        line + "\n"
        + "{\"query_text\":\"q2\",\"positive_chunk_text\":\"p2\",\"hard_negative_chunk_text\":\"n2\",\"domain\":\"d2\",\"source\":\"s2\"}\n")
    let cappedTriplets = readTripletsLimited(cappedTripletsPath, 1)
    expect(cappedTriplets.length() == 1, "limited triplet reader cap")
    expect(cappedTriplets[0].source == "s", "limited triplet reader keeps first row")

    let tokDir = "/tmp/seen_trainer_tokenizer"
    writeAtomicText(tokDir + "/tokenizer.json",
        "{\"model\":{\"vocab\":{\"[PAD]\":0,\"[UNK]\":1,\"[CLS]\":2,\"[SEP]\":3,\"[MASK]\":4,\"hello\":5,\"world\":6,\"play\":7,\"##ing\":8}}}")
    writeAtomicText(tokDir + "/tokenizer_config.json",
        "{\"do_lower_case\":true,\"cls_token\":\"[CLS]\",\"sep_token\":\"[SEP]\",\"pad_token\":\"[PAD]\",\"unk_token\":\"[UNK]\",\"mask_token\":\"[MASK]\"}")
    let tokenizer = Tokenizer.load(tokDir + "/tokenizer.json", 5)
    expect(tokenizer.loaded, "tokenizer loaded")
    expect(tokenizer.vocabSignal == 9, "tokenizer vocab parsed")
    let ids = tokenizer.tokenIds("Hello missing world")
    expect(ids[0] == 2, "cls id")
    expect(ids[1] == 5, "known lowercased token id")
    expect(ids[2] == 1, "unknown token id")
    expect(ids[3] == 6, "known token id")
    expect(ids[4] == 3, "sep id")
    let mask = tokenizer.attentionMask("Hello")
    expect(mask[0] == 1 and mask[1] == 1 and mask[2] == 1, "attention mask content")
    expect(mask[3] == 0 and mask[4] == 0, "attention mask padding")
    let pieceIds = tokenizer.tokenIds("playing")
    expect(pieceIds[1] == 7 and pieceIds[2] == 8, "wordpiece ids")
    expect(pieceIds[3] == 3 and pieceIds[4] == 0, "wordpiece sep and pad")
    let batchTexts = Array<String>()
    batchTexts.push("Hello")
    batchTexts.push("world")
    let batch = tokenizer.batchTokenize(batchTexts)
    expect(batch.rows == 2 and batch.cols == 5, "batch tokenization shape")
    expect(batch.ids.length() == 10 and batch.masks.length() == 10, "batch tokenization flat buffers")

    let vocabDir = "/tmp/seen_trainer_tokenizer_vocab_txt"
    writeAtomicText(vocabDir + "/vocab.txt",
        "[PAD]\n[UNK]\n[CLS]\n[SEP]\n[MASK]\nhello\nworld\n")
    writeAtomicText(vocabDir + "/tokenizer_config.json",
        "{\"do_lower_case\":true,\"cls_token\":\"[CLS]\",\"sep_token\":\"[SEP]\",\"pad_token\":\"[PAD]\",\"unk_token\":\"[UNK]\",\"mask_token\":\"[MASK]\"}")
    let vocabTokenizer = Tokenizer.load(vocabDir + "/tokenizer.json", 5)
    expect(vocabTokenizer.loaded, "vocab txt tokenizer loaded")
    expect(vocabTokenizer.vocabSignal == 7, "vocab txt tokenizer count")
    let vocabIds = vocabTokenizer.tokenIds("hello world")
    expect(vocabIds[0] == 2 and vocabIds[1] == 5 and vocabIds[2] == 6, "vocab txt tokenizer ids")

    let sourceDir = "/tmp/seen_trainer_source_adapter"
    writeAtomicText(sourceDir + "/pairs.csv",
        "Instruction,RESPONSE,DOMAIN,SOURCE\n"
        + "\"How to reset?\",\"Use the reset policy\",support,kb\n"
        + "x,y,tiny,tiny\n")
    writeAtomicText(sourceDir + "/config.json",
        "{\"source_data_path\":\"" + sourceDir + "/pairs.csv\","
        + "\"source_format\":\"csv\","
        + "\"source_query_column\":\"instruction\","
        + "\"source_positive_column\":\"response\","
        + "\"min_text_length\":3,"
        + "\"max_source_pairs\":1,"
        + "\"max_mined_triplets\":2,"
        + "\"max_train_triplets\":3,"
        + "\"max_calibration_triplets\":4,"
        + "\"max_eval_triplets\":5,"
        + "\"parameter_registry_load_cap_elements\":7,"
        + "\"train_all_minilm_layers\":false,"
        + "\"train_minilm_deltas\":false,"
        + "\"max_minilm_layers\":1,"
        + "\"cache_minilm_tensors\":true,"
        + "\"resume_output_artifacts\":true,"
        + "\"learning_rate\":2e-5}")
    let cfg = readConfig(sourceDir + "/config.json")
    expect(cfg.learningRate > 0.000019 and cfg.learningRate < 0.000021, "scientific config float")
    expect(cfg.maxSourcePairs == 1, "max source pairs config")
    expect(cfg.maxMinedTriplets == 2, "max mined triplets config")
    expect(cfg.maxTrainTriplets == 3, "max train triplets config")
    expect(cfg.maxCalibrationTriplets == 4, "max calibration triplets config")
    expect(cfg.maxEvalTriplets == 5, "max eval triplets config")
    expect(cfg.parameterRegistryLoadCapElements == 7, "registry cap config")
    expect(not cfg.trainAllMiniLMLayers, "train all layers config")
    expect(not cfg.trainMiniLMDeltas, "train minilm deltas config")
    expect(cfg.maxMiniLMLayers == 1, "max minilm layers config")
    expect(cfg.cacheMiniLMTensors, "cache minilm tensors config")
    expect(cfg.resumeOutputArtifacts, "resume output artifacts config")
    let pairs = readSourcePairs(cfg)
    expect(pairs.length() == 1, "csv source adapter filter")
    expect(pairs[0].queryText == "How to reset?", "csv query column")
    expect(pairs[0].positiveChunkText == "Use the reset policy", "csv positive column")
    expect(pairs[0].domain == "support" and pairs[0].source == "kb", "csv metadata columns")

    writeAtomicText(sourceDir + "/pairs.JSONL",
        "{\"query_text\":\"tiny\",\"positive_chunk_text\":\"valid enough\",\"domain\":\"json\",\"source\":\"one\"}\n"
        + "{\"query_text\":\"long enough\",\"positive_chunk_text\":\"also valid\",\"domain\":\"json\",\"source\":\"two\"}\n"
        + "{\"query_text\":\"another long\",\"positive_chunk_text\":\"third valid\",\"domain\":\"json\",\"source\":\"three\"}\n")
    writeAtomicText(sourceDir + "/json_config.json",
        "{\"source_data_path\":\"" + sourceDir + "/pairs.JSONL\","
        + "\"source_format\":\"JSONL\","
        + "\"min_text_length\":8,"
        + "\"max_source_pairs\":1}")
    let jsonCfg = readConfig(sourceDir + "/json_config.json")
    let jsonPairs = readSourcePairs(jsonCfg)
    expect(jsonPairs.length() == 1, "jsonl source adapter min length")
    expect(jsonPairs[0].source == "two", "jsonl source adapter keeps valid row")
    println("PASS test_jsonl")
    return 0
}
