import io.file.{exists, readBytes, readText}
import memory.allocation.{releaseIntArrayStorage, releaseStringArrayStorage}
import str.string.{splitWhitespace}

class TokenBatch {
    var rows: Int
    var cols: Int
    var ids: Array<Int>
    var masks: Array<Int>

    static fun new(rows: Int, cols: Int, ids: Array<Int>, masks: Array<Int>) r: TokenBatch {
        return TokenBatch{ rows: rows, cols: cols, ids: ids, masks: masks }
    }
}

class TokenizedText {
    var ids: Array<Int>
    var masks: Array<Int>

    static fun new(ids: Array<Int>, masks: Array<Int>) r: TokenizedText {
        return TokenizedText{ ids: ids, masks: masks }
    }
}

class Tokenizer {
    var tokenizerPath: String
    var loaded: Bool
    var maxLength: Int
    var clsToken: String
    var sepToken: String
    var padToken: String
    var unkToken: String
    var maskToken: String
    var doLowerCase: Bool
    var tokenizerConfigLoaded: Bool
    var specialTokensLoaded: Bool
    var vocabSignal: Int
    var vocabStyle: Int
    var vocabTokens: Array<String>
    var vocabIds: Array<Int>
    var vocabBuckets: Array<Int>
    var vocabNext: Array<Int>
    var clsId: Int
    var sepId: Int
    var padId: Int
    var unkId: Int
    var maskId: Int

    static fun load(path: String, maxLength: Int) r: Tokenizer {
        var loaded = false
        var tokenizerBytes = Array<Int>()
        let baseDir = parentDir(path)
        let vocabPath = baseDir + "/vocab.txt"
        let hasVocabTxt = exists(vocabPath)
        if hasVocabTxt {
            loaded = true
        } else if exists(path) {
            println("trainer: reading tokenizer.json")
            tokenizerBytes = readBytes(path)
            loaded = tokenizerBytes.length() > 0
        }
        println("trainer: reading tokenizer metadata")
        let tokenizerConfig = readText(baseDir + "/tokenizer_config.json")
        let specialTokens = readText(baseDir + "/special_tokens_map.json")
        let defaultCls = if loaded { "[CLS]" } else { "<s>" }
        let defaultSep = if loaded { "[SEP]" } else { "</s>" }
        let defaultPad = if loaded { "[PAD]" } else { "<pad>" }
        let defaultUnk = if loaded { "[UNK]" } else { "<unk>" }
        let defaultMask = if loaded { "[MASK]" } else { "<mask>" }
        var cls = findJsonString(tokenizerConfig, "cls_token", defaultCls)
        cls = findJsonString(specialTokens, "cls_token", cls)
        var sep = findJsonString(tokenizerConfig, "sep_token", defaultSep)
        sep = findJsonString(specialTokens, "sep_token", sep)
        var pad = findJsonString(tokenizerConfig, "pad_token", defaultPad)
        pad = findJsonString(specialTokens, "pad_token", pad)
        var unk = findJsonString(tokenizerConfig, "unk_token", defaultUnk)
        unk = findJsonString(specialTokens, "unk_token", unk)
        var mask = findJsonString(tokenizerConfig, "mask_token", defaultMask)
        mask = findJsonString(specialTokens, "mask_token", mask)
        let lower = findJsonBool(tokenizerConfig, "do_lower_case", true)
        let vocabTokens = Array<String>()
        let vocabIds = Array<Int>()
        if hasVocabTxt {
            println("trainer: reading vocab.txt")
            parseTokenizerVocabTxt(readText(vocabPath), vocabTokens, vocabIds)
        } else {
            println("trainer: parsing tokenizer vocab")
            parseTokenizerVocabBytes(tokenizerBytes, vocabTokens, vocabIds)
        }
        let vocabBuckets = buildVocabBuckets(vocabTokens)
        let vocabNext = buildVocabNext(vocabTokens, vocabBuckets)
        let vocabStyle = if tokenizerVocabIsArrayBytes(tokenizerBytes) { 2 } else { detectTokenizerVocabStyle("", vocabTokens) }
        let clsId = findVocabId(vocabTokens, vocabIds, cls, stableTokenId(cls))
        let sepId = findVocabId(vocabTokens, vocabIds, sep, stableTokenId(sep))
        let padId = findVocabId(vocabTokens, vocabIds, pad, stableTokenId(pad))
        let unkId = findVocabId(vocabTokens, vocabIds, unk, stableTokenId(unk))
        let maskId = findVocabId(vocabTokens, vocabIds, mask, stableTokenId(mask))
        println("trainer: tokenizer ready vocab=" + vocabTokens.length().toString() + " style=" + vocabStyle.toString())
        return Tokenizer{
            tokenizerPath: path,
            loaded: loaded,
            maxLength: maxLength,
            clsToken: cls,
            sepToken: sep,
            padToken: pad,
            unkToken: unk,
            maskToken: mask,
            doLowerCase: lower,
            tokenizerConfigLoaded: tokenizerConfig.length() > 0,
            specialTokensLoaded: specialTokens.length() > 0,
            vocabSignal: vocabTokens.length(),
            vocabStyle: vocabStyle,
            vocabTokens: vocabTokens,
            vocabIds: vocabIds,
            vocabBuckets: vocabBuckets,
            vocabNext: vocabNext,
            clsId: clsId,
            sepId: sepId,
            padId: padId,
            unkId: unkId,
            maskId: maskId
        }
    }

    fun tokenize(text: String) r: Array<String> {
        let normalized = if this.doLowerCase { asciiLower(text) } else { text }
        let raw = splitWhitespace(normalized, true)
        let tokens = Array<String>()
        tokens.push(this.clsToken)
        var i = 0
        while i < raw.length() and tokens.length() < this.maxLength - 1 {
            appendTokenizerPieces(tokens, raw[i], this.vocabTokens, this.vocabBuckets, this.vocabNext, this.unkToken, this.maxLength - 1, this.vocabStyle)
            i = i + 1
        }
        tokens.push(this.sepToken)
        while tokens.length() < this.maxLength {
            tokens.push(this.padToken)
        }
        releaseStringArrayStorage(raw)
        return tokens
    }

    fun tokenIds(text: String) r: Array<Int> {
        return this.tokenized(text).ids
    }

    fun tokenIdForToken(token: String) r: Int {
        if tokenizerStringEquals(token, this.clsToken) {
            return this.clsId
        }
        if tokenizerStringEquals(token, this.sepToken) {
            return this.sepId
        }
        if tokenizerStringEquals(token, this.padToken) {
            return this.padId
        }
        if tokenizerStringEquals(token, this.unkToken) {
            return this.unkId
        }
        if tokenizerStringEquals(token, this.maskToken) {
            return this.maskId
        }
        let fallback = if this.vocabTokens.length() > 0 { this.unkId } else { stableTokenId(token) }
        return findVocabIdIndexed(this.vocabTokens, this.vocabIds, this.vocabBuckets, this.vocabNext, token, fallback)
    }

    fun attentionMask(text: String) r: Array<Int> {
        return this.tokenized(text).masks
    }

    fun tokenized(text: String) r: TokenizedText {
        let normalized = if this.doLowerCase { asciiLower(text) } else { text }
        let raw = splitWhitespace(normalized, true)
        let ids = Array<Int>()
        let mask = Array<Int>()
        ids.push(this.clsId)
        mask.push(1)
        var i = 0
        let limit = this.maxLength - 1
        while i < raw.length() and ids.length() < limit {
            appendTokenizerPieceIds(ids, mask, raw[i], this.vocabTokens, this.vocabIds, this.vocabBuckets, this.vocabNext, this.unkId, limit, this.vocabStyle)
            i = i + 1
        }
        ids.push(this.sepId)
        mask.push(1)
        while ids.length() < this.maxLength {
            ids.push(this.padId)
            mask.push(0)
        }
        releaseStringArrayStorage(raw)
        return TokenizedText.new(ids, mask)
    }

    fun batchTokenize(texts: Array<String>) r: TokenBatch {
        let ids = Array<Int>()
        let masks = Array<Int>()
        var i = 0
        while i < texts.length() {
            let row = this.tokenized(texts[i])
            var j = 0
            while j < row.ids.length() {
                ids.push(row.ids[j])
                j = j + 1
            }
            j = 0
            while j < row.masks.length() {
                masks.push(row.masks[j])
                j = j + 1
            }
            releaseIntArrayStorage(row.ids)
            releaseIntArrayStorage(row.masks)
            i = i + 1
        }
        return TokenBatch.new(texts.length(), this.maxLength, ids, masks)
    }
}

fun stableTokenId(token: String) r: Int {
    var h = 2166136261
    var i = 0
    while i < token.length() {
        h = h ^ token.byteAt(i)
        h = h * 16777619
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    return h % 250037
}

fun tokenizerStringEquals(a: String, b: String) r: Bool {
    if a.length() != b.length() {
        return false
    }
    var i = 0
    while i < a.length() {
        if a.charAt(i) != b.charAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun asciiLower(text: String) r: String {
    return text.toLowerCase()
}

fun parentDir(path: String) r: String {
    var lastSlash = -1
    var i = 0
    while i < path.length() {
        if path.substring(i, i + 1) == "/" {
            lastSlash = i
        }
        i = i + 1
    }
    if lastSlash < 0 {
        return "."
    }
    return path.substring(0, lastSlash)
}

fun findJsonString(text: String, key: String, fallback: String) r: String {
    let pos = tokenizerFindKeyColon(text, key)
    if pos < 0 {
        return fallback
    }
    var i = tokenizerSkipWs(text, pos)
    if i >= text.length() or text.charAt(i) != 34 {
        return fallback
    }
    i = i + 1
    var out = ""
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 34 {
            return out
        }
        if ch == 92 {
            i = i + 1
            if i < text.length() {
                out = out + String.fromCharCode(text.charAt(i))
            }
        } else {
            out = out + String.fromCharCode(ch)
        }
        i = i + 1
    }
    return fallback
}

fun findJsonBool(text: String, key: String, fallback: Bool) r: Bool {
    let pos = tokenizerFindKeyColon(text, key)
    if pos < 0 {
        return fallback
    }
    let i = tokenizerSkipWs(text, pos)
    if i + 4 <= text.length() and tokenizerMatchesAt(text, i, "true") {
        return true
    }
    if i + 5 <= text.length() and tokenizerMatchesAt(text, i, "false") {
        return false
    }
    return fallback
}

fun tokenizerFindKeyColon(text: String, key: String) r: Int {
    let needle = "\"" + key + "\""
    var i = 0
    while i <= text.length() - needle.length() {
        if tokenizerMatchesAt(text, i, needle) {
            i = i + needle.length()
            while i < text.length() and text.charAt(i) != 58 {
                i = i + 1
            }
            if i < text.length() {
                return i + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

fun tokenizerMatchesAt(text: String, offset: Int, needle: String) r: Bool {
    if offset < 0 or offset + needle.length() > text.length() {
        return false
    }
    var i = 0
    while i < needle.length() {
        if text.charAt(offset + i) != needle.charAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun tokenizerSkipWs(text: String, pos: Int) r: Int {
    var i = pos
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fun tokenizerFindKeyColonBytes(bytes: Array<Int>, key: String) r: Int {
    var i = 0
    while i < bytes.length() {
        if bytes[i] == 34 and tokenizerBytesMatchString(bytes, i + 1, key) {
            var j = i + key.length() + 2
            while j < bytes.length() and bytes[j] != 58 {
                j = j + 1
            }
            if j < bytes.length() {
                return j + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

fun tokenizerVocabIsArrayBytes(bytes: Array<Int>) r: Bool {
    let pos = tokenizerFindKeyColonBytes(bytes, "vocab")
    if pos < 0 {
        return false
    }
    let i = tokenizerSkipWsBytes(bytes, pos)
    return i < bytes.length() and bytes[i] == 91
}

fun tokenizerBytesMatchString(bytes: Array<Int>, offset: Int, text: String) r: Bool {
    if offset < 0 or offset + text.length() > bytes.length() {
        return false
    }
    var i = 0
    while i < text.length() {
        if bytes[offset + i] != text.byteAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun tokenizerSkipWsBytes(bytes: Array<Int>, pos: Int) r: Int {
    var i = pos
    while i < bytes.length() {
        let ch = bytes[i]
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fun countNeedles(text: String, needle: String) r: Int {
    if needle.length() == 0 {
        return 0
    }
    var count = 0
    var i = 0
    while i <= text.length() - needle.length() {
        if tokenizerMatchesAt(text, i, needle) {
            count = count + 1
            i = i + needle.length()
        } else {
            i = i + 1
        }
    }
    return count
}

fun parseTokenizerVocab(text: String, tokens: Array<String>, ids: Array<Int>) r: Int {
    let pos = tokenizerFindKeyColon(text, "vocab")
    if pos < 0 {
        return 0
    }
    var i = tokenizerSkipWs(text, pos)
    if i >= text.length() {
        return 0
    }
    if text.charAt(i) == 123 {
        return parseTokenizerVocabObject(text, i, tokens, ids)
    }
    if text.charAt(i) == 91 {
        return parseTokenizerUnigramVocabArray(text, i, tokens, ids)
    }
    return 0
}

fun parseTokenizerVocabBytes(bytes: Array<Int>, tokens: Array<String>, ids: Array<Int>) r: Int {
    let pos = tokenizerFindKeyColonBytes(bytes, "vocab")
    if pos < 0 {
        return 0
    }
    var i = tokenizerSkipWsBytes(bytes, pos)
    if i >= bytes.length() {
        return 0
    }
    if bytes[i] == 123 {
        return parseTokenizerVocabObjectBytes(bytes, i, tokens, ids)
    }
    if bytes[i] == 91 {
        return parseTokenizerUnigramVocabArrayBytes(bytes, i, tokens, ids)
    }
    return 0
}

fun parseTokenizerVocabObjectBytes(bytes: Array<Int>, start: Int, tokens: Array<String>, ids: Array<Int>) r: Int {
    var i = start
    if i >= bytes.length() or bytes[i] != 123 {
        return 0
    }
    i = i + 1
    var count = 0
    while i < bytes.length() {
        i = tokenizerSkipWsBytes(bytes, i)
        if i >= bytes.length() or bytes[i] == 125 {
            return count
        }
        if bytes[i] != 34 {
            i = tokenizerSkipJsonValueBytes(bytes, i)
        } else {
            let token = tokenizerReadQuotedBytes(bytes, i)
            i = tokenizerAfterQuotedBytes(bytes, i)
            i = tokenizerSkipWsBytes(bytes, i)
            if i < bytes.length() and bytes[i] == 58 {
                i = tokenizerSkipWsBytes(bytes, i + 1)
                let id = tokenizerParseIntBytes(bytes, i)
                tokens.push(token)
                ids.push(id)
                count = count + 1
                i = tokenizerAfterIntBytes(bytes, i)
            }
        }
        i = tokenizerSkipWsBytes(bytes, i)
        if i < bytes.length() and bytes[i] == 44 {
            i = i + 1
        }
    }
    return count
}

fun parseTokenizerUnigramVocabArrayBytes(bytes: Array<Int>, start: Int, tokens: Array<String>, ids: Array<Int>) r: Int {
    var i = start
    if i >= bytes.length() or bytes[i] != 91 {
        return 0
    }
    i = i + 1
    var id = 0
    var count = 0
    while i < bytes.length() {
        i = tokenizerSkipWsBytes(bytes, i)
        if i >= bytes.length() or bytes[i] == 93 {
            return count
        }
        if bytes[i] == 91 {
            var j = tokenizerSkipWsBytes(bytes, i + 1)
            if j < bytes.length() and bytes[j] == 34 {
                let token = tokenizerReadQuotedBytes(bytes, j)
                tokens.push(token)
                ids.push(id)
                count = count + 1
            }
            i = tokenizerSkipJsonValueBytes(bytes, i)
            id = id + 1
        } else {
            i = tokenizerSkipJsonValueBytes(bytes, i)
        }
        i = tokenizerSkipWsBytes(bytes, i)
        if i < bytes.length() and bytes[i] == 44 {
            i = i + 1
        }
    }
    return count
}

fun parseTokenizerVocabObject(text: String, start: Int, tokens: Array<String>, ids: Array<Int>) r: Int {
    var i = start
    if i >= text.length() or text.charAt(i) != 123 {
        return 0
    }
    i = i + 1
    var count = 0
    while i < text.length() {
        i = tokenizerSkipWs(text, i)
        if i >= text.length() or text.charAt(i) == 125 {
            return count
        }
        if text.charAt(i) != 34 {
            i = tokenizerSkipJsonValue(text, i)
        } else {
            let token = tokenizerReadQuoted(text, i)
            i = tokenizerAfterQuoted(text, i)
            i = tokenizerSkipWs(text, i)
            if i < text.length() and text.charAt(i) == 58 {
                i = tokenizerSkipWs(text, i + 1)
                let id = tokenizerParseInt(text, i)
                tokens.push(token)
                ids.push(id)
                count = count + 1
                i = tokenizerAfterInt(text, i)
            }
        }
        i = tokenizerSkipWs(text, i)
        if i < text.length() and text.charAt(i) == 44 {
            i = i + 1
        }
    }
    return count
}

fun parseTokenizerUnigramVocabArray(text: String, start: Int, tokens: Array<String>, ids: Array<Int>) r: Int {
    var i = start
    if i >= text.length() or text.charAt(i) != 91 {
        return 0
    }
    i = i + 1
    var id = 0
    var count = 0
    while i < text.length() {
        i = tokenizerSkipWs(text, i)
        if i >= text.length() or text.charAt(i) == 93 {
            return count
        }
        if text.charAt(i) == 91 {
            var j = tokenizerSkipWs(text, i + 1)
            if j < text.length() and text.charAt(j) == 34 {
                let token = tokenizerReadQuoted(text, j)
                tokens.push(token)
                ids.push(id)
                count = count + 1
            }
            i = tokenizerSkipJsonValue(text, i)
            id = id + 1
        } else {
            i = tokenizerSkipJsonValue(text, i)
        }
        i = tokenizerSkipWs(text, i)
        if i < text.length() and text.charAt(i) == 44 {
            i = i + 1
        }
    }
    return count
}

fun parseTokenizerVocabTxt(text: String, tokens: Array<String>, ids: Array<Int>) r: Int {
    var start = 0
    var i = 0
    var id = 0
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 10 or ch == 13 {
            if i > start {
                tokens.push(text.substring(start, i))
                ids.push(id)
                id = id + 1
            }
            i = i + 1
            if ch == 13 and i < text.length() and text.charAt(i) == 10 {
                i = i + 1
            }
            start = i
        } else {
            i = i + 1
        }
    }
    if start < text.length() {
        tokens.push(text.substring(start, text.length()))
        ids.push(id)
        id = id + 1
    }
    return id
}

fun findVocabId(tokens: Array<String>, ids: Array<Int>, token: String, fallback: Int) r: Int {
    var i = 0
    while i < tokens.length() and i < ids.length() {
        if tokenizerStringEquals(tokens[i], token) {
            return ids[i]
        }
        i = i + 1
    }
    return fallback
}

fun findVocabIdIndexed(tokens: Array<String>, ids: Array<Int>, buckets: Array<Int>, next: Array<Int>, token: String, fallback: Int) r: Int {
    let index = findVocabIndexIndexed(tokens, buckets, next, token)
    if index >= 0 and index < ids.length() {
        return ids[index]
    }
    return fallback
}

fun findVocabIndexIndexed(tokens: Array<String>, buckets: Array<Int>, next: Array<Int>, token: String) r: Int {
    if buckets.length() == 0 {
        return findVocabIndexLinear(tokens, token)
    }
    let bucket = tokenizerBucketFor(token, buckets.length())
    var i = buckets[bucket]
    while i >= 0 and i < tokens.length() {
        if tokenizerStringEquals(tokens[i], token) {
            return i
        }
        if i < next.length() {
            i = next[i]
        } else {
            return -1
        }
    }
    return -1
}

fun findVocabIndexLinear(tokens: Array<String>, token: String) r: Int {
    var i = 0
    while i < tokens.length() {
        if tokenizerStringEquals(tokens[i], token) {
            return i
        }
        i = i + 1
    }
    return -1
}

fun buildVocabBuckets(tokens: Array<String>) r: Array<Int> {
    let buckets = Array<Int>()
    let bucketCount = tokenizerBucketCount(tokens.length())
    var i = 0
    while i < bucketCount {
        buckets.push(-1)
        i = i + 1
    }
    return buckets
}

fun buildVocabNext(tokens: Array<String>, buckets: Array<Int>) r: Array<Int> {
    let next = Array<Int>()
    var i = 0
    while i < tokens.length() {
        next.push(-1)
        i = i + 1
    }
    i = 0
    while i < tokens.length() and buckets.length() > 0 {
        let bucket = tokenizerBucketFor(tokens[i], buckets.length())
        next[i] = buckets[bucket]
        buckets[bucket] = i
        i = i + 1
    }
    return next
}

fun tokenizerBucketCount(tokenCount: Int) r: Int {
    if tokenCount <= 0 {
        return 0
    }
    if tokenCount < 2048 {
        return 4096
    }
    if tokenCount < 32768 {
        return 65536
    }
    return 262144
}

fun tokenizerBucketFor(token: String, bucketCount: Int) r: Int {
    if bucketCount <= 0 {
        return 0
    }
    var h = 2166136261
    var i = 0
    while i < token.length() {
        h = h ^ token.byteAt(i)
        h = h * 16777619
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    return h % bucketCount
}

fun vocabContains(tokens: Array<String>, token: String) r: Bool {
    var i = 0
    while i < tokens.length() {
        if tokenizerStringEquals(tokens[i], token) {
            return true
        }
        i = i + 1
    }
    return false
}

fun vocabContainsIndexed(tokens: Array<String>, buckets: Array<Int>, next: Array<Int>, token: String) r: Bool {
    return findVocabIndexIndexed(tokens, buckets, next, token) >= 0
}

fun detectTokenizerVocabStyle(text: String, tokens: Array<String>) r: Int {
    if tokenizerJsonStringEquals(text, "type", "Unigram") {
        return 2
    }
    if tokenizerUsesMetaspace(tokens) {
        return 2
    }
    return 1
}

fun tokenizerJsonStringEquals(text: String, key: String, expected: String) r: Bool {
    let value = findJsonString(text, key, "")
    if value.length() == 0 {
        return false
    }
    return tokenizerStringEquals(value, expected)
}

fun tokenizerUsesMetaspace(tokens: Array<String>) r: Bool {
    var i = 0
    while i < tokens.length() and i < 512 {
        if tokenLooksMetaspacePrefixed(tokens[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

fun tokenLooksMetaspacePrefixed(token: String) r: Bool {
    if token.length() == 0 {
        return false
    }
    if token.charAt(0) == 9601 {
        return true
    }
    if token.length() >= 3 and token.charAt(0) == 226 and token.charAt(1) == 150 and token.charAt(2) == 129 {
        return true
    }
    if token.length() >= 3 and token.byteAt(0) == 226 and token.byteAt(1) == 150 and token.byteAt(2) == 129 {
        return true
    }
    return false
}

fun startsWithTokenizerString(text: String, prefix: String) r: Bool {
    if prefix.length() == 0 {
        return true
    }
    if text.length() < prefix.length() {
        return false
    }
    return tokenizerStringEquals(text.substring(0, prefix.length()), prefix)
}

fun appendTokenizerPieces(out: Array<String>, word: String, vocabTokens: Array<String>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkToken: String, limit: Int, style: Int) r: Void {
    if style == 2 {
        appendMetaspacePieces(out, word, vocabTokens, vocabBuckets, vocabNext, unkToken, limit)
        return
    }
    appendWordPieces(out, word, vocabTokens, vocabBuckets, vocabNext, unkToken, limit)
}

fun appendTokenizerPieceIds(out: Array<Int>, mask: Array<Int>, word: String, vocabTokens: Array<String>, vocabIds: Array<Int>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkId: Int, limit: Int, style: Int) r: Void {
    if style == 2 {
        appendMetaspacePieceIds(out, mask, word, vocabTokens, vocabIds, vocabBuckets, vocabNext, unkId, limit)
        return
    }
    appendWordPieceIds(out, mask, word, vocabTokens, vocabIds, vocabBuckets, vocabNext, unkId, limit)
}

fun appendWordPieceIds(out: Array<Int>, mask: Array<Int>, word: String, vocabTokens: Array<String>, vocabIds: Array<Int>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkId: Int, limit: Int) r: Void {
    if out.length() >= limit {
        return
    }
    if vocabTokens.length() == 0 {
        out.push(stableTokenId(word))
        mask.push(1)
        return
    }
    let wholeId = findVocabIdIndexed(vocabTokens, vocabIds, vocabBuckets, vocabNext, word, -1)
    if wholeId >= 0 {
        out.push(wholeId)
        mask.push(1)
        return
    }
    let pieceIds = Array<Int>()
    let remaining = limit - out.length()
    var start = 0
    var failed = false
    while start < word.length() and not failed {
        var end = word.length()
        var matchedId = -1
        var matchedEnd = start
        while end > start and matchedId < 0 {
            let rawPiece = word.substring(start, end)
            let piece = if start == 0 { rawPiece } else { "##" + rawPiece }
            matchedId = findVocabIdIndexed(vocabTokens, vocabIds, vocabBuckets, vocabNext, piece, -1)
            if matchedId >= 0 {
                matchedEnd = end
            } else {
                end = end - 1
            }
        }
        if matchedId < 0 {
            failed = true
        } else {
            if pieceIds.length() < remaining {
                pieceIds.push(matchedId)
            }
            start = matchedEnd
        }
    }
    if failed or pieceIds.length() == 0 {
        out.push(unkId)
        mask.push(1)
        releaseIntArrayStorage(pieceIds)
        return
    }
    var i = 0
    while i < pieceIds.length() and out.length() < limit {
        out.push(pieceIds[i])
        mask.push(1)
        i = i + 1
    }
    releaseIntArrayStorage(pieceIds)
}

fun appendMetaspacePieceIds(out: Array<Int>, mask: Array<Int>, word: String, vocabTokens: Array<String>, vocabIds: Array<Int>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkId: Int, limit: Int) r: Void {
    if out.length() >= limit {
        return
    }
    if vocabTokens.length() == 0 {
        out.push(stableTokenId(word))
        mask.push(1)
        return
    }
    let pieceIds = Array<Int>()
    let remaining = limit - out.length()
    var start = 0
    var failed = false
    while start < word.length() and not failed {
        var end = word.length()
        var matchedId = -1
        var matchedEnd = start
        while end > start and matchedId < 0 {
            matchedId = findMetaspaceVocabPieceId(vocabTokens, vocabIds, vocabBuckets, vocabNext, word, start, end, start == 0)
            if matchedId >= 0 {
                matchedEnd = end
            } else {
                end = end - 1
            }
        }
        if matchedId < 0 {
            failed = true
        } else {
            if pieceIds.length() < remaining {
                pieceIds.push(matchedId)
            }
            start = matchedEnd
        }
    }
    if failed or pieceIds.length() == 0 {
        out.push(unkId)
        mask.push(1)
        releaseIntArrayStorage(pieceIds)
        return
    }
    var i = 0
    while i < pieceIds.length() and out.length() < limit {
        out.push(pieceIds[i])
        mask.push(1)
        i = i + 1
    }
    releaseIntArrayStorage(pieceIds)
}

fun appendWordPieces(out: Array<String>, word: String, vocabTokens: Array<String>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkToken: String, limit: Int) r: Void {
    if out.length() >= limit {
        return
    }
    if vocabTokens.length() == 0 {
        out.push(word)
        return
    }
    if vocabContainsIndexed(vocabTokens, vocabBuckets, vocabNext, word) {
        out.push(word)
        return
    }
    let pieces = Array<String>()
    var start = 0
    var failed = false
    while start < word.length() and not failed {
        var end = word.length()
        var matched = ""
        while end > start and matched.length() == 0 {
            let rawPiece = word.substring(start, end)
            let piece = if start == 0 { rawPiece } else { "##" + rawPiece }
            if vocabContainsIndexed(vocabTokens, vocabBuckets, vocabNext, piece) {
                matched = piece
            } else {
                end = end - 1
            }
        }
        if matched.length() == 0 {
            failed = true
        } else {
            pieces.push(matched)
            start = end
        }
    }
    if failed or pieces.length() == 0 {
        out.push(unkToken)
        return
    }
    var i = 0
    while i < pieces.length() and out.length() < limit {
        out.push(pieces[i])
        i = i + 1
    }
}

fun appendMetaspacePieces(out: Array<String>, word: String, vocabTokens: Array<String>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkToken: String, limit: Int) r: Void {
    if out.length() >= limit {
        return
    }
    if vocabTokens.length() == 0 {
        out.push(word)
        return
    }
    appendGreedyMetaspacePieces(out, word, vocabTokens, vocabBuckets, vocabNext, unkToken, limit)
}

fun appendGreedyMetaspacePieces(out: Array<String>, word: String, vocabTokens: Array<String>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, unkToken: String, limit: Int) r: Void {
    var start = 0
    var failed = false
    let pieces = Array<String>()
    while start < word.length() and not failed {
        var end = word.length()
        var matched = ""
        while end > start and matched.length() == 0 {
            matched = findMetaspaceVocabPiece(vocabTokens, vocabBuckets, vocabNext, word, start, end, start == 0)
            if matched.length() == 0 {
                end = end - 1
            }
        }
        if matched.length() == 0 {
            failed = true
        } else {
            pieces.push(matched)
            start = end
        }
    }
    if failed or pieces.length() == 0 {
        out.push(unkToken)
        return
    }
    var i = 0
    while i < pieces.length() and out.length() < limit {
        out.push(pieces[i])
        i = i + 1
    }
}

fun findMetaspaceVocabPiece(vocabTokens: Array<String>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, word: String, start: Int, end: Int, firstPiece: Bool) r: String {
    let rawPiece = word.substring(start, end)
    if firstPiece {
        let unicodePiece = String.fromCharCode(9601) + rawPiece
        if vocabContainsIndexed(vocabTokens, vocabBuckets, vocabNext, unicodePiece) {
            return unicodePiece
        }
        let bytePiece = String.fromCharCode(226) + String.fromCharCode(150) + String.fromCharCode(129) + rawPiece
        if vocabContainsIndexed(vocabTokens, vocabBuckets, vocabNext, bytePiece) {
            return bytePiece
        }
        return ""
    }
    if vocabContainsIndexed(vocabTokens, vocabBuckets, vocabNext, rawPiece) {
        return rawPiece
    }
    return ""
}

fun findMetaspaceVocabPieceId(vocabTokens: Array<String>, vocabIds: Array<Int>, vocabBuckets: Array<Int>, vocabNext: Array<Int>, word: String, start: Int, end: Int, firstPiece: Bool) r: Int {
    let rawPiece = word.substring(start, end)
    if firstPiece {
        let unicodePiece = String.fromCharCode(9601) + rawPiece
        let unicodeId = findVocabIdIndexed(vocabTokens, vocabIds, vocabBuckets, vocabNext, unicodePiece, -1)
        if unicodeId >= 0 {
            return unicodeId
        }
        let bytePiece = String.fromCharCode(226) + String.fromCharCode(150) + String.fromCharCode(129) + rawPiece
        return findVocabIdIndexed(vocabTokens, vocabIds, vocabBuckets, vocabNext, bytePiece, -1)
    }
    return findVocabIdIndexed(vocabTokens, vocabIds, vocabBuckets, vocabNext, rawPiece, -1)
}

fun tokenMatchesMetaspaceSlice(token: String, word: String, start: Int, end: Int) r: Bool {
    let pieceLength = end - start
    if pieceLength <= 0 {
        return false
    }
    let charOffset = metaspaceCharOffset(token)
    if charOffset <= 0 {
        return false
    }
    if token.length() != pieceLength + 1 and token.length() != pieceLength + 3 and token.length() != pieceLength + 6 {
        return false
    }
    var i = 0
    while i < pieceLength {
        if token.charAt(i + charOffset) != word.charAt(start + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun metaspaceCharOffset(token: String) r: Int {
    if token.length() == 0 {
        return 0
    }
    if token.charAt(0) == 9601 {
        return 1
    }
    if token.length() >= 3 and token.charAt(0) == 226 and token.charAt(1) == 150 and token.charAt(2) == 129 {
        return 3
    }
    if token.length() >= 3 and token.byteAt(0) == 226 and token.byteAt(1) == 150 and token.byteAt(2) == 129 {
        return 3
    }
    return 0
}

fun tokenMatchesPlainSlice(token: String, word: String, start: Int, end: Int) r: Bool {
    let pieceLength = end - start
    if pieceLength <= 0 or token.length() != pieceLength {
        return false
    }
    var i = 0
    while i < pieceLength {
        if token.charAt(i) != word.charAt(start + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun appendGreedyPieces(out: Array<String>, word: String, vocabTokens: Array<String>, unkToken: String, limit: Int) r: Void {
    var start = 0
    var failed = false
    let pieces = Array<String>()
    while start < word.length() and not failed {
        var end = word.length()
        var matched = ""
        while end > start and matched.length() == 0 {
            let piece = word.substring(start, end)
            if vocabContains(vocabTokens, piece) {
                matched = piece
            } else {
                end = end - 1
            }
        }
        if matched.length() == 0 {
            failed = true
        } else {
            pieces.push(matched)
            start = end
        }
    }
    if failed or pieces.length() == 0 {
        out.push(unkToken)
        return
    }
    var i = 0
    while i < pieces.length() and out.length() < limit {
        out.push(pieces[i])
        i = i + 1
    }
}

fun tokenizerReadQuoted(text: String, start: Int) r: String {
    var out = ""
    var i = start + 1
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 34 {
            return out
        }
        if ch == 92 {
            i = i + 1
            if i < text.length() {
                let esc = text.charAt(i)
                if esc == 110 { out = out + "\n" }
                else if esc == 114 { out = out + "\r" }
                else if esc == 116 { out = out + "\t" }
                else { out = out + String.fromCharCode(esc) }
            }
        } else {
            out = out + String.fromCharCode(ch)
        }
        i = i + 1
    }
    return out
}

fun tokenizerReadQuotedBytes(bytes: Array<Int>, start: Int) r: String {
    var out = ""
    var i = start + 1
    while i < bytes.length() {
        let ch = bytes[i]
        if ch == 34 {
            return out
        }
        if ch == 92 {
            i = i + 1
            if i < bytes.length() {
                let esc = bytes[i]
                if esc == 110 { out = out + "\n" }
                else if esc == 114 { out = out + "\r" }
                else if esc == 116 { out = out + "\t" }
                else if esc == 117 {
                    if i + 4 < bytes.length() {
                        let cp = tokenizerParseHex4Bytes(bytes, i + 1)
                        out = out + String.fromCharCode(cp)
                        i = i + 4
                    }
                }
                else { out = out + String.fromCharCode(esc) }
            }
        } else {
            out = out + String.fromCharCode(ch)
        }
        i = i + 1
    }
    return out
}

fun tokenizerAfterQuotedBytes(bytes: Array<Int>, start: Int) r: Int {
    var i = start + 1
    while i < bytes.length() {
        let ch = bytes[i]
        if ch == 34 {
            return i + 1
        }
        if ch == 92 {
            i = i + 1
        }
        i = i + 1
    }
    return i
}

fun tokenizerAfterQuoted(text: String, start: Int) r: Int {
    var i = start + 1
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 34 {
            return i + 1
        }
        if ch == 92 {
            i = i + 1
        }
        i = i + 1
    }
    return i
}

fun tokenizerParseIntBytes(bytes: Array<Int>, start: Int) r: Int {
    var sign = 1
    var i = start
    if i < bytes.length() and bytes[i] == 45 {
        sign = -1
        i = i + 1
    }
    var out = 0
    while i < bytes.length() and bytes[i] >= 48 and bytes[i] <= 57 {
        out = out * 10 + (bytes[i] - 48)
        i = i + 1
    }
    return out * sign
}

fun tokenizerAfterIntBytes(bytes: Array<Int>, start: Int) r: Int {
    var i = start
    if i < bytes.length() and bytes[i] == 45 {
        i = i + 1
    }
    while i < bytes.length() and bytes[i] >= 48 and bytes[i] <= 57 {
        i = i + 1
    }
    return i
}

fun tokenizerParseInt(text: String, start: Int) r: Int {
    var sign = 1
    var i = start
    if i < text.length() and text.charAt(i) == 45 {
        sign = -1
        i = i + 1
    }
    var out = 0
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        out = out * 10 + (text.charAt(i) - 48)
        i = i + 1
    }
    return out * sign
}

fun tokenizerAfterInt(text: String, start: Int) r: Int {
    var i = start
    if i < text.length() and text.charAt(i) == 45 {
        i = i + 1
    }
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        i = i + 1
    }
    return i
}

fun tokenizerSkipJsonValueBytes(bytes: Array<Int>, start: Int) r: Int {
    var i = start
    var depth = 0
    var inString = false
    while i < bytes.length() {
        let ch = bytes[i]
        if inString {
            if ch == 92 {
                i = i + 1
            } else if ch == 34 {
                inString = false
            }
        } else {
            if ch == 34 {
                inString = true
            } else if ch == 123 or ch == 91 {
                depth = depth + 1
            } else if ch == 125 or ch == 93 {
                if depth == 0 {
                    return i
                }
                depth = depth - 1
            } else if ch == 44 and depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    return i
}

fun tokenizerParseHex4Bytes(bytes: Array<Int>, start: Int) r: Int {
    var out = 0
    var i = 0
    while i < 4 and start + i < bytes.length() {
        out = out * 16 + tokenizerHexValue(bytes[start + i])
        i = i + 1
    }
    return out
}

fun tokenizerHexValue(ch: Int) r: Int {
    if ch >= 48 and ch <= 57 {
        return ch - 48
    }
    if ch >= 65 and ch <= 70 {
        return ch - 55
    }
    if ch >= 97 and ch <= 102 {
        return ch - 87
    }
    return 0
}

fun tokenizerSkipJsonValue(text: String, start: Int) r: Int {
    var i = start
    var depth = 0
    var inString = false
    while i < text.length() {
        let ch = text.charAt(i)
        if inString {
            if ch == 92 {
                i = i + 1
            } else if ch == 34 {
                inString = false
            }
        } else {
            if ch == 34 {
                inString = true
            } else if ch == 123 or ch == 91 {
                depth = depth + 1
            } else if ch == 125 or ch == 93 {
                if depth == 0 {
                    return i
                }
                depth = depth - 1
            } else if ch == 44 and depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    return i
}
