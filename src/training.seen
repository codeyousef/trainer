import config.{TrainerConfig}
import capabilities.{trainerCapabilityFields, trainerTrainingMode}
import base_update.{directBaseWeightsPath, writeDirectBaseWeightUpdateArtifact}
import embedding_delta.{miniLMEmbeddingDeltasPath}
import encoder.{Encoder}
import io_utils.{writeAtomicText}
import jsonl.{TripletExample, readTriplets}
import math_utils.{cosine, relu, deterministicShuffleIndices}

class TrainResult {
    var examples: Int
    var epochs: Int
    var finalLoss: Float
    var outputPath: String

    static fun new(examples: Int, epochs: Int, finalLoss: Float, outputPath: String) r: TrainResult {
        return TrainResult{ examples: examples, epochs: epochs, finalLoss: finalLoss, outputPath: outputPath }
    }
}

fun trainEncoder(cfg: TrainerConfig, encoder: Encoder) r: TrainResult {
    let trainPath = if cfg.minedJsonlPath.length() > 0 { cfg.minedJsonlPath } else { cfg.trainJsonlPath }
    let items = readTriplets(trainPath)
    let batchSize = effectiveBatchSize(cfg.batchSize, items.length())
    let batches = batchesPerEpoch(items.length(), batchSize)
    let examplesPerEpoch = batches * batchSize
    var finalLoss = 0.0
    var epoch = 0
    while epoch < cfg.epochs {
        let order = deterministicShuffleIndices(items.length(), cfg.seed + epoch)
        var lossSum = 0.0
        var count = 0
        var batch = 0
        while batch < batches {
            var batchLoss = 0.0
            var inBatch = 0
            var offset = 0
            while offset < batchSize {
                let orderIndex = batch * batchSize + offset
                let item = items[order[orderIndex]]
                let loss = trainAdapterTriplet(item, encoder, cfg)
                batchLoss = batchLoss + loss
                inBatch = inBatch + 1
                offset = offset + 1
            }
            if inBatch > 0 {
                lossSum = lossSum + batchLoss / inBatch.toFloat()
                count = count + 1
            }
            batch = batch + 1
        }
        if count > 0 {
            finalLoss = lossSum / count.toFloat()
        }
        println("trainer: epoch " + (epoch + 1).toString() + " loss " + finalLoss.toString())
        epoch = epoch + 1
    }
    if encoder.hasMiniLMDenseAdapterTarget() {
        if encoder.hasMiniLMAllLayerDeltaTarget() {
            encoder.minilmLayerDeltas.saveAll(cfg.outputModelDir)
        }
        if encoder.hasMiniLMEmbeddingDeltaTarget() {
            encoder.minilmEmbeddingDeltas.save(miniLMEmbeddingDeltasPath(cfg.outputModelDir))
        }
        encoder.minilmDenseAdapter.save(cfg.minilmDenseAdapterPath())
        encoder.minilmDenseDelta.save(cfg.minilmDenseDeltaPath())
        encoder.minilmIntermediateDelta.saveIntermediate(cfg.minilmIntermediateDeltaPath())
        encoder.minilmQueryDelta.saveAs(cfg.minilmQueryDeltaPath(), "seen-minilm-attention-query-delta-v1")
        encoder.minilmKeyDelta.saveAs(cfg.minilmKeyDeltaPath(), "seen-minilm-attention-key-delta-v1")
        encoder.minilmValueDelta.saveAs(cfg.minilmValueDeltaPath(), "seen-minilm-attention-value-delta-v1")
        encoder.minilmAttentionDenseDelta.saveAs(cfg.minilmAttentionDenseDeltaPath(), "seen-minilm-attention-output-dense-delta-v1")
        encoder.minilmAttentionLayerNormDelta.saveAttentionOutput(cfg.minilmAttentionLayerNormDeltaPath())
        encoder.minilmLayerNormDelta.save(cfg.minilmLayerNormDeltaPath())
        let baseUpdate = writeDirectBaseWeightUpdateArtifact(cfg, encoder.modelEmbeddings.layers, encoder.embeddingDim, encoder.modelEmbeddings.intermediateSize)
        if baseUpdate.anyMaterialized() {
            println("trainer: flushed " + baseUpdate.totalSurfaces.toString() + " trained surfaces into " + baseUpdate.outputPath)
        }
    }
    encoder.minilmLayerAdapter.save(cfg.minilmLayerAdapterPath())
    encoder.layerAdapter.save(cfg.layerAdapterPath())
    encoder.adapter.save(cfg.adapterPath())
    let path = cfg.outputModelDir + "/training_config.json"
    writeAtomicText(path, trainingConfigJson(cfg, items.length(), finalLoss, batchSize, batches, examplesPerEpoch))
    return TrainResult.new(items.length(), cfg.epochs, finalLoss, path)
}

fun effectiveBatchSize(requested: Int, itemCount: Int) r: Int {
    var batch = requested
    if batch <= 0 {
        batch = 1
    }
    if itemCount > 0 and batch > itemCount {
        return itemCount
    }
    return batch
}

fun batchesPerEpoch(itemCount: Int, batchSize: Int) r: Int {
    if itemCount <= 0 or batchSize <= 0 {
        return 0
    }
    return itemCount / batchSize
}

fun trainAdapterTriplet(item: TripletExample, encoder: Encoder, cfg: TrainerConfig) r: Float {
    if item.hardNegativeChunkText.length() == 0 {
        return 0.0
    }
    var denseLoss = 0.0
    if encoder.hasMiniLMDenseAdapterTarget() {
        denseLoss = encoder.updateMiniLMDenseAdapterTriplet(item.queryText, item.positiveChunkText, item.hardNegativeChunkText, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    }
    var minilmLoss = 0.0
    if encoder.hasMiniLMLayerAdapterTarget() {
        let miniQ = encoder.encodeMiniLMLayerInput(item.queryText)
        let miniP = encoder.encodeMiniLMLayerInput(item.positiveChunkText)
        let miniN = encoder.encodeMiniLMLayerInput(item.hardNegativeChunkText)
        if miniQ.length() == encoder.embeddingDim and miniP.length() == encoder.embeddingDim and miniN.length() == encoder.embeddingDim {
            minilmLoss = encoder.minilmLayerAdapter.updateTriplet(miniQ, miniP, miniN, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
        }
    }
    let rawQ = encoder.encodeLayerInput(item.queryText)
    let rawP = encoder.encodeLayerInput(item.positiveChunkText)
    let rawN = encoder.encodeLayerInput(item.hardNegativeChunkText)
    let layerLoss = encoder.layerAdapter.updateTriplet(rawQ, rawP, rawN, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    let q = encoder.encodeBase(item.queryText)
    let p = encoder.encodeBase(item.positiveChunkText)
    let n = encoder.encodeBase(item.hardNegativeChunkText)
    let adapterLoss = encoder.adapter.updateTriplet(q, p, n, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    return denseLoss + minilmLoss + layerLoss + adapterLoss
}

fun tripletLoss(item: TripletExample, encoder: Encoder, margin: Float) r: Float {
    if item.hardNegativeChunkText.length() == 0 {
        return 0.0
    }
    let q = encoder.encode(item.queryText)
    let p = encoder.encode(item.positiveChunkText)
    let n = encoder.encode(item.hardNegativeChunkText)
    let simPos = cosine(q, p)
    let simNeg = cosine(q, n)
    return relu(simNeg - simPos + margin)
}

fun trainingConfigJson(cfg: TrainerConfig, count: Int, loss: Float, effectiveBatch: Int, batches: Int, examplesPerEpoch: Int) r: String {
    let dropped = count - examplesPerEpoch
    return "{\n"
        + "  \"trainer\": \"seen-native\",\n"
        + "  \"training_mode\": \"" + trainerTrainingMode() + "\",\n"
        + "  \"pooling\": \"mean\",\n"
        + "  \"backend\": \"" + cfg.backend + "\",\n"
        + "  \"backend_requires_gpu\": " + (cfg.backendGpu == 1).toString() + ",\n"
        + "  \"examples\": " + count.toString() + ",\n"
        + "  \"examples_per_epoch\": " + examplesPerEpoch.toString() + ",\n"
        + "  \"dropped_examples_per_epoch\": " + dropped.toString() + ",\n"
        + "  \"batches_per_epoch\": " + batches.toString() + ",\n"
        + "  \"epochs\": " + cfg.epochs.toString() + ",\n"
        + "  \"batch_size\": " + cfg.batchSize.toString() + ",\n"
        + "  \"effective_batch_size\": " + effectiveBatch.toString() + ",\n"
        + "  \"drop_last_batch\": true,\n"
        + "  \"learning_rate\": " + cfg.learningRate.toString() + ",\n"
        + "  \"weight_decay\": " + cfg.weightDecay.toString() + ",\n"
        + "  \"margin\": " + cfg.margin.toString() + ",\n"
        + "  \"grad_clip\": " + cfg.gradClip.toString() + ",\n"
        + "  \"quality_margin\": " + cfg.qualityMargin.toString() + ",\n"
        + "  \"weight_load_cap_elements\": " + cfg.weightLoadCapElements.toString() + ",\n"
        + "  \"capabilities\": {\n"
        + trainerCapabilityFields(cfg) + "\n"
        + "  },\n"
        + "  \"embedding_forward_implemented\": true,\n"
        + "  \"first_layer_forward_implemented\": true,\n"
        + "  \"multi_layer_forward_implemented\": true,\n"
        + "  \"projection_adapter_trained\": true,\n"
        + "  \"projection_adapter_gradient\": \"normalized_cosine_low_rank_projection\",\n"
        + "  \"projection_adapter_optimizer\": \"adamw\",\n"
        + "  \"projection_adapter_moments_tracked\": true,\n"
        + "  \"low_rank_projection_trained\": true,\n"
        + "  \"adapter_path\": \"" + cfg.adapterPath() + "\",\n"
        + "  \"layer_adapter_path\": \"" + cfg.layerAdapterPath() + "\",\n"
        + "  \"minilm_layer_adapter_path\": \"" + cfg.minilmLayerAdapterPath() + "\",\n"
        + "  \"minilm_dense_adapter_path\": \"" + cfg.minilmDenseAdapterPath() + "\",\n"
        + "  \"minilm_dense_delta_path\": \"" + cfg.minilmDenseDeltaPath() + "\",\n"
        + "  \"minilm_intermediate_delta_path\": \"" + cfg.minilmIntermediateDeltaPath() + "\",\n"
        + "  \"minilm_query_delta_path\": \"" + cfg.minilmQueryDeltaPath() + "\",\n"
        + "  \"minilm_key_delta_path\": \"" + cfg.minilmKeyDeltaPath() + "\",\n"
        + "  \"minilm_value_delta_path\": \"" + cfg.minilmValueDeltaPath() + "\",\n"
        + "  \"minilm_attention_dense_delta_path\": \"" + cfg.minilmAttentionDenseDeltaPath() + "\",\n"
        + "  \"minilm_attention_layernorm_delta_path\": \"" + cfg.minilmAttentionLayerNormDeltaPath() + "\",\n"
        + "  \"minilm_layernorm_delta_path\": \"" + cfg.minilmLayerNormDeltaPath() + "\",\n"
        + "  \"minilm_dense_adapter_layer\": " + cfg.minilmDenseAdapterLayer.toString() + ",\n"
        + "  \"minilm_dense_adapter_trained\": true,\n"
        + "  \"minilm_dense_adapter_gradient\": \"output_dense_lora_to_output_layernorm_through_downstream_transformer_tail_to_mean_pool\",\n"
        + "  \"minilm_dense_adapter_optimizer\": \"adamw\",\n"
        + "  \"minilm_output_dense_delta_trained\": true,\n"
        + "  \"minilm_output_dense_delta_gradient\": \"output_dense_weight_bias_delta_to_output_layernorm_through_downstream_transformer_tail_to_mean_pool\",\n"
        + "  \"minilm_output_dense_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_intermediate_dense_delta_trained\": true,\n"
        + "  \"minilm_intermediate_dense_delta_gradient\": \"intermediate_dense_weight_bias_delta_through_gelu_output_dense_output_layernorm_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_intermediate_dense_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_attention_query_delta_trained\": true,\n"
        + "  \"minilm_attention_query_delta_gradient\": \"self_attention_query_weight_bias_delta_through_attention_output_ffn_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_attention_query_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_attention_key_delta_trained\": true,\n"
        + "  \"minilm_attention_key_delta_gradient\": \"self_attention_key_weight_bias_delta_through_attention_output_ffn_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_attention_key_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_attention_value_delta_trained\": true,\n"
        + "  \"minilm_attention_value_delta_gradient\": \"self_attention_value_weight_bias_delta_through_attention_output_ffn_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_attention_value_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_all_ready_layer_deltas_trained\": true,\n"
        + "  \"minilm_all_ready_layer_delta_surfaces\": [\"attention.self.query\", \"attention.self.key\", \"attention.self.value\", \"attention.output.dense\", \"attention.output.LayerNorm\", \"intermediate.dense\", \"output.dense\", \"output.LayerNorm\"],\n"
        + "  \"minilm_all_ready_layer_delta_gradient\": \"simultaneous_delta_aware_per_triplet_gradients_through_layer_tail_to_mean_pool\",\n"
        + "  \"minilm_all_ready_layer_delta_update_mode\": \"accumulate_all_ready_layer_gradients_then_global_clip_then_adamw\",\n"
        + "  \"minilm_all_ready_layer_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_embedding_deltas_trained\": true,\n"
        + "  \"minilm_embedding_delta_surfaces\": [\"embeddings.word_embeddings.sparse_rows\", \"embeddings.position_embeddings.sparse_rows\", \"embeddings.token_type_embeddings.sparse_rows\", \"embeddings.LayerNorm\"],\n"
        + "  \"minilm_embedding_delta_gradient\": \"sparse_embedding_rows_and_embedding_layernorm_through_delta_aware_all_ready_transformer_layers_to_mean_pool\",\n"
        + "  \"minilm_embedding_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_embedding_delta_path\": \"" + miniLMEmbeddingDeltasPath(cfg.outputModelDir) + "\",\n"
        + "  \"direct_base_weight_update_artifact\": \"" + directBaseWeightsPath(cfg) + "\",\n"
        + "  \"direct_base_weight_update_manifest\": \"" + cfg.outputModelDir + "/seen_base_weight_update_manifest.json\",\n"
        + "  \"direct_base_weight_update_mode\": \"flush_seen_trained_delta_gradients_into_safetensors_base_weights\",\n"
        + "  \"base_weight_parameterization\": \"delta_accumulators_materialized_into_safetensors_base_weights\",\n"
        + "  \"direct_base_weight_update_scope\": \"sparse_embeddings_embedding_layernorm_and_all_ready_minilm_layer_surfaces\",\n"
        + "  \"minilm_attention_output_dense_delta_trained\": true,\n"
        + "  \"minilm_attention_output_dense_delta_gradient\": \"attention_output_dense_weight_bias_delta_through_attention_layernorm_ffn_output_layernorm_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_attention_output_dense_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_attention_output_layernorm_delta_trained\": true,\n"
        + "  \"minilm_attention_output_layernorm_delta_gradient\": \"attention_output_layernorm_gamma_beta_delta_through_ffn_output_layernorm_downstream_tail_to_mean_pool\",\n"
        + "  \"minilm_attention_output_layernorm_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_output_layernorm_delta_trained\": true,\n"
        + "  \"minilm_output_layernorm_delta_gradient\": \"output_layernorm_gamma_beta_delta_through_downstream_transformer_tail_to_mean_pool\",\n"
        + "  \"minilm_output_layernorm_delta_optimizer\": \"adamw\",\n"
        + "  \"minilm_layer_adapter_layer\": " + cfg.minilmAdapterLayer.toString() + ",\n"
        + "  \"minilm_layer_adapter_trained\": true,\n"
        + "  \"minilm_layer_adapter_gradient\": \"normalized_cosine_low_rank_projection_on_layer_mean\",\n"
        + "  \"minilm_layer_adapter_optimizer\": \"adamw\",\n"
        + "  \"minilm_output_adapter_trained\": true,\n"
        + "  \"minilm_output_adapter_gradient\": \"normalized_cosine_low_rank_projection\",\n"
        + "  \"minilm_output_adapter_optimizer\": \"adamw\",\n"
        + "  \"downstream_tail_transformer_backprop_implemented\": true,\n"
        + "  \"transformer_backprop_scope\": \"sparse_embeddings_embedding_layernorm_through_delta_aware_all_ready_layers_plus_all_ready_minilm_layers_query_key_value_attention_output_dense_attention_output_layernorm_intermediate_dense_output_dense_output_layernorm_deltas_to_mean_pool\",\n"
        + "  \"full_base_model_weight_backprop_implemented\": true,\n"
        + "  \"full_base_model_weight_backprop_scope\": \"MiniLM_encoder_surfaces_when_all_required_safetensors_are_loaded\",\n"
        + "  \"transformer_backprop_implemented\": true,\n"
        + "  \"final_loss\": " + loss.toString() + "\n"
        + "}\n"
}
