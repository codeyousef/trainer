import io.file.{exists, readText}
import adapter.{ProjectionAdapter}
import config.{TrainerConfig, resolvedMiniLMLayers, resolvedParameterRegistryLoadCap}
import dense_lora.{DenseDeltaAdapter, DenseLoRAAdapter, LayerNormDeltaAdapter, MiniLMLayerDeltas}
import embedding_delta.{MiniLMEmbeddingDeltas, miniLMEmbeddingDeltasPath}
import encoder.{Encoder}
import minilm_embeddings.{MiniLMEmbeddings}
import minilm_weights.{MiniLMWeightMap}
import parameter_registry.{MiniLMParameterRegistry}
import safetensors.{SafeTensorInfo}
import tokenizer.{Tokenizer}

class ModelBundle {
    var tokenizer: Tokenizer
    var encoder: Encoder
    var weights: SafeTensorInfo
    var hiddenSize: Int
    var layers: Int
    var attentionHeads: Int
    var intermediateSize: Int
    var weightMap: MiniLMWeightMap
    var parameterRegistry: MiniLMParameterRegistry

    static fun load(cfg: TrainerConfig) r: ModelBundle {
        return ModelBundle.loadWithTrainingState(cfg, true)
    }

    static fun loadInference(cfg: TrainerConfig) r: ModelBundle {
        return ModelBundle.loadWithTrainingState(cfg, false)
    }

    static fun loadWithTrainingState(cfg: TrainerConfig, loadTrainingState: Bool) r: ModelBundle {
        println("trainer: loading model config")
        let modelMeta = readBertConfig(cfg.modelConfigPath(), cfg.embeddingDim)
        let runtimeLayers = resolvedMiniLMLayers(cfg, modelMeta.layers)
        println("trainer: loading tokenizer")
        let tokenizer = Tokenizer.load(cfg.tokenizerPath(), cfg.maxSequenceLength)
        println("trainer: inspecting safetensors")
        let weights = SafeTensorInfo.inspect(cfg.modelWeightsPath())
        println("trainer: loading MiniLM tensors")
        let embeddings = MiniLMEmbeddings.load(weights, modelMeta.hiddenSize, runtimeLayers, modelMeta.attentionHeads, modelMeta.intermediateSize, cfg.weightLoadCapElements, cfg.backend, cfg.cacheMiniLMTensors)
        println("trainer: preparing trainable adapters")
        var minilmDenseAdapter = DenseLoRAAdapter.identity(0, 0)
        var minilmDenseDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmIntermediateDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmQueryDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmKeyDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmValueDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmAttentionDenseDelta = DenseDeltaAdapter.identity(0, 0)
        var minilmAttentionLayerNormDelta = LayerNormDeltaAdapter.identity(0)
        var minilmLayerNormDelta = LayerNormDeltaAdapter.identity(0)
        var minilmLayerDeltas = MiniLMLayerDeltas.identity(0, modelMeta.hiddenSize, modelMeta.intermediateSize)
        var minilmEmbeddingDeltas = MiniLMEmbeddingDeltas.identity(0, 0, 0, 0)
        if cfg.trainMiniLMDeltas {
            minilmDenseAdapter = DenseLoRAAdapter.identity(modelMeta.intermediateSize, modelMeta.hiddenSize)
            minilmDenseDelta = DenseDeltaAdapter.identity(modelMeta.intermediateSize, modelMeta.hiddenSize)
            minilmIntermediateDelta = DenseDeltaAdapter.identity(modelMeta.hiddenSize, modelMeta.intermediateSize)
            minilmQueryDelta = DenseDeltaAdapter.identity(modelMeta.hiddenSize, modelMeta.hiddenSize)
            minilmKeyDelta = DenseDeltaAdapter.identity(modelMeta.hiddenSize, modelMeta.hiddenSize)
            minilmValueDelta = DenseDeltaAdapter.identity(modelMeta.hiddenSize, modelMeta.hiddenSize)
            minilmAttentionDenseDelta = DenseDeltaAdapter.identity(modelMeta.hiddenSize, modelMeta.hiddenSize)
            minilmAttentionLayerNormDelta = LayerNormDeltaAdapter.identity(modelMeta.hiddenSize)
            minilmLayerNormDelta = LayerNormDeltaAdapter.identity(modelMeta.hiddenSize)
            minilmEmbeddingDeltas = MiniLMEmbeddingDeltas.identity(modelMeta.hiddenSize, embeddings.wordRows, embeddings.positionRows, embeddings.tokenTypeRows)
            if cfg.trainAllMiniLMLayers {
                minilmLayerDeltas = MiniLMLayerDeltas.identity(runtimeLayers, modelMeta.hiddenSize, modelMeta.intermediateSize)
            }
        }
        if embeddings.loaded and cfg.resumeOutputArtifacts and cfg.trainMiniLMDeltas {
            println("trainer: resuming output artifacts")
            if not cfg.trainAllMiniLMLayers {
                minilmDenseAdapter = DenseLoRAAdapter.load(cfg.minilmDenseAdapterPath(), modelMeta.intermediateSize, modelMeta.hiddenSize)
                minilmDenseDelta = DenseDeltaAdapter.load(cfg.minilmDenseDeltaPath(), modelMeta.intermediateSize, modelMeta.hiddenSize)
                minilmIntermediateDelta = DenseDeltaAdapter.load(cfg.minilmIntermediateDeltaPath(), modelMeta.hiddenSize, modelMeta.intermediateSize)
                minilmQueryDelta = DenseDeltaAdapter.load(cfg.minilmQueryDeltaPath(), modelMeta.hiddenSize, modelMeta.hiddenSize)
                minilmKeyDelta = DenseDeltaAdapter.load(cfg.minilmKeyDeltaPath(), modelMeta.hiddenSize, modelMeta.hiddenSize)
                minilmValueDelta = DenseDeltaAdapter.load(cfg.minilmValueDeltaPath(), modelMeta.hiddenSize, modelMeta.hiddenSize)
                minilmAttentionDenseDelta = DenseDeltaAdapter.load(cfg.minilmAttentionDenseDeltaPath(), modelMeta.hiddenSize, modelMeta.hiddenSize)
                minilmAttentionLayerNormDelta = LayerNormDeltaAdapter.load(cfg.minilmAttentionLayerNormDeltaPath(), modelMeta.hiddenSize)
                minilmLayerNormDelta = LayerNormDeltaAdapter.load(cfg.minilmLayerNormDeltaPath(), modelMeta.hiddenSize)
            }
            if cfg.trainAllMiniLMLayers {
                minilmLayerDeltas = MiniLMLayerDeltas.load(cfg.outputModelDir, runtimeLayers, modelMeta.hiddenSize, modelMeta.intermediateSize)
            }
            minilmEmbeddingDeltas = MiniLMEmbeddingDeltas.load(miniLMEmbeddingDeltasPath(cfg.outputModelDir), modelMeta.hiddenSize, embeddings.wordRows, embeddings.positionRows, embeddings.tokenTypeRows)
        }
        println("trainer: preparing projection adapters")
        var minilmLayerAdapter = ProjectionAdapter.identity(modelMeta.hiddenSize)
        var layerAdapter = ProjectionAdapter.identity(modelMeta.hiddenSize)
        var adapter = ProjectionAdapter.identity(modelMeta.hiddenSize)
        if cfg.resumeOutputArtifacts {
            println("trainer: resuming projection adapters")
            minilmLayerAdapter = ProjectionAdapter.load(cfg.minilmLayerAdapterPath(), modelMeta.hiddenSize)
            layerAdapter = ProjectionAdapter.load(cfg.layerAdapterPath(), modelMeta.hiddenSize)
            adapter = ProjectionAdapter.load(cfg.adapterPath(), modelMeta.hiddenSize)
        }
        let encoder = Encoder.withMiniLMEmbeddingsAndAdapter(tokenizer, modelMeta.hiddenSize, embeddings, minilmDenseAdapter, minilmDenseDelta, minilmIntermediateDelta, minilmQueryDelta, minilmKeyDelta, minilmValueDelta, minilmAttentionDenseDelta, minilmAttentionLayerNormDelta, minilmLayerNormDelta, minilmLayerDeltas, minilmEmbeddingDeltas, cfg.minilmDenseAdapterLayer, minilmLayerAdapter, cfg.minilmAdapterLayer, layerAdapter, adapter)
        var weightMap = MiniLMWeightMap.empty(modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, weights.validHeader)
        var parameterRegistry = MiniLMParameterRegistry.empty(modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, resolvedParameterRegistryLoadCap(cfg), cfg.backend, weights.validHeader)
        if loadTrainingState {
            println("trainer: inspecting MiniLM weight map")
            weightMap = MiniLMWeightMap.inspect(weights, modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, cfg.weightLoadCapElements)
            println("trainer: inspecting MiniLM parameter registry")
            parameterRegistry = MiniLMParameterRegistry.inspect(weights, modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, resolvedParameterRegistryLoadCap(cfg), cfg.backend)
        } else {
            println("trainer: inference bundle skips training registry")
        }
        println("trainer: model bundle ready")
        return ModelBundle{
            tokenizer: tokenizer,
            encoder: encoder,
            weights: weights,
            hiddenSize: modelMeta.hiddenSize,
            layers: modelMeta.layers,
            attentionHeads: modelMeta.attentionHeads,
            intermediateSize: modelMeta.intermediateSize,
            weightMap: weightMap,
            parameterRegistry: parameterRegistry
        }
    }

    fun summary() r: String {
        var out = "hidden="
        out = out + this.hiddenSize.toString()
        out = out + " layers="
        out = out + this.layers.toString()
        out = out + " heads="
        out = out + this.attentionHeads.toString()
        out = out + " tokenizer_loaded="
        out = out + this.tokenizer.loaded.toString()
        out = out + " tokenizer_config_loaded="
        out = out + this.tokenizer.tokenizerConfigLoaded.toString()
        out = out + " vocab_signal="
        out = out + this.tokenizer.vocabSignal.toString()
        out = out + " weights_present="
        out = out + this.weights.existsFlag.toString()
        out = out + " weights_valid="
        out = out + this.weights.validHeader.toString()
        out = out + " tensors="
        out = out + this.weights.tensorCount.toString()
        let weightMapSummary = this.weightMap.summary()
        out = out + " "
        out = out + weightMapSummary
        let parameterSummary = this.parameterRegistry.summary()
        out = out + " "
        out = out + parameterSummary
        let encoderSummary = this.encoder.modelEmbeddingSummary()
        out = out + " "
        out = out + encoderSummary
        return out
    }

    fun briefSummary() r: String {
        var out = "hidden="
        out = out + this.hiddenSize.toString()
        out = out + " layers="
        out = out + this.layers.toString()
        out = out + " heads="
        out = out + this.attentionHeads.toString()
        out = out + " tokenizer_loaded="
        out = out + this.tokenizer.loaded.toString()
        out = out + " vocab_signal="
        out = out + this.tokenizer.vocabSignal.toString()
        out = out + " weights_valid="
        out = out + this.weights.validHeader.toString()
        out = out + " tensors="
        out = out + this.weights.tensorCount.toString()
        out = out + " model_backend="
        out = out + this.encoder.modelEmbeddings.backend
        out = out + " model_layers_ready="
        out = out + this.encoder.modelEmbeddings.readyLayers.toString()
        out = out + "/"
        out = out + this.encoder.modelEmbeddings.layers.toString()
        out = out + " model_cache_layers="
        out = out + this.encoder.modelEmbeddings.cache.cachedLayers.toString()
        out = out + "/"
        out = out + this.encoder.modelEmbeddings.cache.requestedLayers.toString()
        return out
    }
}

class BertConfigMeta {
    var hiddenSize: Int
    var layers: Int
    var attentionHeads: Int
    var intermediateSize: Int

    static fun defaults(hiddenSize: Int) r: BertConfigMeta {
        return BertConfigMeta{
            hiddenSize: hiddenSize,
            layers: 12,
            attentionHeads: 12,
            intermediateSize: 1536
        }
    }
}

fun readBertConfig(path: String, fallbackHidden: Int) r: BertConfigMeta {
    let meta = BertConfigMeta.defaults(fallbackHidden)
    if not exists(path) {
        return meta
    }
    let text = readText(path)
    meta.hiddenSize = modelConfigInt(text, "hidden_size", meta.hiddenSize)
    meta.layers = modelConfigInt(text, "num_hidden_layers", meta.layers)
    meta.attentionHeads = modelConfigInt(text, "num_attention_heads", meta.attentionHeads)
    meta.intermediateSize = modelConfigInt(text, "intermediate_size", meta.intermediateSize)
    return meta
}

fun modelConfigInt(text: String, key: String, fallback: Int) r: Int {
    let pos = modelFindKeyColon(text, key)
    if pos < 0 {
        return fallback
    }
    var i = modelSkipWs(text, pos)
    let start = i
    if i < text.length() and text.charAt(i) == 45 {
        i = i + 1
    }
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        i = i + 1
    }
    if i <= start {
        return fallback
    }
    return modelParseInt(text.substring(start, i))
}

fun modelFindKeyColon(text: String, key: String) r: Int {
    let needle = "\"" + key + "\""
    var i = 0
    while i <= text.length() - needle.length() {
        if modelMatchesAt(text, i, needle) {
            i = i + needle.length()
            while i < text.length() and text.charAt(i) != 58 {
                i = i + 1
            }
            if i < text.length() {
                return i + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

fun modelMatchesAt(text: String, offset: Int, needle: String) r: Bool {
    if offset < 0 or offset + needle.length() > text.length() {
        return false
    }
    var i = 0
    while i < needle.length() {
        if text.charAt(offset + i) != needle.charAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun modelSkipWs(text: String, pos: Int) r: Int {
    var i = pos
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fun modelParseInt(text: String) r: Int {
    var sign = 1
    var i = 0
    if text.length() > 0 and text.charAt(0) == 45 {
        sign = -1
        i = 1
    }
    var value = 0
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        value = value * 10 + (text.charAt(i) - 48)
        i = i + 1
    }
    return value * sign
}
