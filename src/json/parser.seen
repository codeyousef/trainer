import json.value.{JsonValue, JsonValue_nullValue, JsonValue_bool, JsonValue_numberFloat, JsonValue_string, JsonValue_object}

class JsonParseResult {
    var success: Int
    var value: JsonValue
    var error: String
    var errorPosition: Int
}

class MiniJsonParser {
    var input: String
    var pos: Int
    var len: Int

    static fun new(input: String) r: MiniJsonParser {
        return MiniJsonParser{ input: input, pos: 0, len: input.length() }
    }

    fun parse() r: JsonParseResult {
        this.skipWs()
        if this.pos >= this.len {
            return jsonErr("empty input", this.pos)
        }
        let value = this.parseValue()
        if value == null {
            return jsonErr("invalid JSON", this.pos)
        }
        return jsonOk(value.unwrap())
    }

    fun parseValue() r: JsonValue? {
        this.skipWs()
        if this.pos >= this.len {
            return null
        }
        let ch = this.input.charAt(this.pos)
        if ch == 123 {
            return this.parseObject()
        }
        if ch == 34 {
            return JsonValue_string(this.parseString())
        }
        if ch == 116 {
            this.pos = this.pos + 4
            return JsonValue_bool(true)
        }
        if ch == 102 {
            this.pos = this.pos + 5
            return JsonValue_bool(false)
        }
        if ch == 110 {
            this.pos = this.pos + 4
            return JsonValue_nullValue()
        }
        return JsonValue_numberFloat(this.parseNumber())
    }

    fun parseObject() r: JsonValue? {
        let keys = Array<String>()
        let values = Array<JsonValue>()
        this.pos = this.pos + 1
        this.skipWs()
        if this.pos < this.len and this.input.charAt(this.pos) == 125 {
            this.pos = this.pos + 1
            return JsonValue_object(keys, values)
        }
        while this.pos < this.len {
            this.skipWs()
            if this.pos >= this.len or this.input.charAt(this.pos) != 34 {
                return null
            }
            let key = this.parseString()
            this.skipWs()
            if this.pos >= this.len or this.input.charAt(this.pos) != 58 {
                return null
            }
            this.pos = this.pos + 1
            let value = this.parseValue()
            if value == null {
                return null
            }
            keys.push(key)
            values.push(value.unwrap())
            this.skipWs()
            if this.pos < this.len and this.input.charAt(this.pos) == 44 {
                this.pos = this.pos + 1
            } else {
                if this.pos < this.len and this.input.charAt(this.pos) == 125 {
                    this.pos = this.pos + 1
                    return JsonValue_object(keys, values)
                }
                return null
            }
        }
        return null
    }

    fun parseString() r: String {
        var out = ""
        this.pos = this.pos + 1
        while this.pos < this.len {
            let ch = this.input.charAt(this.pos)
            if ch == 34 {
                this.pos = this.pos + 1
                return out
            }
            if ch == 92 {
                this.pos = this.pos + 1
                if this.pos >= this.len {
                    return out
                }
                let esc = this.input.charAt(this.pos)
                if esc == 110 { out = out + "\n" }
                else if esc == 114 { out = out + "\r" }
                else if esc == 116 { out = out + "\t" }
                else { out = out + String.fromCharCode(esc) }
            } else {
                out = out + String.fromCharCode(ch)
            }
            this.pos = this.pos + 1
        }
        return out
    }

    fun parseNumber() r: Float {
        let start = this.pos
        while this.pos < this.len {
            let ch = this.input.charAt(this.pos)
            if (ch >= 48 and ch <= 57) or ch == 45 or ch == 46 {
                this.pos = this.pos + 1
            } else {
                break
            }
        }
        return parseFloatText(this.input.substring(start, this.pos))
    }

    fun skipWs() r: Void {
        while this.pos < this.len {
            let ch = this.input.charAt(this.pos)
            if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
                this.pos = this.pos + 1
            } else {
                return
            }
        }
    }
}

fun parseJson(input: String) r: JsonParseResult {
    let parser = MiniJsonParser.new(input)
    return parser.parse()
}

fun jsonOk(value: JsonValue) r: JsonParseResult {
    return JsonParseResult{ success: 1, value: value, error: "", errorPosition: -1 }
}

fun jsonErr(message: String, pos: Int) r: JsonParseResult {
    return JsonParseResult{ success: 0, value: JsonValue_nullValue(), error: message, errorPosition: pos }
}

fun parseFloatText(text: String) r: Float {
    var sign = 1.0
    var i = 0
    if text.length() > 0 and text.charAt(0) == 45 {
        sign = -1.0
        i = 1
    }
    var whole = 0.0
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        whole = whole * 10.0 + (text.charAt(i) - 48).toFloat()
        i = i + 1
    }
    var frac = 0.0
    var scale = 0.1
    if i < text.length() and text.charAt(i) == 46 {
        i = i + 1
        while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
            frac = frac + (text.charAt(i) - 48).toFloat() * scale
            scale = scale * 0.1
            i = i + 1
        }
    }
    return sign * (whole + frac)
}
