import config.{TrainerConfig}
import io.file.{readBytesRange, readText, size}
import jsonl.{PairExample, readPairsWithMinLengthLimited}
import str.string.{split, trim}

fun readSourcePairs(cfg: TrainerConfig) r: Array<PairExample> {
    var path = cfg.trainJsonlPath
    if cfg.sourceDataPath.length() > 0 {
        path = cfg.sourceDataPath
    }
    let format = normalizeSourceFormat(cfg.sourceFormat, path)
    if format == "csv" {
        return readDelimitedPairs(path, ",", cfg)
    }
    if format == "tsv" {
        return readDelimitedPairs(path, "\t", cfg)
    }
    return readPairsWithMinLengthLimited(path, cfg.minTextLength, cfg.maxSourcePairs)
}

fun normalizeSourceFormat(format: String, path: String) r: String {
    let normalized = trim(format).toLowerCase()
    if normalized == "jsonl" or normalized == "csv" or normalized == "tsv" {
        return normalized
    }
    let normalizedPath = path.toLowerCase()
    if endsWith(normalizedPath, ".csv") {
        return "csv"
    }
    if endsWith(normalizedPath, ".tsv") {
        return "tsv"
    }
    return "jsonl"
}

fun readDelimitedPairs(path: String, delimiter: String, cfg: TrainerConfig) r: Array<PairExample> {
    let streamed = readDelimitedPairsStreamed(path, delimiter, cfg)
    if streamed.length() > 0 or cfg.maxSourcePairs > 0 {
        return streamed
    }
    let content = readText(path)
    let lines = split(content, "\n")
    let out = Array<PairExample>()
    let headerIndex = firstNonEmptyLine(lines)
    if headerIndex < 0 {
        return out
    }
    let headers = splitDelimitedLine(lines[headerIndex], delimiter)
    let qCol = findQueryColumn(headers, cfg.sourceQueryColumn)
    let pCol = findPositiveColumn(headers, cfg.sourcePositiveColumn)
    let dCol = findHeader(headers, cfg.sourceDomainColumn)
    let sCol = findHeader(headers, cfg.sourceSourceColumn)
    if qCol < 0 or pCol < 0 {
        return out
    }

    var i = headerIndex + 1
    while i < lines.length() {
        let rowText = trim(lines[i])
        if rowText.length() > 0 {
            let row = splitDelimitedLine(rowText, delimiter)
            let q = fieldAt(row, qCol)
            let p = fieldAt(row, pCol)
            let d = fieldAt(row, dCol)
            let s = fieldAt(row, sCol)
            if q.length() >= cfg.minTextLength and p.length() >= cfg.minTextLength {
                out.push(PairExample.new(q, p, d, s))
                if sourceReachedLimit(out.length(), cfg.maxSourcePairs) {
                    return out
                }
            }
        }
        i = i + 1
    }
    return out
}

fun readDelimitedPairsStreamed(path: String, delimiter: String, cfg: TrainerConfig) r: Array<PairExample> {
    let out = Array<PairExample>()
    let byteCount = size(path)
    if byteCount < 0 {
        return out
    }
    var headerFound = false
    var qCol = -1
    var pCol = -1
    var dCol = -1
    var sCol = -1
    var line = ""
    var offset = 0
    while offset < byteCount {
        let bytes = readBytesRange(path, offset, sourceStreamChunkSize(byteCount - offset))
        if bytes.length() == 0 {
            offset = byteCount
        } else {
            offset = offset + bytes.length()
            var i = 0
            while i < bytes.length() {
                let ch = bytes[i]
                if ch == 10 {
                    let status = processDelimitedLine(out, line, delimiter, cfg, headerFound, qCol, pCol, dCol, sCol)
                    headerFound = status.headerFound
                    qCol = status.queryColumn
                    pCol = status.positiveColumn
                    dCol = status.domainColumn
                    sCol = status.sourceColumn
                    if status.limitReached {
                        return out
                    }
                    line = ""
                } else if ch != 13 {
                    line = line + String.fromCharCode(ch)
                }
                i = i + 1
            }
        }
    }
    if line.length() > 0 {
        let status = processDelimitedLine(out, line, delimiter, cfg, headerFound, qCol, pCol, dCol, sCol)
        headerFound = status.headerFound
    }
    return out
}

fun sourceStreamChunkSize(remaining: Int) r: Int {
    if remaining < 65536 {
        return remaining
    }
    return 65536
}

class DelimitedReadStatus {
    var headerFound: Bool
    var queryColumn: Int
    var positiveColumn: Int
    var domainColumn: Int
    var sourceColumn: Int
    var limitReached: Bool

    static fun new(headerFound: Bool, queryColumn: Int, positiveColumn: Int, domainColumn: Int, sourceColumn: Int, limitReached: Bool) r: DelimitedReadStatus {
        return DelimitedReadStatus{
            headerFound: headerFound,
            queryColumn: queryColumn,
            positiveColumn: positiveColumn,
            domainColumn: domainColumn,
            sourceColumn: sourceColumn,
            limitReached: limitReached
        }
    }
}

fun processDelimitedLine(out: Array<PairExample>, lineText: String, delimiter: String, cfg: TrainerConfig, headerFound: Bool, qCol: Int, pCol: Int, dCol: Int, sCol: Int) r: DelimitedReadStatus {
    let rowText = trim(lineText)
    if rowText.length() == 0 {
        return DelimitedReadStatus.new(headerFound, qCol, pCol, dCol, sCol, false)
    }
    if not headerFound {
        let headers = splitDelimitedLine(rowText, delimiter)
        let queryColumn = findQueryColumn(headers, cfg.sourceQueryColumn)
        let positiveColumn = findPositiveColumn(headers, cfg.sourcePositiveColumn)
        let domainColumn = findHeader(headers, cfg.sourceDomainColumn)
        let sourceColumn = findHeader(headers, cfg.sourceSourceColumn)
        return DelimitedReadStatus.new(true, queryColumn, positiveColumn, domainColumn, sourceColumn, false)
    }
    if qCol < 0 or pCol < 0 {
        return DelimitedReadStatus.new(headerFound, qCol, pCol, dCol, sCol, false)
    }
    let row = splitDelimitedLine(rowText, delimiter)
    let q = fieldAt(row, qCol)
    let p = fieldAt(row, pCol)
    let d = fieldAt(row, dCol)
    let s = fieldAt(row, sCol)
    if q.length() >= cfg.minTextLength and p.length() >= cfg.minTextLength {
        out.push(PairExample.new(q, p, d, s))
    }
    return DelimitedReadStatus.new(headerFound, qCol, pCol, dCol, sCol, sourceReachedLimit(out.length(), cfg.maxSourcePairs))
}

fun sourceReachedLimit(count: Int, maxItems: Int) r: Bool {
    return maxItems > 0 and count >= maxItems
}

fun splitDelimitedLine(line: String, delimiter: String) r: Array<String> {
    let fields = Array<String>()
    var field = ""
    var inQuotes = false
    var i = 0
    while i < line.length() {
        let ch = line.charAt(i)
        if ch == 34 {
            if inQuotes and i + 1 < line.length() and line.charAt(i + 1) == 34 {
                field = field + "\""
                i = i + 1
            } else {
                inQuotes = not inQuotes
            }
        } else if not inQuotes and delimiterMatches(line, i, delimiter) {
            fields.push(trim(field))
            field = ""
            i = i + delimiter.length() - 1
        } else {
            field = field + String.fromCharCode(ch)
        }
        i = i + 1
    }
    fields.push(trim(field))
    return fields
}

fun delimiterMatches(line: String, offset: Int, delimiter: String) r: Bool {
    if delimiter.length() == 0 or offset + delimiter.length() > line.length() {
        return false
    }
    var i = 0
    while i < delimiter.length() {
        if line.charAt(offset + i) != delimiter.charAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun firstNonEmptyLine(lines: Array<String>) r: Int {
    var i = 0
    while i < lines.length() {
        if trim(lines[i]).length() > 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

fun fieldAt(row: Array<String>, index: Int) r: String {
    if index < 0 or index >= row.length() {
        return ""
    }
    return trim(row[index])
}

fun findQueryColumn(headers: Array<String>, requested: String) r: Int {
    var idx = findHeader(headers, requested)
    if idx >= 0 { return idx }
    idx = findHeader(headers, "query_text")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "query")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "question")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "instruction")
    if idx >= 0 { return idx }
    return findHeader(headers, "sentence")
}

fun findPositiveColumn(headers: Array<String>, requested: String) r: Int {
    var idx = findHeader(headers, requested)
    if idx >= 0 { return idx }
    idx = findHeader(headers, "positive_chunk_text")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "positive")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "answer")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "response")
    if idx >= 0 { return idx }
    idx = findHeader(headers, "description")
    if idx >= 0 { return idx }
    return findHeader(headers, "sentence")
}

fun findHeader(headers: Array<String>, name: String) r: Int {
    if name.length() == 0 {
        return -1
    }
    let normalizedName = trim(name).toLowerCase()
    var i = 0
    while i < headers.length() {
        if trim(headers[i]).toLowerCase() == normalizedName {
            return i
        }
        i = i + 1
    }
    return -1
}

fun endsWith(text: String, suffix: String) r: Bool {
    if suffix.length() > text.length() {
        return false
    }
    return text.substring(text.length() - suffix.length(), text.length()) == suffix
}
