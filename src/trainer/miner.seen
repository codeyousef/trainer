import config.{TrainerConfig}
import encoder.{Encoder}
import gpu_tensor_ops.{tensorGpuBackendEnabled, tensorGpuTopKInnerProductIndices}
import io_utils.{writeAtomicText}
import jsonl.{PairExample, TripletExample, tripletsToJsonl}
import math_utils.{cosine}
import source_adapters.{readSourcePairs}
import tensor.{Tensor}

class MineResult {
    var count: Int
    var outputPath: String

    static fun new(count: Int, outputPath: String) r: MineResult {
        return MineResult{ count: count, outputPath: outputPath }
    }
}

class MiningEmbeddingMatrix {
    var ok: Bool
    var rows: Int
    var cols: Int
    var values: Array<Float>

    static fun empty() r: MiningEmbeddingMatrix {
        return MiningEmbeddingMatrix{ ok: false, rows: 0, cols: 0, values: Array<Float>() }
    }

    static fun new(rows: Int, cols: Int, values: Array<Float>) r: MiningEmbeddingMatrix {
        return MiningEmbeddingMatrix{ ok: true, rows: rows, cols: cols, values: values }
    }
}

fun mineHardNegatives(cfg: TrainerConfig, encoder: Encoder) r: MineResult {
    let pairs = readSourcePairs(cfg)
    let positiveMatrix = buildPositiveEmbeddingMatrixBackend(pairs, encoder, cfg.backend)
    let out = Array<TripletExample>()
    var i = 0
    while i < pairs.length() {
        let queryEmbedding = encoder.encode(pairs[i].queryText)
        var negIdx = -1
        if positiveMatrix.ok {
            negIdx = findNegativeIndexWithMatrix(pairs, i, queryEmbedding, positiveMatrix, cfg.topK, cfg.backend)
        } else {
            negIdx = findNegativeIndexByEncoding(pairs, i, encoder, cfg.topK)
        }
        var neg = ""
        if negIdx >= 0 {
            neg = pairs[negIdx].positiveChunkText
        }
        let candidate = TripletExample.new(
            pairs[i].queryText,
            pairs[i].positiveChunkText,
            neg,
            pairs[i].domain,
            pairs[i].source
        )
        if passesQualityFilter(candidate, encoder, cfg.qualityMargin) {
            out.push(candidate)
        }
        i = i + 1
    }
    writeAtomicText(cfg.minedJsonlPath, tripletsToJsonl(out))
    return MineResult.new(out.length(), cfg.minedJsonlPath)
}

fun findNegativeIndex(pairs: Array<PairExample>, queryIndex: Int, encoder: Encoder, topK: Int) r: Int {
    let positiveMatrix = buildPositiveEmbeddingMatrix(pairs, encoder)
    let queryEmbedding = encoder.encode(pairs[queryIndex].queryText)
    if not positiveMatrix.ok {
        return findNegativeIndexByEncoding(pairs, queryIndex, encoder, topK)
    }
    return findNegativeIndexWithMatrix(pairs, queryIndex, queryEmbedding, positiveMatrix, topK, "cpu")
}

fun findNegativeIndexByEncoding(pairs: Array<PairExample>, queryIndex: Int, encoder: Encoder, topK: Int) r: Int {
    if pairs.length() <= 1 {
        return -1
    }
    let q = encoder.encode(pairs[queryIndex].queryText)
    let candidateCount = pairs.length() - 1
    let keep = normalizedTopK(topK, candidateCount)
    let topIndices = initializedIntArray(keep, -1)
    let topScores = initializedFloatArray(keep, -999999.0)
    var i = 0
    while i < pairs.length() {
        if i != queryIndex {
            let p = encoder.encode(pairs[i].positiveChunkText)
            let score = cosine(q, p)
            insertTopCandidate(topIndices, topScores, i, score)
        }
        i = i + 1
    }
    let topChoice = firstValidTopIndex(pairs, queryIndex, topIndices)
    if topChoice >= 0 {
        return topChoice
    }
    return fallbackNegativeIndex(pairs, queryIndex)
}

fun buildPositiveEmbeddingMatrix(pairs: Array<PairExample>, encoder: Encoder) r: MiningEmbeddingMatrix {
    return buildPositiveEmbeddingMatrixBackend(pairs, encoder, "cpu")
}

fun buildPositiveEmbeddingMatrixBackend(pairs: Array<PairExample>, encoder: Encoder, backend: String) r: MiningEmbeddingMatrix {
    if pairs.length() == 0 {
        return MiningEmbeddingMatrix.empty()
    }
    let values = Array<Float>()
    var cols = 0
    var i = 0
    while i < pairs.length() {
        let emb = encoder.encode(pairs[i].positiveChunkText)
        if emb.length() == 0 {
            return MiningEmbeddingMatrix.empty()
        }
        if cols == 0 {
            cols = emb.length()
        }
        if emb.length() != cols {
            return MiningEmbeddingMatrix.empty()
        }
        var d = 0
        while d < emb.length() {
            values.push(emb[d])
            d = d + 1
        }
        i = i + 1
    }
    return normalizeMiningMatrixBackend(MiningEmbeddingMatrix.new(pairs.length(), cols, values), backend)
}

fun findNegativeIndexWithMatrix(pairs: Array<PairExample>, queryIndex: Int, queryEmbedding: Array<Float>, matrix: MiningEmbeddingMatrix, topK: Int, backend: String) r: Int {
    if not matrix.ok or queryEmbedding.length() != matrix.cols {
        return fallbackNegativeIndex(pairs, queryIndex)
    }
    let normalizedMatrix = normalizeMiningMatrixBackend(matrix, backend)
    let normalizedQuery = normalizeMiningQueryBackend(queryEmbedding, backend)
    if not normalizedMatrix.ok or normalizedQuery.length() != normalizedMatrix.cols {
        return fallbackNegativeIndex(pairs, queryIndex)
    }
    let candidateCount = pairs.length() - 1
    let keep = normalizedTopK(topK, candidateCount)
    if keep <= 0 {
        return -1
    }
    if tensorGpuBackendEnabled(backend) {
        var gpuKeep = keep + 1
        if gpuKeep > normalizedMatrix.rows {
            gpuKeep = normalizedMatrix.rows
        }
        let gpu = tensorGpuTopKInnerProductIndices(normalizedQuery, normalizedMatrix.values, normalizedMatrix.rows, normalizedMatrix.cols, gpuKeep)
        if gpu.ok == 1 {
            let gpuChoice = firstValidTopIndex(pairs, queryIndex, gpu.values)
            if gpuChoice >= 0 {
                return gpuChoice
            }
            let fallback = fallbackNegativeIndex(pairs, queryIndex)
            if fallback >= 0 {
                return fallback
            }
        }
    }
    return findNegativeIndexScalar(pairs, queryIndex, normalizedQuery, normalizedMatrix, topK)
}

fun normalizeMiningMatrixBackend(matrix: MiningEmbeddingMatrix, backend: String) r: MiningEmbeddingMatrix {
    if not matrix.ok or matrix.rows <= 0 or matrix.cols <= 0 or matrix.values.length() < matrix.rows * matrix.cols {
        return matrix
    }
    let normalized = Tensor.fromArray(matrix.rows, matrix.cols, matrix.values, backend).normalizeRows()
    if normalized.values.length() == matrix.rows * matrix.cols {
        return MiningEmbeddingMatrix.new(matrix.rows, matrix.cols, normalized.values)
    }
    return matrix
}

fun normalizeMiningQueryBackend(queryEmbedding: Array<Float>, backend: String) r: Array<Float> {
    if queryEmbedding.length() <= 0 {
        return Array<Float>()
    }
    let normalized = Tensor.fromArray(1, queryEmbedding.length(), queryEmbedding, backend).normalizeRows()
    if normalized.values.length() == queryEmbedding.length() {
        return normalized.values
    }
    return queryEmbedding
}

fun findNegativeIndexScalar(pairs: Array<PairExample>, queryIndex: Int, queryEmbedding: Array<Float>, matrix: MiningEmbeddingMatrix, topK: Int) r: Int {
    if pairs.length() <= 1 {
        return -1
    }
    let candidateCount = pairs.length() - 1
    let keep = normalizedTopK(topK, candidateCount)
    let topIndices = initializedIntArray(keep, -1)
    let topScores = initializedFloatArray(keep, -999999.0)
    var i = 0
    while i < pairs.length() {
        if i != queryIndex {
            let score = miningScore(queryEmbedding, matrix, i)
            insertTopCandidate(topIndices, topScores, i, score)
        }
        i = i + 1
    }

    let topChoice = firstValidTopIndex(pairs, queryIndex, topIndices)
    if topChoice >= 0 {
        return topChoice
    }
    return fallbackNegativeIndex(pairs, queryIndex)
}

fun miningScore(queryEmbedding: Array<Float>, matrix: MiningEmbeddingMatrix, row: Int) r: Float {
    if matrix.ok and row >= 0 and row < matrix.rows and queryEmbedding.length() == matrix.cols {
        var sum = 0.0
        var d = 0
        let offset = row * matrix.cols
        while d < matrix.cols {
            sum = sum + queryEmbedding[d] * matrix.values[offset + d]
            d = d + 1
        }
        return sum
    }
    return -999999.0
}

fun firstValidTopIndex(pairs: Array<PairExample>, queryIndex: Int, indices: Array<Int>) r: Int {
    var rank = 0
    while rank < indices.length() {
        let idx = indices[rank]
        if idx >= 0 and idx != queryIndex and not excludedNegativeCandidate(pairs, queryIndex, idx) {
            return idx
        }
        rank = rank + 1
    }
    return -1
}

fun fallbackNegativeIndex(pairs: Array<PairExample>, queryIndex: Int) r: Int {
    var fallbackAny = -1
    var fallbackValid = -1
    var i = 0
    while i < pairs.length() {
        if i != queryIndex {
            if fallbackAny < 0 {
                fallbackAny = i
            }
            if not excludedNegativeCandidate(pairs, queryIndex, i) and fallbackValid < 0 {
                fallbackValid = i
            }
        }
        i = i + 1
    }
    if fallbackValid >= 0 {
        return fallbackValid
    }
    return fallbackAny
}

fun excludedNegativeCandidate(pairs: Array<PairExample>, queryIndex: Int, candidateIndex: Int) r: Bool {
    let sameDomain = pairs[candidateIndex].domain.length() > 0 and pairs[candidateIndex].domain == pairs[queryIndex].domain
    let sameSource = pairs[candidateIndex].source.length() > 0 and pairs[candidateIndex].source == pairs[queryIndex].source
    return sameDomain or sameSource
}

fun normalizedTopK(requested: Int, candidates: Int) r: Int {
    if candidates <= 0 {
        return 0
    }
    var k = requested
    if k <= 0 {
        k = 1
    }
    if k > candidates {
        k = candidates
    }
    return k
}

fun initializedIntArray(count: Int, value: Int) r: Array<Int> {
    let out = Array<Int>()
    var i = 0
    while i < count {
        out.push(value)
        i = i + 1
    }
    return out
}

fun initializedFloatArray(count: Int, value: Float) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < count {
        out.push(value)
        i = i + 1
    }
    return out
}

fun insertTopCandidate(indices: Array<Int>, scores: Array<Float>, idx: Int, score: Float) r: Void {
    var pos = 0
    while pos < scores.length() {
        if indices[pos] < 0 or score > scores[pos] {
            var j = scores.length() - 1
            while j > pos {
                scores[j] = scores[j - 1]
                indices[j] = indices[j - 1]
                j = j - 1
            }
            scores[pos] = score
            indices[pos] = idx
            return
        }
        pos = pos + 1
    }
}

fun passesQualityFilter(item: TripletExample, encoder: Encoder, margin: Float) r: Bool {
    if margin <= -1.0 {
        return true
    }
    if item.hardNegativeChunkText.length() == 0 {
        return true
    }
    let q = encoder.encode(item.queryText)
    let p = encoder.encode(item.positiveChunkText)
    let n = encoder.encode(item.hardNegativeChunkText)
    let simPos = cosine(q, p)
    let simNeg = cosine(q, n)
    return simPos - simNeg >= margin
}
