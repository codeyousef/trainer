import env.env.{args}
import config.{TrainerConfig, readConfig, resolvedMiniLMLayers, writeTrainerConfigJson}
import eval.{EvalResult}
import io.file.{appendText, readText}
import io_utils.{writeAtomicText}
import jsonl.{readTripletsLimited, tripletToJson}
import math_utils.{deterministicShuffleIndices}
import model.{readBertConfig}
import pipeline.{Pipeline}
import process.process.{runCommand, shellQuote}
import training.{batchesPerEpoch, effectiveBatchSize, trainingConfigJson}

fun trainerMain() r: Int {
    let argv = args()
    if argv.length() < 2 {
        printUsage()
        return 1
    }

    let command = argv[1]
    if command == "help" or command == "--help" or command == "-h" {
        printUsage()
        return 0
    }

    let configPath = parseConfigArg(argv)
    let cfg = readConfig(configPath)
    if command == "bench-eval" {
        return runBenchEval(argv, cfg)
    }
    if command == "run-all" {
        if shouldRunAllInProcess(cfg) {
            return runAllInProcess(cfg)
        }
        return runAllIsolated(argv[0], cfg, configPath)
    }
    if command == "train" {
        let splitCode = maybeRunSplitTrain(argv[0], cfg)
        if splitCode >= 0 {
            return splitCode
        }
    }

    let pipeline = if command == "mine" or command == "calibrate" or command == "eval" {
        Pipeline.inference(cfg)
    } else {
        Pipeline.new(cfg)
    }

    println("trainer: backend " + cfg.backend + " requires_gpu " + cfg.backendGpu.toString())
    let backendReady = pipeline.prepareBackend()
    if backendReady == false {
        return 2
    }

    let modelSummary = if command == "mine" or command == "calibrate" or command == "eval" { pipeline.bundle.briefSummary() } else { pipeline.bundle.summary() }
    var modelLine = "trainer: model "
    modelLine = modelLine + modelSummary
    println(modelLine)

    if command == "mine" {
        let result = pipeline.mine()
        println("trainer: mined " + result.count.toString() + " triplets -> " + result.outputPath)
        return 0
    }
    if command == "train" {
        let result = pipeline.train()
        println("trainer: final loss " + result.finalLoss.toString())
        return 0
    }
    if command == "calibrate" {
        let count = pipeline.calibrate()
        println("trainer: calibrated " + count.toString() + " domains")
        return 0
    }
    if command == "eval" {
        let result = pipeline.eval()
        println("trainer: answer rate " + result.answerRate.toString())
        printEvalTiming(result)
        return 0
    }
    if command == "package" {
        let result = pipeline.packageModel()
        println("trainer: package -> " + result.outputDir)
        return 0
    }
    println("trainer: unknown command: " + command)
    printUsage()
    return 1
}

fun runAllIsolated(executable: String, cfg: TrainerConfig, configPath: String) r: Int {
    let resumeConfigPath = cfg.outputModelDir + "/run_all_resume_config.json"
    if not writeTrainerConfigJson(resumeConfigPath, cfg, true) {
        println("trainer: failed to write run-all resume config: " + resumeConfigPath)
        return 1
    }
    if not runTrainerStage(executable, "mine", configPath) { return 1 }
    if not runTrainerStage(executable, "train", configPath) { return 1 }
    if not runTrainerStage(executable, "calibrate", resumeConfigPath) { return 1 }
    if not runTrainerStage(executable, "eval", resumeConfigPath) { return 1 }
    if not runTrainerStage(executable, "package", resumeConfigPath) { return 1 }
    return 0
}

fun runBenchEval(argv: Array<String>, cfg: TrainerConfig) r: Int {
    let runs = parseIntArg(argv, "--runs", 7)
    let warmup = parseIntArg(argv, "--warmup", 2)
    let resultPath = parseStringArg(argv, "--result", "target/bench/seen-bench-eval.json")
    let loadStart = __GetTime()
    let pipeline = Pipeline.inference(cfg)
    println("trainer: backend " + cfg.backend + " requires_gpu " + cfg.backendGpu.toString())
    let backendReady = pipeline.prepareBackend()
    if backendReady == false {
        return 2
    }
    let loadMs = cliElapsedMillis(loadStart)
    println("trainer: model " + pipeline.bundle.briefSummary())
    var i = 0
    while i < warmup {
        let warm = pipeline.eval()
        println("trainer: bench warmup " + (i + 1).toString() + " answer_rate=" + warm.answerRate.toString() + " encode_ms=" + warm.encodeMs.toString())
        i = i + 1
    }
    let measuredRuns = if runs > 0 { runs } else { 1 }
    let json = benchEvalJsonStart(cfg, loadMs, warmup, measuredRuns)
    if not writeAtomicText(resultPath, json) {
        println("trainer: failed to write bench result: " + resultPath)
        return 1
    }
    i = 0
    while i < measuredRuns {
        let runStart = __GetTime()
        let result = pipeline.eval()
        let wallMs = cliElapsedMillis(runStart)
        let entry = benchEvalRunJson(i + 1, result, wallMs, i + 1 < measuredRuns)
        if not appendBenchResult(resultPath, entry) {
            println("trainer: failed to append bench result: " + resultPath)
            return 1
        }
        println("trainer: bench run " + (i + 1).toString() + " answer_rate=" + result.answerRate.toString() + " wall_ms=" + wallMs.toString() + " encode_ms=" + result.encodeMs.toString())
        i = i + 1
    }
    if not appendBenchResult(resultPath, "  ]\n}\n") {
        println("trainer: failed to finish bench result: " + resultPath)
        return 1
    }
    println("trainer: bench result -> " + resultPath)
    return 0
}

fun appendBenchResult(path: String, text: String) r: Bool {
    return appendText(path, text)
}

fun benchEvalJsonStart(cfg: TrainerConfig, loadMs: Float, warmup: Int, runs: Int) r: String {
    return "{\n"
        + "  \"implementation\": \"seen-trainer\",\n"
        + "  \"device\": \"vulkan\",\n"
        + "  \"gpu_required\": " + cfg.backendGpu.toString() + ",\n"
        + "  \"config_path\": \"\",\n"
        + "  \"test_jsonl_path\": \"" + escapeBenchJson(cfg.testJsonlPath) + "\",\n"
        + "  \"thresholds_path\": \"" + escapeBenchJson(cfg.thresholdsPath) + "\",\n"
        + "  \"output_model_dir\": \"" + escapeBenchJson(cfg.outputModelDir) + "\",\n"
        + "  \"load_ms\": " + loadMs.toString() + ",\n"
        + "  \"warmup_runs\": " + warmup.toString() + ",\n"
        + "  \"measured_runs\": " + runs.toString() + ",\n"
        + "  \"runs\": [\n"
}

fun benchEvalRunJson(index: Int, result: EvalResult, wallMs: Float, comma: Bool) r: String {
    var out = "    {"
        + "\"run\": " + index.toString()
        + ", \"wall_ms\": " + wallMs.toString()
        + ", \"total_eval_ms\": " + result.totalEvalMs.toString()
        + ", \"read_dataset_ms\": " + result.readDatasetMs.toString()
        + ", \"tokenize_ms\": " + result.tokenizeMs.toString()
        + ", \"encode_ms\": " + result.encodeMs.toString()
        + ", \"score_threshold_ms\": " + result.scoreThresholdMs.toString()
        + ", \"write_ms\": " + result.resultWriteMs.toString()
        + ", \"unique_texts\": " + result.uniqueTexts.toString()
        + ", \"total\": " + result.total.toString()
        + ", \"answered\": " + result.answered.toString()
        + ", \"answer_rate\": " + result.answerRate.toString()
        + "}"
    if comma {
        out = out + ","
    }
    return out + "\n"
}

fun escapeBenchJson(text: String) r: String {
    var out = ""
    var i = 0
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 34 {
            out = out + "\\\""
        } else if ch == 92 {
            out = out + "\\\\"
        } else {
            out = out + text.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

fun shouldRunAllInProcess(cfg: TrainerConfig) r: Bool {
    if not cfg.trainMiniLMDeltas or not cfg.trainAllMiniLMLayers {
        return false
    }
    return cappedAtMost(cfg.maxMinedTriplets, 2)
        and cappedAtMost(cfg.maxTrainTriplets, 2)
        and cappedAtMost(cfg.maxCalibrationTriplets, 2)
        and cappedAtMost(cfg.maxEvalTriplets, 2)
}

fun cappedAtMost(value: Int, cap: Int) r: Bool {
    return value > 0 and value <= cap
}

fun runAllInProcess(cfg: TrainerConfig) r: Int {
    println("trainer: run-all small full-delta in-process")
    let pipeline = Pipeline.new(cfg)
    println("trainer: backend " + cfg.backend + " requires_gpu " + cfg.backendGpu.toString())
    let backendReady = pipeline.prepareBackend()
    if backendReady == false {
        return 2
    }
    let modelSummary = pipeline.bundle.summary()
    var modelLine = "trainer: model "
    modelLine = modelLine + modelSummary
    println(modelLine)
    return pipeline.runAll()
}

fun runTrainerStage(executable: String, command: String, configPath: String) r: Bool {
    println("trainer: run-all stage " + command)
    let cmd = shellQuote(executable) + " " + command + " --config " + shellQuote(configPath)
    let result = runCommand(cmd)
    if result.output.length() > 0 {
        println(result.output)
    }
    if result.success {
        return true
    }
    println("trainer: run-all stage failed: " + command)
    return false
}

fun maybeRunSplitTrain(executable: String, cfg: TrainerConfig) r: Int {
    if not cfg.trainMiniLMDeltas or not cfg.trainAllMiniLMLayers or cfg.epochs <= 0 {
        return -1
    }
    let trainPath = if cfg.minedJsonlPath.length() > 0 { cfg.minedJsonlPath } else { cfg.trainJsonlPath }
    let items = readTripletsLimited(trainPath, cfg.maxTrainTriplets)
    if items.length() <= 2 {
        return -1
    }

    println("trainer: split full-delta train into " + items.length().toString() + " isolated item stages")
    let originalTrainPath = cfg.trainJsonlPath
    let originalMinedPath = cfg.minedJsonlPath
    let originalEpochs = cfg.epochs
    let originalBatchSize = cfg.batchSize
    let originalMaxTrain = cfg.maxTrainTriplets
    let originalResume = cfg.resumeOutputArtifacts

    var firstStage = true
    var trained = 0
    var lossSum = 0.0
    var epoch = 0
    while epoch < originalEpochs {
        let order = deterministicShuffleIndices(items.length(), cfg.seed + epoch)
        var offset = 0
        while offset < items.length() {
            let item = items[order[offset]]
            if item.hardNegativeChunkText.length() > 0 {
                let prefix = cfg.outputModelDir + "/train_split_epoch_" + epoch.toString() + "_item_" + offset.toString()
                let itemPath = prefix + ".jsonl"
                let itemConfigPath = prefix + ".config.json"
                if not writeAtomicText(itemPath, tripletToJson(item) + "\n") {
                    println("trainer: failed to write split train item: " + itemPath)
                    restoreSplitTrainConfig(cfg, originalTrainPath, originalMinedPath, originalEpochs, originalBatchSize, originalMaxTrain)
                    return 1
                }
                cfg.trainJsonlPath = itemPath
                cfg.minedJsonlPath = itemPath
                cfg.epochs = 1
                cfg.batchSize = 1
                cfg.maxTrainTriplets = 1
                let resumeStage = if firstStage { originalResume } else { true }
                if not writeTrainerConfigJson(itemConfigPath, cfg, resumeStage) {
                    println("trainer: failed to write split train config: " + itemConfigPath)
                    restoreSplitTrainConfig(cfg, originalTrainPath, originalMinedPath, originalEpochs, originalBatchSize, originalMaxTrain)
                    return 1
                }
                if not runTrainerStage(executable, "train", itemConfigPath) {
                    restoreSplitTrainConfig(cfg, originalTrainPath, originalMinedPath, originalEpochs, originalBatchSize, originalMaxTrain)
                    return 1
                }
                lossSum = lossSum + readTrainingFinalLoss(cfg.outputModelDir + "/training_config.json")
                trained = trained + 1
                firstStage = false
            }
            offset = offset + 1
        }
        epoch = epoch + 1
    }

    restoreSplitTrainConfig(cfg, originalTrainPath, originalMinedPath, originalEpochs, originalBatchSize, originalMaxTrain)
    let finalLoss = if trained > 0 { lossSum / trained.toFloat() } else { 0.0 }
    let batchSize = effectiveBatchSize(originalBatchSize, items.length())
    let batches = batchesPerEpoch(items.length(), batchSize)
    let examplesPerEpoch = batches * batchSize
    let modelMeta = readBertConfig(cfg.modelConfigPath(), cfg.embeddingDim)
    let runtimeLayers = resolvedMiniLMLayers(cfg, modelMeta.layers)
    let trainingJson = trainingConfigJson(cfg, items.length(), finalLoss, batchSize, batches, examplesPerEpoch, runtimeLayers)
    writeAtomicText(cfg.outputModelDir + "/training_config.json", trainingJson)
    println("trainer: final loss " + finalLoss.toString())
    return 0
}

fun restoreSplitTrainConfig(cfg: TrainerConfig, trainPath: String, minedPath: String, epochs: Int, batchSize: Int, maxTrain: Int) r: Void {
    cfg.trainJsonlPath = trainPath
    cfg.minedJsonlPath = minedPath
    cfg.epochs = epochs
    cfg.batchSize = batchSize
    cfg.maxTrainTriplets = maxTrain
}

fun printEvalTiming(result: EvalResult) r: Void {
    println("trainer: eval timing read_ms=" + result.readDatasetMs.toString()
        + " tokenize_ms=" + result.tokenizeMs.toString()
        + " encode_ms=" + result.encodeMs.toString()
        + " score_threshold_ms=" + result.scoreThresholdMs.toString()
        + " write_ms=" + result.resultWriteMs.toString()
        + " total_ms=" + result.totalEvalMs.toString()
        + " unique_texts=" + result.uniqueTexts.toString())
}

fun readTrainingFinalLoss(path: String) r: Float {
    let text = readText(path)
    return cliJsonFloat(text, "final_loss", 0.0)
}

fun cliJsonFloat(text: String, key: String, fallback: Float) r: Float {
    let pos = cliFindKeyColon(text, key)
    if pos < 0 {
        return fallback
    }
    var i = cliSkipWs(text, pos)
    let start = i
    while i < text.length() {
        let ch = text.charAt(i)
        if (ch >= 48 and ch <= 57) or ch == 45 or ch == 43 or ch == 46 or ch == 69 or ch == 101 {
            i = i + 1
        } else {
            break
        }
    }
    if i <= start {
        return fallback
    }
    return cliParseFloat(text.substring(start, i))
}

fun cliFindKeyColon(text: String, key: String) r: Int {
    let needle = "\"" + key + "\""
    var i = 0
    while i <= text.length() - needle.length() {
        if cliMatchesAt(text, i, needle) {
            i = i + needle.length()
            while i < text.length() and text.charAt(i) != 58 {
                i = i + 1
            }
            if i < text.length() {
                return i + 1
            }
            return -1
        }
        i = i + 1
    }
    return -1
}

fun cliMatchesAt(text: String, offset: Int, needle: String) r: Bool {
    if offset < 0 or offset + needle.length() > text.length() {
        return false
    }
    var i = 0
    while i < needle.length() {
        if text.charAt(offset + i) != needle.charAt(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fun cliSkipWs(text: String, pos: Int) r: Int {
    var i = pos
    while i < text.length() {
        let ch = text.charAt(i)
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fun cliParseFloat(text: String) r: Float {
    var sign = 1.0
    var i = 0
    if text.length() > 0 and text.charAt(0) == 45 {
        sign = -1.0
        i = 1
    } else if text.length() > 0 and text.charAt(0) == 43 {
        i = 1
    }
    var value = 0.0
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        value = value * 10.0 + (text.charAt(i) - 48).toFloat()
        i = i + 1
    }
    if i < text.length() and text.charAt(i) == 46 {
        i = i + 1
        var scale = 0.1
        while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
            value = value + (text.charAt(i) - 48).toFloat() * scale
            scale = scale * 0.1
            i = i + 1
        }
    }
    return value * sign
}

fun parseConfigArg(argv: Array<String>) r: String {
    var i = 2
    while i < argv.length() {
        if argv[i] == "--config" {
            if i + 1 < argv.length() {
                return argv[i + 1]
            }
        }
        if startsWithFlag(argv[i], "--config=") {
            return argv[i].substring(9, argv[i].length())
        }
        i = i + 1
    }
    return "config/example.config.json"
}

fun parseStringArg(argv: Array<String>, flag: String, fallback: String) r: String {
    var i = 2
    let eqPrefix = flag + "="
    while i < argv.length() {
        if argv[i] == flag {
            if i + 1 < argv.length() {
                return argv[i + 1]
            }
        }
        if startsWithFlag(argv[i], eqPrefix) {
            return argv[i].substring(eqPrefix.length(), argv[i].length())
        }
        i = i + 1
    }
    return fallback
}

fun parseIntArg(argv: Array<String>, flag: String, fallback: Int) r: Int {
    let text = parseStringArg(argv, flag, "")
    if text.length() == 0 {
        return fallback
    }
    return cliParseInt(text, fallback)
}

fun cliParseInt(text: String, fallback: Int) r: Int {
    var sign = 1
    var i = 0
    if text.length() > 0 and text.charAt(0) == 45 {
        sign = -1
        i = 1
    }
    var value = 0
    var digits = 0
    while i < text.length() and text.charAt(i) >= 48 and text.charAt(i) <= 57 {
        value = value * 10 + (text.charAt(i) - 48)
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return fallback
    }
    return value * sign
}

fun cliElapsedMillis(startSeconds: Float) r: Float {
    return (__GetTime() - startSeconds) * 1000.0
}

fun startsWithFlag(text: String, prefix: String) r: Bool {
    if text.length() < prefix.length() {
        return false
    }
    return text.substring(0, prefix.length()) == prefix
}

fun printUsage() r: Void {
    println("Seen Sinai trainer")
    println("usage: trainer <mine|train|calibrate|eval|bench-eval|package|run-all> --config config.json")
}
