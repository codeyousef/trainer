import config.{TrainerConfig}
import capabilities.{trainerTrainingMode}
import base_update.{writeDirectBaseWeightUpdateArtifact}
import embedding_delta.{miniLMEmbeddingDeltasPath}
import encoder.{Encoder}
import io_utils.{writeAtomicText}
import jsonl.{TripletExample, readTripletsLimited}
import math_utils.{cosine, relu, deterministicShuffleIndices, normalize}
import parameter_registry.{MiniLMParameterRegistry, writeMiniLMParameterRegistry}

class TrainResult {
    var examples: Int
    var epochs: Int
    var finalLoss: Float
    var outputPath: String

    static fun new(examples: Int, epochs: Int, finalLoss: Float, outputPath: String) r: TrainResult {
        return TrainResult{ examples: examples, epochs: epochs, finalLoss: finalLoss, outputPath: outputPath }
    }
}

fun trainEncoder(cfg: TrainerConfig, encoder: Encoder, parameterRegistry: MiniLMParameterRegistry) r: TrainResult {
    let trainPath = if cfg.minedJsonlPath.length() > 0 { cfg.minedJsonlPath } else { cfg.trainJsonlPath }
    let items = readTripletsLimited(trainPath, cfg.maxTrainTriplets)
    let trainableItems = countTrainableTriplets(items)
    let batchSize = effectiveBatchSize(cfg.batchSize, items.length())
    let batches = batchesPerEpoch(items.length(), batchSize)
    let examplesPerEpoch = batches * batchSize
    var finalLoss = 0.0
    var epoch = 0
    if trainableItems <= 0 and items.length() > 0 {
        println("trainer: no trainable triplets with hard negatives; skipping epochs")
    }
    if trainableItems <= 0 {
        let path = cfg.outputModelDir + "/training_config.json"
        let trainingJson = trainingConfigJson(cfg, items.length(), finalLoss, batchSize, batches, examplesPerEpoch, encoder.modelEmbeddings.layers)
        writeAtomicText(path, trainingJson)
        writeMiniLMParameterRegistry(cfg.outputModelDir + "/minilm_parameter_registry.json", parameterRegistry)
        return TrainResult.new(items.length(), 0, finalLoss, path)
    }
    while epoch < cfg.epochs and trainableItems > 0 {
        let order = deterministicShuffleIndices(items.length(), cfg.seed + epoch)
        var lossSum = 0.0
        var count = 0
        var batch = 0
        while batch < batches {
            var batchLoss = 0.0
            var inBatch = 0
            var offset = 0
            while offset < batchSize {
                let orderIndex = batch * batchSize + offset
                let item = items[order[orderIndex]]
                let loss = trainAdapterTriplet(item, encoder, parameterRegistry, cfg)
                batchLoss = batchLoss + loss
                inBatch = inBatch + 1
                offset = offset + 1
            }
            if inBatch > 0 {
                lossSum = lossSum + batchLoss / inBatch.toFloat()
                count = count + 1
            }
            batch = batch + 1
        }
        if count > 0 {
            finalLoss = lossSum / count.toFloat()
        }
        println("trainer: epoch " + (epoch + 1).toString() + " loss " + finalLoss.toString())
        epoch = epoch + 1
    }
    if cfg.trainMiniLMDeltas and encoder.hasMiniLMDenseAdapterTarget() and finalLoss > 0.0 {
        if encoder.hasMiniLMAllLayerDeltaTarget() {
            encoder.minilmLayerDeltas.saveAll(cfg.outputModelDir)
        }
        if encoder.hasMiniLMEmbeddingDeltaTarget() {
            encoder.minilmEmbeddingDeltas.save(miniLMEmbeddingDeltasPath(cfg.outputModelDir))
        }
        encoder.minilmDenseAdapter.save(cfg.minilmDenseAdapterPath())
        encoder.minilmDenseDelta.save(cfg.minilmDenseDeltaPath())
        encoder.minilmIntermediateDelta.saveIntermediate(cfg.minilmIntermediateDeltaPath())
        encoder.minilmQueryDelta.saveAs(cfg.minilmQueryDeltaPath(), "seen-minilm-attention-query-delta-v1")
        encoder.minilmKeyDelta.saveAs(cfg.minilmKeyDeltaPath(), "seen-minilm-attention-key-delta-v1")
        encoder.minilmValueDelta.saveAs(cfg.minilmValueDeltaPath(), "seen-minilm-attention-value-delta-v1")
        encoder.minilmAttentionDenseDelta.saveAs(cfg.minilmAttentionDenseDeltaPath(), "seen-minilm-attention-output-dense-delta-v1")
        encoder.minilmAttentionLayerNormDelta.saveAttentionOutput(cfg.minilmAttentionLayerNormDeltaPath())
        encoder.minilmLayerNormDelta.save(cfg.minilmLayerNormDeltaPath())
        if cfg.copyBaseArtifacts {
            let baseUpdate = writeDirectBaseWeightUpdateArtifact(cfg, encoder.modelEmbeddings.layers, encoder.embeddingDim, encoder.modelEmbeddings.intermediateSize)
            if baseUpdate.anyMaterialized() {
                println("trainer: flushed " + baseUpdate.totalSurfaces.toString() + " trained surfaces into " + baseUpdate.outputPath)
            }
        }
    }
    encoder.minilmLayerAdapter.save(cfg.minilmLayerAdapterPath())
    encoder.layerAdapter.save(cfg.layerAdapterPath())
    encoder.adapter.save(cfg.adapterPath())
    let path = cfg.outputModelDir + "/training_config.json"
    let trainingJson = trainingConfigJson(cfg, items.length(), finalLoss, batchSize, batches, examplesPerEpoch, encoder.modelEmbeddings.layers)
    writeAtomicText(path, trainingJson)
    writeMiniLMParameterRegistry(cfg.outputModelDir + "/minilm_parameter_registry.json", parameterRegistry)
    return TrainResult.new(items.length(), cfg.epochs, finalLoss, path)
}

fun countTrainableTriplets(items: Array<TripletExample>) r: Int {
    var count = 0
    var i = 0
    while i < items.length() {
        if items[i].hardNegativeChunkText.length() > 0 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

fun effectiveBatchSize(requested: Int, itemCount: Int) r: Int {
    var batch = requested
    if batch <= 0 {
        batch = 1
    }
    if itemCount > 0 and batch > itemCount {
        return itemCount
    }
    return batch
}

fun batchesPerEpoch(itemCount: Int, batchSize: Int) r: Int {
    if itemCount <= 0 or batchSize <= 0 {
        return 0
    }
    return itemCount / batchSize
}

fun trainAdapterTriplet(item: TripletExample, encoder: Encoder, parameterRegistry: MiniLMParameterRegistry, cfg: TrainerConfig) r: Float {
    if item.hardNegativeChunkText.length() == 0 {
        return 0.0
    }
    var denseLoss = 0.0
    if cfg.trainMiniLMDeltas and encoder.hasMiniLMDenseAdapterTarget() {
        denseLoss = encoder.updateMiniLMDenseAdapterTriplet(item.queryText, item.positiveChunkText, item.hardNegativeChunkText, parameterRegistry, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    }
    var minilmLoss = 0.0
    var miniMeanQ = Array<Float>()
    var miniMeanP = Array<Float>()
    var miniMeanN = Array<Float>()
    if encoder.hasMiniLMLayerAdapterTarget() {
        miniMeanQ = encoder.encodeMiniLMLayerMean(item.queryText)
        miniMeanP = encoder.encodeMiniLMLayerMean(item.positiveChunkText)
        miniMeanN = encoder.encodeMiniLMLayerMean(item.hardNegativeChunkText)
        let miniQ = normalize(miniMeanQ)
        let miniP = normalize(miniMeanP)
        let miniN = normalize(miniMeanN)
        if miniQ.length() == encoder.embeddingDim and miniP.length() == encoder.embeddingDim and miniN.length() == encoder.embeddingDim {
            minilmLoss = encoder.minilmLayerAdapter.updateTriplet(miniQ, miniP, miniN, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
        }
    }
    var rawMeanQ = miniMeanQ
    var rawMeanP = miniMeanP
    var rawMeanN = miniMeanN
    if cfg.trainMiniLMDeltas or rawMeanQ.length() != encoder.embeddingDim {
        rawMeanQ = encoder.encodeRawMean(item.queryText)
    }
    if cfg.trainMiniLMDeltas or rawMeanP.length() != encoder.embeddingDim {
        rawMeanP = encoder.encodeRawMean(item.positiveChunkText)
    }
    if cfg.trainMiniLMDeltas or rawMeanN.length() != encoder.embeddingDim {
        rawMeanN = encoder.encodeRawMean(item.hardNegativeChunkText)
    }
    let rawQ = normalize(rawMeanQ)
    let rawP = normalize(rawMeanP)
    let rawN = normalize(rawMeanN)
    let layerLoss = encoder.layerAdapter.updateTriplet(rawQ, rawP, rawN, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    let q = normalize(encoder.layerAdapter.apply(rawMeanQ))
    let p = normalize(encoder.layerAdapter.apply(rawMeanP))
    let n = normalize(encoder.layerAdapter.apply(rawMeanN))
    let adapterLoss = encoder.adapter.updateTriplet(q, p, n, cfg.margin, cfg.learningRate, cfg.weightDecay, cfg.gradClip)
    return denseLoss + minilmLoss + layerLoss + adapterLoss
}

fun tripletLoss(item: TripletExample, encoder: Encoder, margin: Float) r: Float {
    if item.hardNegativeChunkText.length() == 0 {
        return 0.0
    }
    let q = encoder.encode(item.queryText)
    let p = encoder.encode(item.positiveChunkText)
    let n = encoder.encode(item.hardNegativeChunkText)
    let simPos = cosine(q, p)
    let simNeg = cosine(q, n)
    return relu(simNeg - simPos + margin)
}

fun trainingConfigJson(cfg: TrainerConfig, count: Int, loss: Float, effectiveBatch: Int, batches: Int, examplesPerEpoch: Int, runtimeLayers: Int) r: String {
    let dropped = count - examplesPerEpoch
    return "{\n"
        + "  \"trainer\": \"seen-native\",\n"
        + "  \"training_mode\": \"" + trainerTrainingMode() + "\",\n"
        + "  \"pooling\": \"mean\",\n"
        + "  \"backend\": \"" + cfg.backend + "\",\n"
        + "  \"resume_output_artifacts\": " + cfg.resumeOutputArtifacts.toString() + ",\n"
        + "  \"train_minilm_deltas\": " + cfg.trainMiniLMDeltas.toString() + ",\n"
        + "  \"examples\": " + count.toString() + ",\n"
        + "  \"max_train_triplets\": " + cfg.maxTrainTriplets.toString() + ",\n"
        + "  \"bounded_training_dataset\": " + (cfg.maxTrainTriplets > 0).toString() + ",\n"
        + "  \"examples_per_epoch\": " + examplesPerEpoch.toString() + ",\n"
        + "  \"dropped_examples_per_epoch\": " + dropped.toString() + ",\n"
        + "  \"batches_per_epoch\": " + batches.toString() + ",\n"
        + "  \"epochs\": " + cfg.epochs.toString() + ",\n"
        + "  \"effective_batch_size\": " + effectiveBatch.toString() + ",\n"
        + "  \"effective_minilm_layers\": " + runtimeLayers.toString() + ",\n"
        + "  \"capabilities_artifact\": \"" + cfg.outputModelDir + "/seen_trainer_capabilities.json\",\n"
        + "  \"final_loss\": " + loss.toString() + "\n"
        + "}\n"
}
