import io.file.{readText, writeText, appendText, ensureParentDirectories}
import str.string.{split, trim}

fun readLines(path: String) r: Array<String> {
    let content = readText(path)
    let raw = split(content, "\n")
    let lines = Array<String>()
    var i = 0
    while i < raw.length() {
        let line = trim(raw[i])
        if line.length() > 0 {
            lines.push(line)
        }
        i = i + 1
    }
    return lines
}

fun writeAtomicText(path: String, content: String) r: Bool {
    ensureParentDirectories(path)
    return writeText(path, content)
}

fun appendLine(path: String, line: String) r: Bool {
    ensureParentDirectories(path)
    return appendText(path, line + "\n")
}

fun pathJoin(base: String, leaf: String) r: String {
    if base.length() == 0 {
        return leaf
    }
    if base.substring(base.length() - 1, base.length()) == "/" {
        return base + leaf
    }
    return base + "/" + leaf
}
