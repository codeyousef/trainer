import calibration.{DomainThreshold, calibrateThresholds, holdoutSplit, loadThresholds, readCalibrationDataset, thresholdFor}
import config.{TrainerConfig}
import encoder.{Encoder}
import io.file.{exists}
import io_utils.{writeAtomicText}
import json.builder.{escapeJsonString}
import jsonl.{TripletExample, readTripletsLimited}
import memory.allocation.{releaseFloatArrayStorage, releaseIntArrayStorage}

class EvalResult {
    var total: Int
    var answered: Int
    var answerRate: Float
    var outputPath: String
    var uniqueTexts: Int
    var readDatasetMs: Float
    var tokenizeMs: Float
    var encodeMs: Float
    var scoreThresholdMs: Float
    var resultWriteMs: Float
    var totalEvalMs: Float

    static fun new(total: Int, answered: Int, answerRate: Float, outputPath: String) r: EvalResult {
        return EvalResult{ total: total, answered: answered, answerRate: answerRate, outputPath: outputPath, uniqueTexts: 0, readDatasetMs: 0.0, tokenizeMs: 0.0, encodeMs: 0.0, scoreThresholdMs: 0.0, resultWriteMs: 0.0, totalEvalMs: 0.0 }
    }
}

class EvalTiming {
    var readDatasetMs: Float
    var tokenizeMs: Float
    var encodeMs: Float
    var scoreThresholdMs: Float
    var totalBeforeWriteMs: Float

    static fun new() r: EvalTiming {
        return EvalTiming{ readDatasetMs: 0.0, tokenizeMs: 0.0, encodeMs: 0.0, scoreThresholdMs: 0.0, totalBeforeWriteMs: 0.0 }
    }
}

class EvalEmbeddingCache {
    var texts: Array<String>
    var embeddings: Array<Float>
    var dim: Int

    static fun new(dim: Int) r: EvalEmbeddingCache {
        return EvalEmbeddingCache{ texts: Array<String>(), embeddings: Array<Float>(), dim: dim }
    }

    fun ensure(encoder: Encoder, text: String, timing: EvalTiming) r: Int {
        var i = 0
        while i < this.texts.length() {
            if this.texts[i] == text {
                return i
            }
            i = i + 1
        }
        let tokenizeStart = __GetTime()
        let tokenized = encoder.tokenizer.tokenized(text)
        timing.tokenizeMs = timing.tokenizeMs + evalElapsedMillis(tokenizeStart)
        let encodeStart = __GetTime()
        let embedding = encoder.encodeTokenized(tokenized.ids, tokenized.masks)
        timing.encodeMs = timing.encodeMs + evalElapsedMillis(encodeStart)
        releaseIntArrayStorage(tokenized.ids)
        releaseIntArrayStorage(tokenized.masks)
        this.texts.push(text)
        var d = 0
        while d < this.dim {
            if d < embedding.length() {
                this.embeddings.push(embedding[d])
            } else {
                this.embeddings.push(0.0)
            }
            d = d + 1
        }
        releaseFloatArrayStorage(embedding)
        return this.texts.length() - 1
    }

    fun dotAt(left: Int, right: Int) r: Float {
        var sum = 0.0
        var d = 0
        let leftBase = left * this.dim
        let rightBase = right * this.dim
        while d < this.dim {
            let li = leftBase + d
            let ri = rightBase + d
            if li < this.embeddings.length() and ri < this.embeddings.length() {
                sum = sum + this.embeddings[li] * this.embeddings[ri]
            }
            d = d + 1
        }
        return sum
    }

    fun score(encoder: Encoder, qText: String, pText: String, timing: EvalTiming) r: Float {
        let qIndex = this.ensure(encoder, qText, timing)
        let pIndex = this.ensure(encoder, pText, timing)
        return this.dotAt(qIndex, pIndex)
    }

    fun release() r: Void {
        releaseFloatArrayStorage(this.embeddings)
    }
}

fun evaluate(cfg: TrainerConfig, encoder: Encoder, thresholds: Array<DomainThreshold>) r: EvalResult {
    let evalStart = __GetTime()
    let timing = EvalTiming.new()
    let readStart = __GetTime()
    let items = readEvalDataset(cfg)
    timing.readDatasetMs = evalElapsedMillis(readStart)
    let domains = uniqueEvalDomains(items)
    let totals = evalInitializedIntArray(domains.length(), 0)
    let answeredTotals = evalInitializedIntArray(domains.length(), 0)
    let cache = EvalEmbeddingCache.new(encoder.embeddingDim)
    var total = 0
    var answered = 0
    var i = 0
    while i < items.length() {
        let domain = if items[i].domain.length() > 0 { items[i].domain } else { "default" }
        let threshold = thresholdFor(thresholds, domain)
        let qIndex = cache.ensure(encoder, items[i].queryText, timing)
        let pIndex = cache.ensure(encoder, items[i].positiveChunkText, timing)
        let scoreStart = __GetTime()
        let score = cache.dotAt(qIndex, pIndex)
        let domainIndex = findDomainIndex(domains, domain)
        if domainIndex >= 0 {
            totals[domainIndex] = totals[domainIndex] + 1
        }
        if score >= threshold {
            answered = answered + 1
            if domainIndex >= 0 {
                answeredTotals[domainIndex] = answeredTotals[domainIndex] + 1
            }
        }
        total = total + 1
        timing.scoreThresholdMs = timing.scoreThresholdMs + evalElapsedMillis(scoreStart)
        i = i + 1
    }
    let uniqueTexts = cache.texts.length()
    var rate = 0.0
    if total > 0 {
        rate = answered.toFloat() / total.toFloat()
    }
    timing.totalBeforeWriteMs = evalElapsedMillis(evalStart)
    let outputJson = evalJson(cfg, total, answered, rate, domains, totals, answeredTotals, timing, uniqueTexts)
    let writeStart = __GetTime()
    writeAtomicText(cfg.evalResultsPath, outputJson)
    let writeMs = evalElapsedMillis(writeStart)
    let totalMs = evalElapsedMillis(evalStart)
    cache.release()
    let result = EvalResult.new(total, answered, rate, cfg.evalResultsPath)
    result.uniqueTexts = uniqueTexts
    result.readDatasetMs = timing.readDatasetMs
    result.tokenizeMs = timing.tokenizeMs
    result.encodeMs = timing.encodeMs
    result.scoreThresholdMs = timing.scoreThresholdMs
    result.resultWriteMs = writeMs
    result.totalEvalMs = totalMs
    return result
}

fun readEvalDataset(cfg: TrainerConfig) r: Array<TripletExample> {
    if cfg.testJsonlPath.length() > 0 and exists(cfg.testJsonlPath) {
        return readTripletsLimited(cfg.testJsonlPath, cfg.maxEvalTriplets)
    }
    let heldOut = holdoutSplit(readCalibrationDataset(cfg), cfg.seed)
    return limitTriplets(heldOut, cfg.maxEvalTriplets)
}

fun evalWithCalibration(cfg: TrainerConfig, encoder: Encoder) r: EvalResult {
    let loadedThresholds = loadThresholds(cfg.thresholdsPath)
    if loadedThresholds.length() > 0 {
        return evaluate(cfg, encoder, loadedThresholds)
    }
    let thresholds = calibrateThresholds(cfg, encoder)
    return evaluate(cfg, encoder, thresholds)
}

fun evalJson(cfg: TrainerConfig, total: Int, answered: Int, rate: Float, domains: Array<String>, totals: Array<Int>, answeredTotals: Array<Int>, timing: EvalTiming, uniqueTexts: Int) r: String {
    return "{\n"
        + "  \"total\": " + total.toString() + ",\n"
        + "  \"answered\": " + answered.toString() + ",\n"
        + "  \"answer_rate\": " + rate.toString() + ",\n"
        + "  \"max_eval_triplets\": " + cfg.maxEvalTriplets.toString() + ",\n"
        + "  \"bounded_eval_dataset\": " + (cfg.maxEvalTriplets > 0).toString() + ",\n"
        + "  \"pass_overall_88\": " + boolJson(rate >= 0.88) + ",\n"
        + "  \"per_domain\": " + perDomainJson(domains, totals, answeredTotals) + ",\n"
        + "  \"timing_ms\": " + evalTimingJson(timing, uniqueTexts) + "\n"
        + "}\n"
}

fun evalTimingJson(timing: EvalTiming, uniqueTexts: Int) r: String {
    return "{"
        + "\"read_dataset\": " + timing.readDatasetMs.toString() + ", "
        + "\"tokenize\": " + timing.tokenizeMs.toString() + ", "
        + "\"encode\": " + timing.encodeMs.toString() + ", "
        + "\"score_threshold\": " + timing.scoreThresholdMs.toString() + ", "
        + "\"total_before_write\": " + timing.totalBeforeWriteMs.toString() + ", "
        + "\"unique_texts\": " + uniqueTexts.toString()
        + "}"
}

fun evalElapsedMillis(startSeconds: Float) r: Float {
    return (__GetTime() - startSeconds) * 1000.0
}

fun limitTriplets(items: Array<TripletExample>, maxItems: Int) r: Array<TripletExample> {
    if maxItems <= 0 or items.length() <= maxItems {
        return items
    }
    let out = Array<TripletExample>()
    var i = 0
    while i < items.length() and i < maxItems {
        out.push(items[i])
        i = i + 1
    }
    return out
}

fun perDomainJson(domains: Array<String>, totals: Array<Int>, answeredTotals: Array<Int>) r: String {
    var out = "{\n"
    var i = 0
    while i < domains.length() {
        var rate = 0.0
        if totals[i] > 0 {
            rate = answeredTotals[i].toFloat() / totals[i].toFloat()
        }
        out = out + "    " + escapeJsonString(domains[i]) + ": {"
            + "\"total\": " + totals[i].toString() + ", "
            + "\"answered\": " + answeredTotals[i].toString() + ", "
            + "\"answer_rate\": " + rate.toString() + ", "
            + "\"pass_domain_90\": " + boolJson(rate >= 0.9) + "}"
        if i + 1 < domains.length() {
            out = out + ","
        }
        out = out + "\n"
        i = i + 1
    }
    out = out + "  }"
    return out
}

fun boolJson(value: Bool) r: String {
    if value {
        return "true"
    }
    return "false"
}

fun uniqueEvalDomains(items: Array<TripletExample>) r: Array<String> {
    let domains = Array<String>()
    var i = 0
    while i < items.length() {
        let domain = if items[i].domain.length() > 0 { items[i].domain } else { "default" }
        var seen = false
        var j = 0
        while j < domains.length() {
            if domains[j] == domain {
                seen = true
            }
            j = j + 1
        }
        if not seen {
            domains.push(domain)
        }
        i = i + 1
    }
    return domains
}

fun findDomainIndex(domains: Array<String>, domain: String) r: Int {
    var i = 0
    while i < domains.length() {
        if domains[i] == domain {
            return i
        }
        i = i + 1
    }
    return -1
}

fun evalInitializedIntArray(count: Int, value: Int) r: Array<Int> {
    let out = Array<Int>()
    var i = 0
    while i < count {
        out.push(value)
        i = i + 1
    }
    return out
}
