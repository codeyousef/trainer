class EmbeddingTensorLoad {
    var ok: Bool
    var rows: Int
    var cols: Int
    var rowIds: Array<Int>
    var values: Array<Float>
    var error: String

    static fun success(rows: Int, cols: Int, values: Array<Float>) r: EmbeddingTensorLoad {
        return EmbeddingTensorLoad{ ok: true, rows: rows, cols: cols, rowIds: Array<Int>(), values: values, error: "" }
    }

    static fun sparse(rows: Int, cols: Int, rowIds: Array<Int>, values: Array<Float>) r: EmbeddingTensorLoad {
        return EmbeddingTensorLoad{ ok: true, rows: rows, cols: cols, rowIds: rowIds, values: values, error: "" }
    }

    static fun failure(error: String) r: EmbeddingTensorLoad {
        return EmbeddingTensorLoad{ ok: false, rows: 0, cols: 0, rowIds: Array<Int>(), values: Array<Float>(), error: error }
    }

    fun valueAt(row: Int, col: Int) r: Float {
        if row < 0 or row >= this.rows or col < 0 or col >= this.cols {
            return 0.0
        }
        if this.rowIds.length() == 0 {
            let denseIndex = row * this.cols + col
            if denseIndex >= 0 and denseIndex < this.values.length() {
                return this.values[denseIndex]
            }
            return 0.0
        }
        var slot = 0
        while slot < this.rowIds.length() {
            if this.rowIds[slot] == row {
                let sparseIndex = slot * this.cols + col
                if sparseIndex >= 0 and sparseIndex < this.values.length() {
                    return this.values[sparseIndex]
                }
                return 0.0
            }
            slot = slot + 1
        }
        return 0.0
    }
}

class MiniLMEncoderLayerCache {
    var ok: Bool
    var layer: Int
    var qWeight: EmbeddingTensorLoad
    var qBias: EmbeddingTensorLoad
    var kWeight: EmbeddingTensorLoad
    var kBias: EmbeddingTensorLoad
    var vWeight: EmbeddingTensorLoad
    var vBias: EmbeddingTensorLoad
    var attentionOutputWeight: EmbeddingTensorLoad
    var attentionOutputBias: EmbeddingTensorLoad
    var attentionNormWeight: EmbeddingTensorLoad
    var attentionNormBias: EmbeddingTensorLoad
    var intermediateWeight: EmbeddingTensorLoad
    var intermediateBias: EmbeddingTensorLoad
    var outputWeight: EmbeddingTensorLoad
    var outputBias: EmbeddingTensorLoad
    var outputNormWeight: EmbeddingTensorLoad
    var outputNormBias: EmbeddingTensorLoad
    var error: String

    static fun empty() r: MiniLMEncoderLayerCache {
        return MiniLMEncoderLayerCache.emptyWithError("")
    }

    static fun emptyWithError(error: String) r: MiniLMEncoderLayerCache {
        let emptyTensor = EmbeddingTensorLoad.failure(error)
        return MiniLMEncoderLayerCache{
            ok: false,
            layer: -1,
            qWeight: emptyTensor,
            qBias: emptyTensor,
            kWeight: emptyTensor,
            kBias: emptyTensor,
            vWeight: emptyTensor,
            vBias: emptyTensor,
            attentionOutputWeight: emptyTensor,
            attentionOutputBias: emptyTensor,
            attentionNormWeight: emptyTensor,
            attentionNormBias: emptyTensor,
            intermediateWeight: emptyTensor,
            intermediateBias: emptyTensor,
            outputWeight: emptyTensor,
            outputBias: emptyTensor,
            outputNormWeight: emptyTensor,
            outputNormBias: emptyTensor,
            error: error
        }
    }

    static fun load(info: SafeTensorInfo, layer: Int, maxLoadElements: Int) r: MiniLMEncoderLayerCache {
        let prefix = "encoder.layer." + layer.toString() + "."
        let qWeight = loadEmbeddingTensor(info, prefix + "attention.self.query.weight", maxLoadElements)
        let qBias = loadEmbeddingTensor(info, prefix + "attention.self.query.bias", maxLoadElements)
        let kWeight = loadEmbeddingTensor(info, prefix + "attention.self.key.weight", maxLoadElements)
        let kBias = loadEmbeddingTensor(info, prefix + "attention.self.key.bias", maxLoadElements)
        let vWeight = loadEmbeddingTensor(info, prefix + "attention.self.value.weight", maxLoadElements)
        let vBias = loadEmbeddingTensor(info, prefix + "attention.self.value.bias", maxLoadElements)
        let attentionOutputWeight = loadEmbeddingTensor(info, prefix + "attention.output.dense.weight", maxLoadElements)
        let attentionOutputBias = loadEmbeddingTensor(info, prefix + "attention.output.dense.bias", maxLoadElements)
        let attentionNormWeight = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.weight", maxLoadElements)
        let attentionNormBias = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.bias", maxLoadElements)
        let intermediateWeight = loadEmbeddingTensor(info, prefix + "intermediate.dense.weight", maxLoadElements)
        let intermediateBias = loadEmbeddingTensor(info, prefix + "intermediate.dense.bias", maxLoadElements)
        let outputWeight = loadEmbeddingTensor(info, prefix + "output.dense.weight", maxLoadElements)
        let outputBias = loadEmbeddingTensor(info, prefix + "output.dense.bias", maxLoadElements)
        let outputNormWeight = loadEmbeddingTensor(info, prefix + "output.LayerNorm.weight", maxLoadElements)
        let outputNormBias = loadEmbeddingTensor(info, prefix + "output.LayerNorm.bias", maxLoadElements)
        if not qWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(qWeight.error) }
        if not qBias.ok { return MiniLMEncoderLayerCache.emptyWithError(qBias.error) }
        if not kWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(kWeight.error) }
        if not kBias.ok { return MiniLMEncoderLayerCache.emptyWithError(kBias.error) }
        if not vWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(vWeight.error) }
        if not vBias.ok { return MiniLMEncoderLayerCache.emptyWithError(vBias.error) }
        if not attentionOutputWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(attentionOutputWeight.error) }
        if not attentionOutputBias.ok { return MiniLMEncoderLayerCache.emptyWithError(attentionOutputBias.error) }
        if not attentionNormWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(attentionNormWeight.error) }
        if not attentionNormBias.ok { return MiniLMEncoderLayerCache.emptyWithError(attentionNormBias.error) }
        if not intermediateWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(intermediateWeight.error) }
        if not intermediateBias.ok { return MiniLMEncoderLayerCache.emptyWithError(intermediateBias.error) }
        if not outputWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(outputWeight.error) }
        if not outputBias.ok { return MiniLMEncoderLayerCache.emptyWithError(outputBias.error) }
        if not outputNormWeight.ok { return MiniLMEncoderLayerCache.emptyWithError(outputNormWeight.error) }
        if not outputNormBias.ok { return MiniLMEncoderLayerCache.emptyWithError(outputNormBias.error) }
        return MiniLMEncoderLayerCache{
            ok: true,
            layer: layer,
            qWeight: qWeight,
            qBias: qBias,
            kWeight: kWeight,
            kBias: kBias,
            vWeight: vWeight,
            vBias: vBias,
            attentionOutputWeight: attentionOutputWeight,
            attentionOutputBias: attentionOutputBias,
            attentionNormWeight: attentionNormWeight,
            attentionNormBias: attentionNormBias,
            intermediateWeight: intermediateWeight,
            intermediateBias: intermediateBias,
            outputWeight: outputWeight,
            outputBias: outputBias,
            outputNormWeight: outputNormWeight,
            outputNormBias: outputNormBias,
            error: ""
        }
    }
}

fun releaseEmbeddingTensorLoadStorage(tensor: EmbeddingTensorLoad) r: Void {
    releaseFloatArrayStorage(tensor.values)
    releaseIntArrayStorage(tensor.rowIds)
}

fun releaseMiniLMEncoderLayerCacheStorage(cache: MiniLMEncoderLayerCache) r: Void {
    if not cache.ok {
        return
    }
    releaseEmbeddingTensorLoadStorage(cache.qWeight)
    releaseEmbeddingTensorLoadStorage(cache.qBias)
    releaseEmbeddingTensorLoadStorage(cache.kWeight)
    releaseEmbeddingTensorLoadStorage(cache.kBias)
    releaseEmbeddingTensorLoadStorage(cache.vWeight)
    releaseEmbeddingTensorLoadStorage(cache.vBias)
    releaseEmbeddingTensorLoadStorage(cache.attentionOutputWeight)
    releaseEmbeddingTensorLoadStorage(cache.attentionOutputBias)
    releaseEmbeddingTensorLoadStorage(cache.attentionNormWeight)
    releaseEmbeddingTensorLoadStorage(cache.attentionNormBias)
    releaseEmbeddingTensorLoadStorage(cache.intermediateWeight)
    releaseEmbeddingTensorLoadStorage(cache.intermediateBias)
    releaseEmbeddingTensorLoadStorage(cache.outputWeight)
    releaseEmbeddingTensorLoadStorage(cache.outputBias)
    releaseEmbeddingTensorLoadStorage(cache.outputNormWeight)
    releaseEmbeddingTensorLoadStorage(cache.outputNormBias)
}

class MiniLMForwardCache {
    var ok: Bool
    var embeddingsOk: Bool
    var requestedLayers: Int
    var cachedLayers: Int
    var word: EmbeddingTensorLoad
    var position: EmbeddingTensorLoad
    var tokenType: EmbeddingTensorLoad
    var normWeight: EmbeddingTensorLoad
    var normBias: EmbeddingTensorLoad
    var layers: Array<MiniLMEncoderLayerCache>
    var error: String

    static fun empty() r: MiniLMForwardCache {
        return MiniLMForwardCache.emptyWithError("")
    }

    static fun emptyWithError(error: String) r: MiniLMForwardCache {
        let emptyTensor = EmbeddingTensorLoad.failure(error)
        return MiniLMForwardCache{
            ok: false,
            embeddingsOk: false,
            requestedLayers: 0,
            cachedLayers: 0,
            word: emptyTensor,
            position: emptyTensor,
            tokenType: emptyTensor,
            normWeight: emptyTensor,
            normBias: emptyTensor,
            layers: Array<MiniLMEncoderLayerCache>(),
            error: error
        }
    }

    static fun load(info: SafeTensorInfo, readyLayers: Int, maxLoadElements: Int) r: MiniLMForwardCache {
        let word = loadEmbeddingTensorMetadata(info, "embeddings.word_embeddings.weight", maxLoadElements)
        if not word.ok { return MiniLMForwardCache.emptyWithError(word.error) }
        let position = loadEmbeddingTensor(info, "embeddings.position_embeddings.weight", maxLoadElements)
        if not position.ok { return MiniLMForwardCache.emptyWithError(position.error) }
        let tokenType = loadEmbeddingTensor(info, "embeddings.token_type_embeddings.weight", maxLoadElements)
        if not tokenType.ok { return MiniLMForwardCache.emptyWithError(tokenType.error) }
        let normWeight = loadEmbeddingTensor(info, "embeddings.LayerNorm.weight", maxLoadElements)
        if not normWeight.ok { return MiniLMForwardCache.emptyWithError(normWeight.error) }
        let normBias = loadEmbeddingTensor(info, "embeddings.LayerNorm.bias", maxLoadElements)
        if not normBias.ok { return MiniLMForwardCache.emptyWithError(normBias.error) }

        let cached = Array<MiniLMEncoderLayerCache>()
        var layer = 0
        while layer < readyLayers {
            let layerCache = MiniLMEncoderLayerCache.load(info, layer, maxLoadElements)
            if not layerCache.ok {
                return MiniLMForwardCache{
                    ok: false,
                    embeddingsOk: true,
                    requestedLayers: readyLayers,
                    cachedLayers: cached.length(),
                    word: word,
                    position: position,
                    tokenType: tokenType,
                    normWeight: normWeight,
                    normBias: normBias,
                    layers: cached,
                    error: layerCache.error
                }
            }
            cached.push(layerCache)
            layer = layer + 1
        }
        return MiniLMForwardCache{
            ok: true,
            embeddingsOk: true,
            requestedLayers: readyLayers,
            cachedLayers: cached.length(),
            word: word,
            position: position,
            tokenType: tokenType,
            normWeight: normWeight,
            normBias: normBias,
            layers: cached,
            error: ""
        }
    }

    static fun loadEmbeddingsOnly(info: SafeTensorInfo, readyLayers: Int, maxLoadElements: Int) r: MiniLMForwardCache {
        let word = loadEmbeddingTensorMetadata(info, "embeddings.word_embeddings.weight", maxLoadElements)
        if not word.ok { return MiniLMForwardCache.emptyWithError(word.error) }
        let position = loadEmbeddingTensor(info, "embeddings.position_embeddings.weight", maxLoadElements)
        if not position.ok { return MiniLMForwardCache.emptyWithError(position.error) }
        let tokenType = loadEmbeddingTensor(info, "embeddings.token_type_embeddings.weight", maxLoadElements)
        if not tokenType.ok { return MiniLMForwardCache.emptyWithError(tokenType.error) }
        let normWeight = loadEmbeddingTensor(info, "embeddings.LayerNorm.weight", maxLoadElements)
        if not normWeight.ok { return MiniLMForwardCache.emptyWithError(normWeight.error) }
        let normBias = loadEmbeddingTensor(info, "embeddings.LayerNorm.bias", maxLoadElements)
        if not normBias.ok { return MiniLMForwardCache.emptyWithError(normBias.error) }

        return MiniLMForwardCache{
            ok: true,
            embeddingsOk: true,
            requestedLayers: readyLayers,
            cachedLayers: 0,
            word: word,
            position: position,
            tokenType: tokenType,
            normWeight: normWeight,
            normBias: normBias,
            layers: Array<MiniLMEncoderLayerCache>(),
            error: ""
        }
    }

    fun hasLayer(layer: Int) r: Bool {
        return this.ok and layer >= 0 and layer < this.layers.length() and this.layers[layer].ok
    }

    fun layerAt(layer: Int) r: MiniLMEncoderLayerCache {
        if this.hasLayer(layer) {
            return this.layers[layer]
        }
        return MiniLMEncoderLayerCache.empty()
    }
}

class MiniLMEmbeddings {
    var loaded: Bool
    var hiddenSize: Int
    var layers: Int
    var attentionHeads: Int
    var intermediateSize: Int
    var layer0Ready: Bool
    var readyLayers: Int
    var wordRows: Int
    var positionRows: Int
    var tokenTypeRows: Int
    var weightsPath: String
    var maxLoadElements: Int
    var backend: String
    var info: SafeTensorInfo
    var cache: MiniLMForwardCache
    var error: String

    static fun empty(hiddenSize: Int, error: String) r: MiniLMEmbeddings {
        return MiniLMEmbeddings.emptyWithBackend(hiddenSize, error, "cpu")
    }

    static fun emptyWithBackend(hiddenSize: Int, error: String, backend: String) r: MiniLMEmbeddings {
        return MiniLMEmbeddings{
            loaded: false,
            hiddenSize: hiddenSize,
            layers: 0,
            attentionHeads: 0,
            intermediateSize: 0,
            layer0Ready: false,
            readyLayers: 0,
            wordRows: 0,
            positionRows: 0,
            tokenTypeRows: 0,
            weightsPath: "",
            maxLoadElements: 0,
            backend: backend,
            info: SafeTensorInfo.empty("", false, 0, error),
            cache: MiniLMForwardCache.empty(),
            error: error
        }
    }

    static fun load(info: SafeTensorInfo, hiddenSize: Int, layers: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, backend: String, cacheTensors: Bool) r: MiniLMEmbeddings {
        if maxLoadElements <= 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "weight loading disabled by cap", backend)
        }
        if not info.validHeader {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "safetensors header is not valid", backend)
        }

        let word = validateEmbeddingTensor(info, "embeddings.word_embeddings.weight", maxLoadElements, hiddenSize, true)
        if word.length() > 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "word embeddings: " + word, backend)
        }
        let position = validateEmbeddingTensor(info, "embeddings.position_embeddings.weight", maxLoadElements, hiddenSize, true)
        if position.length() > 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "position embeddings: " + position, backend)
        }
        let tokenType = validateEmbeddingTensor(info, "embeddings.token_type_embeddings.weight", maxLoadElements, hiddenSize, true)
        if tokenType.length() > 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "token type embeddings: " + tokenType, backend)
        }
        let normWeight = validateEmbeddingTensor(info, "embeddings.LayerNorm.weight", maxLoadElements, hiddenSize, false)
        if normWeight.length() > 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "layer norm weight: " + normWeight, backend)
        }
        let normBias = validateEmbeddingTensor(info, "embeddings.LayerNorm.bias", maxLoadElements, hiddenSize, false)
        if normBias.length() > 0 {
            return MiniLMEmbeddings.emptyWithBackend(hiddenSize, "layer norm bias: " + normBias, backend)
        }

        var readyLayers = 0
        if layers > 0 {
            readyLayers = countReadyEncoderLayers(info, layers, maxLoadElements, hiddenSize, attentionHeads, intermediateSize)
        }
        var cache = MiniLMForwardCache.empty()
        if cacheTensors {
            cache = MiniLMForwardCache.loadEmbeddingsOnly(info, readyLayers, maxLoadElements)
        }

        return MiniLMEmbeddings{
            loaded: true,
            hiddenSize: hiddenSize,
            layers: layers,
            attentionHeads: attentionHeads,
            intermediateSize: intermediateSize,
            layer0Ready: readyLayers > 0,
            readyLayers: readyLayers,
            wordRows: embeddingTensorRows(info, "embeddings.word_embeddings.weight"),
            positionRows: embeddingTensorRows(info, "embeddings.position_embeddings.weight"),
            tokenTypeRows: embeddingTensorRows(info, "embeddings.token_type_embeddings.weight"),
            weightsPath: info.path,
            maxLoadElements: maxLoadElements,
            backend: backend,
            info: info,
            cache: cache,
            error: ""
        }
    }

    fun encodeMean(tokenIds: Array<Int>, mask: Array<Int>) r: Array<Float> {
        return this.encodeMeanWithAdapters(tokenIds, mask, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), LayerNormDeltaAdapter.identity(0), LayerNormDeltaAdapter.identity(0), -1, ProjectionAdapter.identity(this.hiddenSize), -1)
    }

    fun encodeMeanWithLayerAdapter(tokenIds: Array<Int>, mask: Array<Int>, layerAdapter: ProjectionAdapter, adapterLayer: Int) r: Array<Float> {
        return this.encodeMeanWithAdapters(tokenIds, mask, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), LayerNormDeltaAdapter.identity(0), LayerNormDeltaAdapter.identity(0), -1, layerAdapter, adapterLayer)
    }

    fun encodeMeanWithLayerDeltas(tokenIds: Array<Int>, mask: Array<Int>, layerDeltas: MiniLMLayerDeltas, embeddingDeltas: MiniLMEmbeddingDeltas, layerAdapter: ProjectionAdapter, adapterLayer: Int) r: Array<Float> {
        let info = this.info
        if not info.validHeader {
            return Array<Float>()
        }
        let word = wordEmbeddingTensorForTokens(this.cache, info, tokenIds, mask, this.maxLoadElements)
        if not word.ok {
            return Array<Float>()
        }
        let position = cachedEmbeddingTensor(this.cache, info, "embeddings.position_embeddings.weight", this.maxLoadElements)
        if not position.ok {
            return Array<Float>()
        }
        let tokenType = cachedEmbeddingTensor(this.cache, info, "embeddings.token_type_embeddings.weight", this.maxLoadElements)
        if not tokenType.ok {
            return Array<Float>()
        }
        let normWeight = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.weight", this.maxLoadElements)
        if not normWeight.ok {
            return Array<Float>()
        }
        let normBias = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.bias", this.maxLoadElements)
        if not normBias.ok {
            return Array<Float>()
        }

        let sequence = Array<Float>()
        var tokenCount = 0
        var i = 0
        while i < tokenIds.length() and i < mask.length() {
            if mask[i] == 1 {
                tokenCount = tokenCount + 1
                let embedded = encodeTokenWithEmbeddingDeltas(tokenIds[i], i, this.hiddenSize, word, position, tokenType, normWeight, normBias, embeddingDeltas)
                var d = 0
                while d < this.hiddenSize {
                    sequence.push(embedded[d])
                    d = d + 1
                }
                releaseFloatArrayStorage(embedded)
            }
            i = i + 1
        }

        if tokenCount == 0 {
            releaseFloatArrayStorage(sequence)
            return zerosFloat(this.hiddenSize)
        }

        var encoded = sequence
        let targetLayer = normalizeMiniLMLayerAdapterLayer(adapterLayer, this.readyLayers)
        var layer = 0
        while layer < this.readyLayers {
            var layerOut = Array<Float>()
            if layerDeltas.hasLayer(layer) {
                layerOut = applyEncoderLayerMaybeCached(this.cache, info, encoded, tokenCount, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, layer, DenseLoRAAdapter.identity(this.intermediateSize, this.hiddenSize), layerDeltas.outputDeltas[layer], layerDeltas.intermediateDeltas[layer], layerDeltas.queryDeltas[layer], layerDeltas.keyDeltas[layer], layerDeltas.valueDeltas[layer], layerDeltas.attentionDenseDeltas[layer], layerDeltas.attentionLayerNormDeltas[layer], layerDeltas.outputLayerNormDeltas[layer], true, this.backend)
            } else {
                layerOut = applyEncoderLayerMaybeCachedBase(this.cache, info, encoded, tokenCount, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, layer, this.backend)
            }
            if layerOut.length() == encoded.length() {
                let previous = encoded
                encoded = layerOut
                releaseFloatArrayStorage(previous)
                if layer == targetLayer {
                    let projected = applyProjectionAdapterToSequence(encoded, tokenCount, this.hiddenSize, layerAdapter)
                    releaseFloatArrayStorage(encoded)
                    encoded = projected
                }
            } else {
                releaseFloatArrayStorage(layerOut)
                layer = this.readyLayers
            }
            layer = layer + 1
        }
        let mean = meanPoolFlat(encoded, tokenCount, this.hiddenSize)
        releaseFloatArrayStorage(encoded)
        return mean
    }

    fun encodeMeanWithAdapters(tokenIds: Array<Int>, mask: Array<Int>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, denseAdapterLayer: Int, layerAdapter: ProjectionAdapter, adapterLayer: Int) r: Array<Float> {
        let info = this.info
        if not info.validHeader {
            return Array<Float>()
        }
        let word = wordEmbeddingTensorForTokens(this.cache, info, tokenIds, mask, this.maxLoadElements)
        if not word.ok {
            return Array<Float>()
        }
        let position = cachedEmbeddingTensor(this.cache, info, "embeddings.position_embeddings.weight", this.maxLoadElements)
        if not position.ok {
            return Array<Float>()
        }
        let tokenType = cachedEmbeddingTensor(this.cache, info, "embeddings.token_type_embeddings.weight", this.maxLoadElements)
        if not tokenType.ok {
            return Array<Float>()
        }
        let normWeight = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.weight", this.maxLoadElements)
        if not normWeight.ok {
            return Array<Float>()
        }
        let normBias = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.bias", this.maxLoadElements)
        if not normBias.ok {
            return Array<Float>()
        }

        let sequence = Array<Float>()
        var tokenCount = 0
        var i = 0
        while i < tokenIds.length() and i < mask.length() {
            if mask[i] == 1 {
                tokenCount = tokenCount + 1
                let embedded = encodeTokenWithTables(tokenIds[i], i, this.hiddenSize, word, position, tokenType, normWeight, normBias)
                var d = 0
                while d < this.hiddenSize {
                    sequence.push(embedded[d])
                    d = d + 1
                }
                releaseFloatArrayStorage(embedded)
            }
            i = i + 1
        }

        if tokenCount == 0 {
            releaseFloatArrayStorage(sequence)
            return zerosFloat(this.hiddenSize)
        }

        var encoded = sequence
        let targetLayer = normalizeMiniLMLayerAdapterLayer(adapterLayer, this.readyLayers)
        let denseTargetLayer = normalizeMiniLMDenseAdapterLayer(denseAdapterLayer, this.readyLayers)
        var layer = 0
        while layer < this.readyLayers {
            let layerOut = applyEncoderLayerMaybeCached(this.cache, info, encoded, tokenCount, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, layer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, layer == denseTargetLayer, this.backend)
            if layerOut.length() == encoded.length() {
                let previous = encoded
                encoded = layerOut
                releaseFloatArrayStorage(previous)
                if layer == targetLayer {
                    let projected = applyProjectionAdapterToSequence(encoded, tokenCount, this.hiddenSize, layerAdapter)
                    releaseFloatArrayStorage(encoded)
                    encoded = projected
                }
            } else {
                releaseFloatArrayStorage(layerOut)
                layer = this.readyLayers
            }
            layer = layer + 1
        }
        let mean = meanPoolFlat(encoded, tokenCount, this.hiddenSize)
        releaseFloatArrayStorage(encoded)
        return mean
    }

    fun encodeLayerMean(tokenIds: Array<Int>, mask: Array<Int>, adapterLayer: Int) r: Array<Float> {
        let info = this.info
        if not info.validHeader {
            return Array<Float>()
        }
        if this.readyLayers <= 0 {
            return Array<Float>()
        }
        let word = wordEmbeddingTensorForTokens(this.cache, info, tokenIds, mask, this.maxLoadElements)
        if not word.ok {
            return Array<Float>()
        }
        let position = cachedEmbeddingTensor(this.cache, info, "embeddings.position_embeddings.weight", this.maxLoadElements)
        if not position.ok {
            return Array<Float>()
        }
        let tokenType = cachedEmbeddingTensor(this.cache, info, "embeddings.token_type_embeddings.weight", this.maxLoadElements)
        if not tokenType.ok {
            return Array<Float>()
        }
        let normWeight = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.weight", this.maxLoadElements)
        if not normWeight.ok {
            return Array<Float>()
        }
        let normBias = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.bias", this.maxLoadElements)
        if not normBias.ok {
            return Array<Float>()
        }

        let sequence = Array<Float>()
        var tokenCount = 0
        var i = 0
        while i < tokenIds.length() and i < mask.length() {
            if mask[i] == 1 {
                tokenCount = tokenCount + 1
                let embedded = encodeTokenWithTables(tokenIds[i], i, this.hiddenSize, word, position, tokenType, normWeight, normBias)
                var d = 0
                while d < this.hiddenSize {
                    sequence.push(embedded[d])
                    d = d + 1
                }
                releaseFloatArrayStorage(embedded)
            }
            i = i + 1
        }

        if tokenCount == 0 {
            releaseFloatArrayStorage(sequence)
            return zerosFloat(this.hiddenSize)
        }

        var encoded = sequence
        let targetLayer = normalizeMiniLMLayerAdapterLayer(adapterLayer, this.readyLayers)
        var layer = 0
        while layer < this.readyLayers {
            let layerOut = applyEncoderLayerMaybeCachedBase(this.cache, info, encoded, tokenCount, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, layer, this.backend)
            if layerOut.length() == encoded.length() {
                let previous = encoded
                encoded = layerOut
                releaseFloatArrayStorage(previous)
                if layer == targetLayer {
                    let mean = meanPoolFlat(encoded, tokenCount, this.hiddenSize)
                    releaseFloatArrayStorage(encoded)
                    return mean
                }
            } else {
                releaseFloatArrayStorage(layerOut)
                releaseFloatArrayStorage(encoded)
                return Array<Float>()
            }
            layer = layer + 1
        }
        releaseFloatArrayStorage(encoded)
        return Array<Float>()
    }

    fun updateDenseAdapterTriplet(qIds: Array<Int>, qMask: Array<Int>, pIds: Array<Int>, pMask: Array<Int>, nIds: Array<Int>, nMask: Array<Int>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, denseAdapterLayer: Int, margin: Float, lr: Float, weightDecay: Float, gradClip: Float) r: Float {
        if this.readyLayers <= 0 {
            return 0.0
        }
        let targetLayer = normalizeMiniLMDenseAdapterLayer(denseAdapterLayer, this.readyLayers)
        let info = this.info
        if not info.validHeader {
            return 0.0
        }
        let qTrace = denseAdapterTrace(this.cache, info, qIds, qMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, this.backend)
        let pTrace = denseAdapterTrace(this.cache, info, pIds, pMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, this.backend)
        let nTrace = denseAdapterTrace(this.cache, info, nIds, nMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, this.backend)
        if not qTrace.ok or not pTrace.ok or not nTrace.ok {
            return 0.0
        }
        let posStats = mePairStats(qTrace.mean, pTrace.mean)
        let negStats = mePairStats(qTrace.mean, nTrace.mean)
        if not posStats.valid or not negStats.valid {
            return 0.0
        }
        let loss = meRelu(negStats.cosine - posStats.cosine + margin)
        if loss <= 0.0 {
            return 0.0
        }

        let gradQ = denseMeanTripletGradQ(qTrace.mean, pTrace.mean, nTrace.mean, posStats, negStats)
        let gradP = denseMeanTripletGradP(qTrace.mean, pTrace.mean, posStats)
        let gradN = denseMeanTripletGradN(qTrace.mean, nTrace.mean, negStats)
        let gradA = denseZeros(denseAdapter.rankA.length())
        let gradB = denseZeros(denseAdapter.rankB.length())
        let gradDW = denseZeros(denseDelta.weightDelta.length())
        let gradDB = denseZeros(denseDelta.biasDelta.length())
        let gradIW = denseZeros(intermediateDelta.weightDelta.length())
        let gradIB = denseZeros(intermediateDelta.biasDelta.length())
        let gradADW = denseZeros(attentionDenseDelta.weightDelta.length())
        let gradADB = denseZeros(attentionDenseDelta.biasDelta.length())
        let gradQW = denseZeros(queryDelta.weightDelta.length())
        let gradQB = denseZeros(queryDelta.biasDelta.length())
        let gradKW = denseZeros(keyDelta.weightDelta.length())
        let gradKB = denseZeros(keyDelta.biasDelta.length())
        let gradVW = denseZeros(valueDelta.weightDelta.length())
        let gradVB = denseZeros(valueDelta.biasDelta.length())
        let gradALNW = denseZeros(attentionLayerNormDelta.weightDelta.length())
        let gradALNB = denseZeros(attentionLayerNormDelta.biasDelta.length())
        let gradLNW = denseZeros(layerNormDelta.weightDelta.length())
        let gradLNB = denseZeros(layerNormDelta.biasDelta.length())
        accumulateDenseTraceGradWithTail(info, qTrace, gradQ, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.maxLoadElements, this.backend)
        accumulateDenseTraceGradWithTail(info, pTrace, gradP, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.maxLoadElements, this.backend)
        accumulateDenseTraceGradWithTail(info, nTrace, gradN, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.maxLoadElements, this.backend)
        denseAdapter.applyGradients(gradA, gradB, lr, weightDecay, gradClip)
        denseDelta.applyGradients(gradDW, gradDB, lr, weightDecay, gradClip)
        intermediateDelta.applyGradients(gradIW, gradIB, lr, weightDecay, gradClip)
        queryDelta.applyGradients(gradQW, gradQB, lr, weightDecay, gradClip)
        keyDelta.applyGradients(gradKW, gradKB, lr, weightDecay, gradClip)
        valueDelta.applyGradients(gradVW, gradVB, lr, weightDecay, gradClip)
        attentionDenseDelta.applyGradients(gradADW, gradADB, lr, weightDecay, gradClip)
        attentionLayerNormDelta.applyGradients(gradALNW, gradALNB, lr, weightDecay, gradClip)
        layerNormDelta.applyGradients(gradLNW, gradLNB, lr, weightDecay, gradClip)
        return loss
    }

    fun updateEmbeddingDeltasTriplet(qIds: Array<Int>, qMask: Array<Int>, pIds: Array<Int>, pMask: Array<Int>, nIds: Array<Int>, nMask: Array<Int>, embeddingDeltas: MiniLMEmbeddingDeltas, layerDeltas: MiniLMLayerDeltas, parameterRegistry: MiniLMParameterRegistry, margin: Float, lr: Float, weightDecay: Float, gradClip: Float) r: Float {
        if this.readyLayers <= 0 or embeddingDeltas.hiddenSize != this.hiddenSize {
            return 0.0
        }
        let info = this.info
        if not info.validHeader {
            return 0.0
        }
        let qTrace = embeddingDeltaTrace(this.cache, info, qIds, qMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, embeddingDeltas, layerDeltas, this.backend)
        let pTrace = embeddingDeltaTrace(this.cache, info, pIds, pMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, embeddingDeltas, layerDeltas, this.backend)
        let nTrace = embeddingDeltaTrace(this.cache, info, nIds, nMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, embeddingDeltas, layerDeltas, this.backend)
        if not qTrace.ok or not pTrace.ok or not nTrace.ok {
            return 0.0
        }
        let posStats = mePairStats(qTrace.mean, pTrace.mean)
        let negStats = mePairStats(qTrace.mean, nTrace.mean)
        if not posStats.valid or not negStats.valid {
            return 0.0
        }
        let loss = meRelu(negStats.cosine - posStats.cosine + margin)
        if loss <= 0.0 {
            return 0.0
        }
        let gradQ = denseMeanTripletGradQ(qTrace.mean, pTrace.mean, nTrace.mean, posStats, negStats)
        let gradP = denseMeanTripletGradP(qTrace.mean, pTrace.mean, posStats)
        let gradN = denseMeanTripletGradN(qTrace.mean, nTrace.mean, negStats)
        let gradWordRows = Array<Int>()
        let gradWord = Array<Float>()
        let gradPositionRows = Array<Int>()
        let gradPosition = Array<Float>()
        let gradTokenTypeRows = Array<Int>()
        let gradTokenType = Array<Float>()
        let gradLnW = denseZeros(this.hiddenSize)
        let gradLnB = denseZeros(this.hiddenSize)
        accumulateEmbeddingTraceGrad(info, qTrace, gradQ, embeddingDeltas, layerDeltas, gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, this.backend)
        accumulateEmbeddingTraceGrad(info, pTrace, gradP, embeddingDeltas, layerDeltas, gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, this.backend)
        accumulateEmbeddingTraceGrad(info, nTrace, gradN, embeddingDeltas, layerDeltas, gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, this.backend)
        let wordBase = wordEmbeddingTensorForRows(this.cache, info, gradWordRows, this.maxLoadElements)
        let positionBase = cachedEmbeddingTensor(this.cache, info, "embeddings.position_embeddings.weight", this.maxLoadElements)
        let tokenTypeBase = cachedEmbeddingTensor(this.cache, info, "embeddings.token_type_embeddings.weight", this.maxLoadElements)
        let normWeightBase = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.weight", this.maxLoadElements)
        let normBiasBase = cachedEmbeddingTensor(this.cache, info, "embeddings.LayerNorm.bias", this.maxLoadElements)
        if wordBase.ok and positionBase.ok and tokenTypeBase.ok and normWeightBase.ok and normBiasBase.ok {
            let step = embeddingDeltas.stepCount + 1
            if parameterRegistry.applyEmbeddingBaseAdamW(wordBase.values, positionBase.values, tokenTypeBase.values, normWeightBase.values, normBiasBase.values, this.hiddenSize, this.wordRows, this.positionRows, this.tokenTypeRows, embeddingDeltas.wordRowIds, embeddingDeltas.wordDelta, embeddingDeltas.wordM, embeddingDeltas.wordV, embeddingDeltas.positionRowIds, embeddingDeltas.positionDelta, embeddingDeltas.positionM, embeddingDeltas.positionV, embeddingDeltas.tokenTypeRowIds, embeddingDeltas.tokenTypeDelta, embeddingDeltas.tokenTypeM, embeddingDeltas.tokenTypeV, embeddingDeltas.layerNormWeightDelta, embeddingDeltas.layerNormWeightM, embeddingDeltas.layerNormWeightV, embeddingDeltas.layerNormBiasDelta, embeddingDeltas.layerNormBiasM, embeddingDeltas.layerNormBiasV, gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, step, lr, weightDecay, gradClip) {
                embeddingDeltas.stepCount = step
                embeddingDeltas.loaded = true
            } else {
                embeddingDeltas.applyBaseParameterGradients(wordBase.values, positionBase.values, tokenTypeBase.values, normWeightBase.values, normBiasBase.values, gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, lr, weightDecay, gradClip)
            }
        } else {
            embeddingDeltas.applyGradients(gradWordRows, gradWord, gradPositionRows, gradPosition, gradTokenTypeRows, gradTokenType, gradLnW, gradLnB, lr, weightDecay, gradClip)
        }
        return loss
    }

    fun updateAllLayerDeltasTriplet(qIds: Array<Int>, qMask: Array<Int>, pIds: Array<Int>, pMask: Array<Int>, nIds: Array<Int>, nMask: Array<Int>, layerDeltas: MiniLMLayerDeltas, embeddingDeltas: MiniLMEmbeddingDeltas, parameterRegistry: MiniLMParameterRegistry, margin: Float, lr: Float, weightDecay: Float, gradClip: Float) r: Float {
        if this.readyLayers <= 0 {
            return 0.0
        }
        let info = this.info
        if not info.validHeader {
            return 0.0
        }
        let gradDeltas = MiniLMLayerDeltas.identity(layerDeltas.layers, layerDeltas.hiddenSize, layerDeltas.intermediateSize)
        var layer = this.readyLayers - 1
        var lossSum = 0.0
        var count = 0
        while layer >= 0 {
            if layerDeltas.hasLayer(layer) {
                let loss = this.accumulateLayerDeltasTripletGrad(info, qIds, qMask, pIds, pMask, nIds, nMask, layerDeltas, embeddingDeltas, gradDeltas, layer, margin)
                lossSum = lossSum + loss
                count = count + 1
            }
            layer = layer - 1
        }
        applyMiniLMLayerBaseParameterGradients(info, parameterRegistry, layerDeltas, gradDeltas, this.readyLayers, this.maxLoadElements, lr, weightDecay, gradClip)
        let embeddingLoss = this.updateEmbeddingDeltasTriplet(qIds, qMask, pIds, pMask, nIds, nMask, embeddingDeltas, layerDeltas, parameterRegistry, margin, lr, weightDecay, gradClip)
        if embeddingLoss > 0.0 {
            lossSum = lossSum + embeddingLoss
            count = count + 1
        }
        if count <= 0 {
            return 0.0
        }
        return lossSum / count.toFloat()
    }

    fun accumulateLayerDeltasTripletGrad(info: SafeTensorInfo, qIds: Array<Int>, qMask: Array<Int>, pIds: Array<Int>, pMask: Array<Int>, nIds: Array<Int>, nMask: Array<Int>, layerDeltas: MiniLMLayerDeltas, embeddingDeltas: MiniLMEmbeddingDeltas, gradDeltas: MiniLMLayerDeltas, targetLayer: Int, margin: Float) r: Float {
        let denseAdapter = DenseLoRAAdapter.identity(this.intermediateSize, this.hiddenSize)
        let qTrace = denseAdapterTraceWithLayerDeltas(this.cache, info, qIds, qMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, layerDeltas, embeddingDeltas, this.backend)
        let pTrace = denseAdapterTraceWithLayerDeltas(this.cache, info, pIds, pMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, layerDeltas, embeddingDeltas, this.backend)
        let nTrace = denseAdapterTraceWithLayerDeltas(this.cache, info, nIds, nMask, this.hiddenSize, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.readyLayers, targetLayer, layerDeltas, embeddingDeltas, this.backend)
        if not qTrace.ok or not pTrace.ok or not nTrace.ok {
            return 0.0
        }
        let posStats = mePairStats(qTrace.mean, pTrace.mean)
        let negStats = mePairStats(qTrace.mean, nTrace.mean)
        if not posStats.valid or not negStats.valid {
            return 0.0
        }
        let loss = meRelu(negStats.cosine - posStats.cosine + margin)
        if loss <= 0.0 {
            return 0.0
        }

        let gradQ = denseMeanTripletGradQ(qTrace.mean, pTrace.mean, nTrace.mean, posStats, negStats)
        let gradP = denseMeanTripletGradP(qTrace.mean, pTrace.mean, posStats)
        let gradN = denseMeanTripletGradN(qTrace.mean, nTrace.mean, negStats)
        let gradA = denseZeros(denseAdapter.rankA.length())
        let gradB = denseZeros(denseAdapter.rankB.length())
        let gradDW = denseZeros(layerDeltas.outputDeltas[targetLayer].weightDelta.length())
        let gradDB = denseZeros(layerDeltas.outputDeltas[targetLayer].biasDelta.length())
        let gradIW = denseZeros(layerDeltas.intermediateDeltas[targetLayer].weightDelta.length())
        let gradIB = denseZeros(layerDeltas.intermediateDeltas[targetLayer].biasDelta.length())
        let gradADW = denseZeros(layerDeltas.attentionDenseDeltas[targetLayer].weightDelta.length())
        let gradADB = denseZeros(layerDeltas.attentionDenseDeltas[targetLayer].biasDelta.length())
        let gradQW = denseZeros(layerDeltas.queryDeltas[targetLayer].weightDelta.length())
        let gradQB = denseZeros(layerDeltas.queryDeltas[targetLayer].biasDelta.length())
        let gradKW = denseZeros(layerDeltas.keyDeltas[targetLayer].weightDelta.length())
        let gradKB = denseZeros(layerDeltas.keyDeltas[targetLayer].biasDelta.length())
        let gradVW = denseZeros(layerDeltas.valueDeltas[targetLayer].weightDelta.length())
        let gradVB = denseZeros(layerDeltas.valueDeltas[targetLayer].biasDelta.length())
        let gradALNW = denseZeros(layerDeltas.attentionLayerNormDeltas[targetLayer].weightDelta.length())
        let gradALNB = denseZeros(layerDeltas.attentionLayerNormDeltas[targetLayer].biasDelta.length())
        let gradLNW = denseZeros(layerDeltas.outputLayerNormDeltas[targetLayer].weightDelta.length())
        let gradLNB = denseZeros(layerDeltas.outputLayerNormDeltas[targetLayer].biasDelta.length())
        accumulateDenseTraceGradWithLayerDeltaTail(info, qTrace, gradQ, denseAdapter, layerDeltas, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.backend)
        accumulateDenseTraceGradWithLayerDeltaTail(info, pTrace, gradP, denseAdapter, layerDeltas, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.backend)
        accumulateDenseTraceGradWithLayerDeltaTail(info, nTrace, gradN, denseAdapter, layerDeltas, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, targetLayer, this.readyLayers, this.attentionHeads, this.intermediateSize, this.maxLoadElements, this.backend)
        addFlatInPlace(gradDeltas.outputDeltas[targetLayer].weightDelta, gradDW)
        addFlatInPlace(gradDeltas.outputDeltas[targetLayer].biasDelta, gradDB)
        addFlatInPlace(gradDeltas.intermediateDeltas[targetLayer].weightDelta, gradIW)
        addFlatInPlace(gradDeltas.intermediateDeltas[targetLayer].biasDelta, gradIB)
        addFlatInPlace(gradDeltas.queryDeltas[targetLayer].weightDelta, gradQW)
        addFlatInPlace(gradDeltas.queryDeltas[targetLayer].biasDelta, gradQB)
        addFlatInPlace(gradDeltas.keyDeltas[targetLayer].weightDelta, gradKW)
        addFlatInPlace(gradDeltas.keyDeltas[targetLayer].biasDelta, gradKB)
        addFlatInPlace(gradDeltas.valueDeltas[targetLayer].weightDelta, gradVW)
        addFlatInPlace(gradDeltas.valueDeltas[targetLayer].biasDelta, gradVB)
        addFlatInPlace(gradDeltas.attentionDenseDeltas[targetLayer].weightDelta, gradADW)
        addFlatInPlace(gradDeltas.attentionDenseDeltas[targetLayer].biasDelta, gradADB)
        addFlatInPlace(gradDeltas.attentionLayerNormDeltas[targetLayer].weightDelta, gradALNW)
        addFlatInPlace(gradDeltas.attentionLayerNormDeltas[targetLayer].biasDelta, gradALNB)
        addFlatInPlace(gradDeltas.outputLayerNormDeltas[targetLayer].weightDelta, gradLNW)
        addFlatInPlace(gradDeltas.outputLayerNormDeltas[targetLayer].biasDelta, gradLNB)
        return loss
    }

    fun summary() r: String {
        var out = "model_embeddings_loaded=" + this.loaded.toString()
        out = out + " model_layer0_ready=" + this.layer0Ready.toString()
        out = out + " model_layers_ready=" + this.readyLayers.toString() + "/" + this.layers.toString()
        out = out + " model_backend=" + this.backend
        out = out + " model_cache_ready=" + this.cache.ok.toString()
        out = out + " model_cache_layers=" + this.cache.cachedLayers.toString() + "/" + this.cache.requestedLayers.toString()
        out = out + " model_embedding_error=" + this.error
        return out
    }
}

class MiniLMEmbeddingTrace {
    var ok: Bool
    var seqLen: Int
    var hiddenSize: Int
    var rawSequence: Array<Float>
    var outputSequence: Array<Float>
    var wordRows: Array<Int>
    var positionRows: Array<Int>
    var tokenTypeRows: Array<Int>
    var mean: Array<Float>

    static fun failure() r: MiniLMEmbeddingTrace {
        return MiniLMEmbeddingTrace{
            ok: false,
            seqLen: 0,
            hiddenSize: 0,
            rawSequence: Array<Float>(),
            outputSequence: Array<Float>(),
            wordRows: Array<Int>(),
            positionRows: Array<Int>(),
            tokenTypeRows: Array<Int>(),
            mean: Array<Float>()
        }
    }

    static fun success(seqLen: Int, hiddenSize: Int, rawSequence: Array<Float>, outputSequence: Array<Float>, wordRows: Array<Int>, positionRows: Array<Int>, tokenTypeRows: Array<Int>, mean: Array<Float>) r: MiniLMEmbeddingTrace {
        return MiniLMEmbeddingTrace{
            ok: true,
            seqLen: seqLen,
            hiddenSize: hiddenSize,
            rawSequence: rawSequence,
            outputSequence: outputSequence,
            wordRows: wordRows,
            positionRows: positionRows,
            tokenTypeRows: tokenTypeRows,
            mean: mean
        }
    }
}

