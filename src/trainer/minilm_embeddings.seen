class MiniLMPairStats {
    var valid: Bool
    var cosine: Float
    var normA: Float
    var normB: Float

    static fun invalid() r: MiniLMPairStats {
        return MiniLMPairStats{ valid: false, cosine: 0.0, normA: 0.0, normB: 0.0 }
    }

    static fun new(cosine: Float, normA: Float, normB: Float) r: MiniLMPairStats {
        return MiniLMPairStats{ valid: true, cosine: cosine, normA: normA, normB: normB }
    }
}

fun validateEmbeddingTensor(info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int, hiddenSize: Int, requireMatrix: Bool) r: String {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return "missing tensor " + canonicalName
    }
    let entry = info.entries[index]
    if not isF32DType(entry.dtype) {
        return "tensor dtype is not F32"
    }
    let elementCount = entry.elementCount()
    if elementCount > maxLoadElements {
        return "tensor over load cap"
    }
    if elementCount <= 0 {
        return "tensor has no elements"
    }
    if requireMatrix and tensorCols(entry) != hiddenSize {
        return "embedding width mismatch"
    }
    if not requireMatrix and elementCount < hiddenSize {
        return "layer norm length mismatch"
    }
    if entry.byteCount() != elementCount * 4 {
        return "F32 byte count does not match shape"
    }
    return ""
}

fun countReadyEncoderLayers(info: SafeTensorInfo, layers: Int, maxLoadElements: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int) r: Int {
    var ready = 0
    var layer = 0
    while layer < layers {
        let validation = validateEncoderLayer(info, layer, maxLoadElements, hiddenSize, attentionHeads, intermediateSize)
        if validation.length() > 0 {
            return ready
        }
        ready = ready + 1
        layer = layer + 1
    }
    return ready
}

fun validateEncoderLayer(info: SafeTensorInfo, layer: Int, maxLoadElements: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int) r: String {
    if attentionHeads <= 0 {
        return "attention head count must be positive"
    }
    if hiddenSize % attentionHeads != 0 {
        return "hidden size must divide by attention heads"
    }
    let prefix = "encoder.layer." + layer.toString() + "."
    let qWeight = validateMatrixTensor(info, prefix + "attention.self.query.weight", maxLoadElements, hiddenSize, hiddenSize)
    if qWeight.length() > 0 { return "query weight: " + qWeight }
    let qBias = validateVectorTensor(info, prefix + "attention.self.query.bias", maxLoadElements, hiddenSize)
    if qBias.length() > 0 { return "query bias: " + qBias }
    let kWeight = validateMatrixTensor(info, prefix + "attention.self.key.weight", maxLoadElements, hiddenSize, hiddenSize)
    if kWeight.length() > 0 { return "key weight: " + kWeight }
    let kBias = validateVectorTensor(info, prefix + "attention.self.key.bias", maxLoadElements, hiddenSize)
    if kBias.length() > 0 { return "key bias: " + kBias }
    let vWeight = validateMatrixTensor(info, prefix + "attention.self.value.weight", maxLoadElements, hiddenSize, hiddenSize)
    if vWeight.length() > 0 { return "value weight: " + vWeight }
    let vBias = validateVectorTensor(info, prefix + "attention.self.value.bias", maxLoadElements, hiddenSize)
    if vBias.length() > 0 { return "value bias: " + vBias }
    let attnOutWeight = validateMatrixTensor(info, prefix + "attention.output.dense.weight", maxLoadElements, hiddenSize, hiddenSize)
    if attnOutWeight.length() > 0 { return "attention output weight: " + attnOutWeight }
    let attnOutBias = validateVectorTensor(info, prefix + "attention.output.dense.bias", maxLoadElements, hiddenSize)
    if attnOutBias.length() > 0 { return "attention output bias: " + attnOutBias }
    let attnLnWeight = validateVectorTensor(info, prefix + "attention.output.LayerNorm.weight", maxLoadElements, hiddenSize)
    if attnLnWeight.length() > 0 { return "attention layer norm weight: " + attnLnWeight }
    let attnLnBias = validateVectorTensor(info, prefix + "attention.output.LayerNorm.bias", maxLoadElements, hiddenSize)
    if attnLnBias.length() > 0 { return "attention layer norm bias: " + attnLnBias }
    let intermediateWeight = validateMatrixTensor(info, prefix + "intermediate.dense.weight", maxLoadElements, intermediateSize, hiddenSize)
    if intermediateWeight.length() > 0 { return "intermediate weight: " + intermediateWeight }
    let intermediateBias = validateVectorTensor(info, prefix + "intermediate.dense.bias", maxLoadElements, intermediateSize)
    if intermediateBias.length() > 0 { return "intermediate bias: " + intermediateBias }
    let outputWeight = validateMatrixTensor(info, prefix + "output.dense.weight", maxLoadElements, hiddenSize, intermediateSize)
    if outputWeight.length() > 0 { return "output weight: " + outputWeight }
    let outputBias = validateVectorTensor(info, prefix + "output.dense.bias", maxLoadElements, hiddenSize)
    if outputBias.length() > 0 { return "output bias: " + outputBias }
    let outputLnWeight = validateVectorTensor(info, prefix + "output.LayerNorm.weight", maxLoadElements, hiddenSize)
    if outputLnWeight.length() > 0 { return "output layer norm weight: " + outputLnWeight }
    let outputLnBias = validateVectorTensor(info, prefix + "output.LayerNorm.bias", maxLoadElements, hiddenSize)
    if outputLnBias.length() > 0 { return "output layer norm bias: " + outputLnBias }
    return ""
}

fun validateMatrixTensor(info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int, rows: Int, cols: Int) r: String {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return "missing tensor " + canonicalName
    }
    let entry = info.entries[index]
    if not isF32DType(entry.dtype) {
        return "tensor dtype is not F32"
    }
    if entry.elementCount() > maxLoadElements {
        return "tensor over load cap"
    }
    if tensorRows(entry) != rows or tensorCols(entry) != cols {
        return "shape mismatch"
    }
    if entry.byteCount() != entry.elementCount() * 4 {
        return "F32 byte count does not match shape"
    }
    return ""
}

fun validateVectorTensor(info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int, length: Int) r: String {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return "missing tensor " + canonicalName
    }
    let entry = info.entries[index]
    if not isF32DType(entry.dtype) {
        return "tensor dtype is not F32"
    }
    if entry.elementCount() > maxLoadElements {
        return "tensor over load cap"
    }
    if entry.elementCount() < length {
        return "vector length mismatch"
    }
    if entry.byteCount() != entry.elementCount() * 4 {
        return "F32 byte count does not match shape"
    }
    return ""
}

fun embeddingTensorRows(info: SafeTensorInfo, canonicalName: String) r: Int {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return 0
    }
    return tensorRows(info.entries[index])
}

fun loadEmbeddingTensor(info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int) r: EmbeddingTensorLoad {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return EmbeddingTensorLoad.failure("missing tensor " + canonicalName)
    }
    let entry = info.entries[index]
    let validation = validateEmbeddingTensor(info, canonicalName, maxLoadElements, tensorCols(entry), true)
    if validation.length() > 0 and canonicalName != "embeddings.LayerNorm.weight" and canonicalName != "embeddings.LayerNorm.bias" {
        return EmbeddingTensorLoad.failure(validation)
    }
    if canonicalName == "embeddings.LayerNorm.weight" or canonicalName == "embeddings.LayerNorm.bias" {
        let normValidation = validateEmbeddingTensor(info, canonicalName, maxLoadElements, entry.elementCount(), false)
        if normValidation.length() > 0 {
            return EmbeddingTensorLoad.failure(normValidation)
        }
    }

    let base = 8 + info.headerLength + entry.dataStart
    let values = Array<Float>(entry.elementCount(), 0.0)
    var loadedBytes = 0
    var valueIndex = 0
    while loadedBytes < entry.byteCount() {
        let chunkBytes = embeddingTensorByteChunkSize(entry.byteCount() - loadedBytes)
        let bytes = readBytesRange(info.path, base + loadedBytes, chunkBytes)
        if bytes.length() < chunkBytes {
            releaseIntArrayStorage(bytes)
            return EmbeddingTensorLoad.failure("tensor data is truncated")
        }
        var i = 0
        while i + 3 < bytes.length() {
            values[valueIndex] = meReadF32Le(bytes, i)
            valueIndex = valueIndex + 1
            i = i + 4
        }
        releaseIntArrayStorage(bytes)
        loadedBytes = loadedBytes + chunkBytes
    }
    return EmbeddingTensorLoad.success(tensorRows(entry), tensorCols(entry), values)
}

fun embeddingTensorByteChunkSize(remaining: Int) r: Int {
    if remaining < 262144 {
        return remaining
    }
    return 262144
}

fun loadEmbeddingTensorMetadata(info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int) r: EmbeddingTensorLoad {
    let index = mwFindCandidateIndex(info, canonicalName)
    if index < 0 {
        return EmbeddingTensorLoad.failure("missing tensor " + canonicalName)
    }
    let entry = info.entries[index]
    let validation = validateEmbeddingTensor(info, canonicalName, maxLoadElements, tensorCols(entry), true)
    if validation.length() > 0 {
        return EmbeddingTensorLoad.failure(validation)
    }
    return EmbeddingTensorLoad.sparse(tensorRows(entry), tensorCols(entry), Array<Int>(), Array<Float>())
}

fun wordEmbeddingTensorForTokens(cache: MiniLMForwardCache, info: SafeTensorInfo, tokenIds: Array<Int>, mask: Array<Int>, maxLoadElements: Int) r: EmbeddingTensorLoad {
    if cache.embeddingsOk and cache.word.ok and cache.word.values.length() > 0 {
        return cache.word
    }
    let meta = if cache.embeddingsOk and cache.word.ok { cache.word } else { loadEmbeddingTensorMetadata(info, "embeddings.word_embeddings.weight", maxLoadElements) }
    if not meta.ok {
        return meta
    }
    let rowIds = Array<Int>()
    var i = 0
    while i < tokenIds.length() and i < mask.length() {
        if mask[i] == 1 {
            let row = positiveMod(tokenIds[i], meta.rows)
            if not meIntArrayContains(rowIds, row) {
                rowIds.push(row)
            }
        }
        i = i + 1
    }
    return loadWordEmbeddingRows(info, rowIds, meta.rows, meta.cols, maxLoadElements)
}

fun wordEmbeddingTensorForRows(cache: MiniLMForwardCache, info: SafeTensorInfo, rows: Array<Int>, maxLoadElements: Int) r: EmbeddingTensorLoad {
    if cache.embeddingsOk and cache.word.ok and cache.word.values.length() > 0 {
        return cache.word
    }
    let meta = if cache.embeddingsOk and cache.word.ok { cache.word } else { loadEmbeddingTensorMetadata(info, "embeddings.word_embeddings.weight", maxLoadElements) }
    if not meta.ok {
        return meta
    }
    let rowIds = Array<Int>()
    var i = 0
    while i < rows.length() {
        let row = positiveMod(rows[i], meta.rows)
        if not meIntArrayContains(rowIds, row) {
            rowIds.push(row)
        }
        i = i + 1
    }
    return loadWordEmbeddingRows(info, rowIds, meta.rows, meta.cols, maxLoadElements)
}

fun loadWordEmbeddingRows(info: SafeTensorInfo, rowIds: Array<Int>, rows: Int, cols: Int, maxLoadElements: Int) r: EmbeddingTensorLoad {
    let index = mwFindCandidateIndex(info, "embeddings.word_embeddings.weight")
    if index < 0 {
        return EmbeddingTensorLoad.failure("missing tensor embeddings.word_embeddings.weight")
    }
    let entry = info.entries[index]
    if not isF32DType(entry.dtype) {
        return EmbeddingTensorLoad.failure("tensor dtype is not F32")
    }
    if tensorRows(entry) != rows or tensorCols(entry) != cols {
        return EmbeddingTensorLoad.failure("embedding shape mismatch")
    }
    if rowIds.length() * cols > maxLoadElements {
        return EmbeddingTensorLoad.failure("sparse row load exceeds cap")
    }
    let values = Array<Float>()
    let dataBase = 8 + info.headerLength + entry.dataStart
    var slot = 0
    while slot < rowIds.length() {
        let row = rowIds[slot]
        if row < 0 or row >= rows {
            return EmbeddingTensorLoad.failure("sparse row out of bounds")
        }
        let rowBytes = readBytesRange(info.path, dataBase + row * cols * 4, cols * 4)
        if rowBytes.length() < cols * 4 {
            releaseIntArrayStorage(rowBytes)
            return EmbeddingTensorLoad.failure("sparse row data is truncated")
        }
        var d = 0
        while d < cols {
            values.push(meReadF32Le(rowBytes, d * 4))
            d = d + 1
        }
        releaseIntArrayStorage(rowBytes)
        slot = slot + 1
    }
    return EmbeddingTensorLoad.sparse(rows, cols, rowIds, values)
}

fun meIntArrayContains(values: Array<Int>, needle: Int) r: Bool {
    var i = 0
    while i < values.length() {
        if values[i] == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fun cachedEmbeddingTensor(cache: MiniLMForwardCache, info: SafeTensorInfo, canonicalName: String, maxLoadElements: Int) r: EmbeddingTensorLoad {
    if cache.embeddingsOk {
        if canonicalName == "embeddings.word_embeddings.weight" {
            return cache.word
        }
        if canonicalName == "embeddings.position_embeddings.weight" {
            return cache.position
        }
        if canonicalName == "embeddings.token_type_embeddings.weight" {
            return cache.tokenType
        }
        if canonicalName == "embeddings.LayerNorm.weight" {
            return cache.normWeight
        }
        if canonicalName == "embeddings.LayerNorm.bias" {
            return cache.normBias
        }
    }
    return loadEmbeddingTensor(info, canonicalName, maxLoadElements)
}

fun applyEncoderLayer(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int) r: Array<Float> {
    return applyEncoderLayerWithDenseAdapter(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), LayerNormDeltaAdapter.identity(0), LayerNormDeltaAdapter.identity(0), false)
}

fun applyEncoderLayerBackend(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, backend: String) r: Array<Float> {
    return applyEncoderLayerWithDenseAdapterBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), LayerNormDeltaAdapter.identity(0), LayerNormDeltaAdapter.identity(0), false, backend)
}

fun applyEncoderLayerWithDenseAdapter(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, applyDenseAdapter: Bool) r: Array<Float> {
    return applyEncoderLayerWithDenseAdapterBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, applyDenseAdapter, "cpu")
}

fun applyEncoderLayerWithDenseAdapterBackend(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, applyDenseAdapter: Bool, backend: String) r: Array<Float> {
    let layerCache = MiniLMEncoderLayerCache.load(info, layer, maxLoadElements)
    let result = applyEncoderLayerWithDenseAdapterCachedBackend(layerCache, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, applyDenseAdapter, backend)
    releaseMiniLMEncoderLayerCacheStorage(layerCache)
    return result
}

fun applyEncoderLayerMaybeCached(cache: MiniLMForwardCache, info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, applyDenseAdapter: Bool, backend: String) r: Array<Float> {
    if cache.hasLayer(layer) {
        return applyEncoderLayerWithDenseAdapterCachedBackend(cache.layerAt(layer), sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, applyDenseAdapter, backend)
    }
    return applyEncoderLayerWithDenseAdapterBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, applyDenseAdapter, backend)
}

fun applyEncoderLayerMaybeCachedBase(cache: MiniLMForwardCache, info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, backend: String) r: Array<Float> {
    return applyEncoderLayerMaybeCached(cache, info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), LayerNormDeltaAdapter.identity(0), LayerNormDeltaAdapter.identity(0), false, backend)
}

fun applyEncoderLayerWithDenseAdapterCachedBackend(layerCache: MiniLMEncoderLayerCache, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, applyDenseAdapter: Bool, backend: String) r: Array<Float> {
    if not layerCache.ok {
        return Array<Float>()
    }
    let qWeight = layerCache.qWeight
    let qBias = layerCache.qBias
    let kWeight = layerCache.kWeight
    let kBias = layerCache.kBias
    let vWeight = layerCache.vWeight
    let vBias = layerCache.vBias
    let attnOutWeight = layerCache.attentionOutputWeight
    let attnOutBias = layerCache.attentionOutputBias
    let attnLnWeight = layerCache.attentionNormWeight
    let attnLnBias = layerCache.attentionNormBias
    let intermediateWeight = layerCache.intermediateWeight
    let intermediateBias = layerCache.intermediateBias
    let outputWeight = layerCache.outputWeight
    let outputBias = layerCache.outputBias
    let outputLnWeight = layerCache.outputNormWeight
    let outputLnBias = layerCache.outputNormBias

    let q = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, qWeight, qBias, queryDelta, applyDenseAdapter, backend)
    let k = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, kWeight, kBias, keyDelta, applyDenseAdapter, backend)
    let v = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, vWeight, vBias, valueDelta, applyDenseAdapter, backend)
    let context = attentionContextBackend(q, k, v, seqLen, hiddenSize, attentionHeads, backend)
    if context.length() != sequence.length() {
        releaseFloatArrayStorage(q)
        releaseFloatArrayStorage(k)
        releaseFloatArrayStorage(v)
        releaseFloatArrayStorage(context)
        return Array<Float>()
    }

    let attnDense = projectSequenceWithDenseDeltaBackend(context, seqLen, hiddenSize, hiddenSize, attnOutWeight, attnOutBias, attentionDenseDelta, applyDenseAdapter, backend)
    let attnLnInput = addFlatRows(attnDense, sequence, seqLen, hiddenSize)
    var attnNorm = layerNormRowsBackend(attnLnInput, seqLen, hiddenSize, attnLnWeight.values, attnLnBias.values, backend)
    if applyDenseAdapter {
        let effectiveAttentionWeight = layerNormDeltaEffectiveWeight(attnLnWeight.values, attentionLayerNormDelta)
        let effectiveAttentionBias = layerNormDeltaEffectiveBias(attnLnBias.values, attentionLayerNormDelta)
        let previousAttnNorm = attnNorm
        attnNorm = layerNormRowsBackend(attnLnInput, seqLen, hiddenSize, effectiveAttentionWeight, effectiveAttentionBias, backend)
        releaseFloatArrayStorage(previousAttnNorm)
        releaseFloatArrayStorage(effectiveAttentionWeight)
        releaseFloatArrayStorage(effectiveAttentionBias)
    }
    let ffIntermediate = feedForwardIntermediateWithDenseDeltaBackend(attnNorm, seqLen, hiddenSize, intermediateSize, intermediateWeight, intermediateBias, intermediateDelta, applyDenseAdapter, backend)
    let ffOutput = feedForwardOutputWithDenseAdapterBackend(ffIntermediate, seqLen, intermediateSize, hiddenSize, outputWeight, outputBias, denseAdapter, denseDelta, applyDenseAdapter, backend)
    var out = Array<Float>()
    if applyDenseAdapter {
        let effectiveWeight = layerNormDelta.effectiveWeight(outputLnWeight.values)
        let effectiveBias = layerNormDelta.effectiveBias(outputLnBias.values)
        out = residualLayerNormValuesBackend(ffOutput, attnNorm, seqLen, hiddenSize, effectiveWeight, effectiveBias, backend)
        releaseFloatArrayStorage(effectiveWeight)
        releaseFloatArrayStorage(effectiveBias)
    } else {
        out = residualLayerNormBackend(ffOutput, attnNorm, seqLen, hiddenSize, outputLnWeight, outputLnBias, backend)
    }
    releaseFloatArrayStorage(q)
    releaseFloatArrayStorage(k)
    releaseFloatArrayStorage(v)
    releaseFloatArrayStorage(context)
    releaseFloatArrayStorage(attnDense)
    releaseFloatArrayStorage(attnLnInput)
    releaseFloatArrayStorage(attnNorm)
    releaseFloatArrayStorage(ffIntermediate)
    releaseFloatArrayStorage(ffOutput)
    return out
}

fun normalizeMiniLMLayerAdapterLayer(adapterLayer: Int, readyLayers: Int) r: Int {
    if readyLayers <= 0 {
        return -1
    }
    if adapterLayer < 0 {
        return -1
    }
    if adapterLayer >= readyLayers {
        return readyLayers - 1
    }
    return adapterLayer
}

fun normalizeMiniLMDenseAdapterLayer(adapterLayer: Int, readyLayers: Int) r: Int {
    if readyLayers <= 0 {
        return -1
    }
    if adapterLayer < 0 {
        return -1
    }
    if adapterLayer >= readyLayers {
        return readyLayers - 1
    }
    return adapterLayer
}

fun applyProjectionAdapterToSequence(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, adapter: ProjectionAdapter) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, hiddenSize)
        let projected = adapter.apply(input)
        var d = 0
        while d < hiddenSize {
            if d < projected.length() {
                out.push(projected[d])
            } else {
                out.push(flatAt(sequence, row, d, hiddenSize))
            }
            d = d + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(projected)
        row = row + 1
    }
    return out
}

fun projectSequence(sequence: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, inputSize)
        let projected = linearVector(input, weight, bias)
        var i = 0
        while i < projected.length() {
            out.push(projected[i])
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(projected)
        row = row + 1
    }
    return out
}

fun projectSequenceWithDenseDelta(sequence: Array<Float>, seqLen: Int, inputSize: Int, outputSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, denseDelta: DenseDeltaAdapter, applyDelta: Bool) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, inputSize)
        let projected = linearVector(input, weight, bias)
        let delta = if applyDelta { denseDelta.apply(input) } else { denseZeros(outputSize) }
        var i = 0
        while i < outputSize and i < projected.length() {
            var value = projected[i]
            if i < delta.length() {
                value = value + delta[i]
            }
            out.push(value)
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(projected)
        releaseFloatArrayStorage(delta)
        row = row + 1
    }
    return out
}

fun projectSequenceWithDenseDeltaBackend(sequence: Array<Float>, seqLen: Int, inputSize: Int, outputSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, denseDelta: DenseDeltaAdapter, applyDelta: Bool, backend: String) r: Array<Float> {
    let projected = projectSequenceLinearBackend(sequence, seqLen, inputSize, outputSize, weight, bias, backend)
    if projected.length() != seqLen * outputSize {
        releaseFloatArrayStorage(projected)
        return projectSequenceWithDenseDelta(sequence, seqLen, inputSize, outputSize, weight, bias, denseDelta, applyDelta)
    }
    if not applyDelta {
        return projected
    }
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, inputSize)
        let delta = denseDelta.apply(input)
        var i = 0
        while i < outputSize {
            var value = flatAt(projected, row, i, outputSize)
            if i < delta.length() {
                value = value + delta[i]
            }
            out.push(value)
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(delta)
        row = row + 1
    }
    releaseFloatArrayStorage(projected)
    return out
}

fun projectSequenceLinearBackend(sequence: Array<Float>, seqLen: Int, inputSize: Int, outputSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, backend: String) r: Array<Float> {
    if seqLen <= 0 or inputSize <= 0 or outputSize <= 0 {
        return Array<Float>()
    }
    if not weight.ok or not bias.ok {
        return Array<Float>()
    }
    if sequence.length() < seqLen * inputSize or weight.rows < outputSize or weight.cols < inputSize or bias.values.length() < outputSize {
        return Array<Float>()
    }
    if miniLMBackendIsGpu(backend) {
        let productGpu = tensorGpuMatmulBTransposed(sequence, weight.values, seqLen, inputSize, outputSize)
        if productGpu.ok == 1 and productGpu.values.length() == seqLen * outputSize {
            let outGpu = Array<Float>(seqLen * outputSize, 0.0)
            var gpuRow = 0
            while gpuRow < seqLen {
                var gpuCol = 0
                while gpuCol < outputSize {
                    outGpu[gpuRow * outputSize + gpuCol] = productGpu.values[gpuRow * outputSize + gpuCol] + embeddingAt(bias.values, 0, gpuCol, bias.cols)
                    gpuCol = gpuCol + 1
                }
                gpuRow = gpuRow + 1
            }
            releaseFloatArrayStorage(productGpu.values)
            return outGpu
        }
        releaseFloatArrayStorage(productGpu.values)
        return Array<Float>()
    }
    let transposed = Array<Float>()
    var inputCol = 0
    while inputCol < inputSize {
        var outputCol = 0
        while outputCol < outputSize {
            transposed.push(embeddingAt(weight.values, outputCol, inputCol, weight.cols))
            outputCol = outputCol + 1
        }
        inputCol = inputCol + 1
    }
    let inputTensor = Tensor.fromArray(seqLen, inputSize, sequence, backend)
    let weightTensor = Tensor.fromArray(inputSize, outputSize, transposed, backend)
    let product = inputTensor.matmul(weightTensor)
    if product.values.length() != seqLen * outputSize {
        releaseFloatArrayStorage(transposed)
        releaseFloatArrayStorage(product.values)
        return Array<Float>()
    }
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        var col = 0
        while col < outputSize {
            out.push(product.at(row, col) + embeddingAt(bias.values, 0, col, bias.cols))
            col = col + 1
        }
        row = row + 1
    }
    releaseFloatArrayStorage(transposed)
    releaseFloatArrayStorage(product.values)
    return out
}

fun linearVector(input: Array<Float>, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad) r: Array<Float> {
    let out = Array<Float>()
    var o = 0
    while o < weight.rows {
        var sum = embeddingAt(bias.values, 0, o, bias.cols)
        var i = 0
        while i < input.length() and i < weight.cols {
            sum = sum + input[i] * embeddingAt(weight.values, o, i, weight.cols)
            i = i + 1
        }
        out.push(sum)
        o = o + 1
    }
    return out
}

fun attentionContext(q: Array<Float>, k: Array<Float>, v: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int) r: Array<Float> {
    return attentionContextBackend(q, k, v, seqLen, hiddenSize, attentionHeads, "cpu")
}

fun attentionContextBackend(q: Array<Float>, k: Array<Float>, v: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, backend: String) r: Array<Float> {
    if attentionHeads <= 0 or hiddenSize % attentionHeads != 0 {
        return Array<Float>()
    }
    if miniLMBackendIsGpu(backend) {
        let fused = tensorGpuAttentionContext(q, k, v, seqLen, hiddenSize, attentionHeads)
        if fused.ok == 1 and fused.values.length() == seqLen * hiddenSize {
            return fused.values
        }
        let headDim = hiddenSize / attentionHeads
        let out = zerosFloat(seqLen * hiddenSize)
        let scale = sqrt(headDim.toFloat())
        var head = 0
        while head < attentionHeads {
            let qHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(q, seqLen, hiddenSize, head, headDim), backend)
            let kHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(k, seqLen, hiddenSize, head, headDim), backend)
            let vHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(v, seqLen, hiddenSize, head, headDim), backend)
            let scoreTensor = qHeadTensor.matmul(kHeadTensor.transpose()).scale(1.0 / scale)
            let weightTensor = scoreTensor.softmaxRows()
            let contextHead = weightTensor.matmul(vHeadTensor)
            if contextHead.values.length() != seqLen * headDim {
                return attentionContextScalar(q, k, v, seqLen, hiddenSize, attentionHeads)
            }
            addAttentionHeadRowsInPlace(out, contextHead.values, seqLen, hiddenSize, head, headDim)
            head = head + 1
        }
        return out
    }
    return attentionContextScalar(q, k, v, seqLen, hiddenSize, attentionHeads)
}

fun attentionContextScalar(q: Array<Float>, k: Array<Float>, v: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int) r: Array<Float> {
    if attentionHeads <= 0 or hiddenSize % attentionHeads != 0 {
        return Array<Float>()
    }
    let headDim = hiddenSize / attentionHeads
    let out = zerosFloat(seqLen * hiddenSize)
    let scale = sqrt(headDim.toFloat())
    var token = 0
    while token < seqLen {
        var head = 0
        while head < attentionHeads {
            let scores = Array<Float>()
            var maxScore = -99999999.0
            var other = 0
            while other < seqLen {
                let score = attentionScore(q, k, token, other, head, headDim, hiddenSize) / scale
                scores.push(score)
                if score > maxScore {
                    maxScore = score
                }
                other = other + 1
            }

            var denom = 0.0
            other = 0
            while other < scores.length() {
                denom = denom + exp(scores[other] - maxScore)
                other = other + 1
            }
            var d = 0
            while d < headDim {
                var value = 0.0
                other = 0
                while other < seqLen {
                    var weight = 0.0
                    if denom > 0.000000001 {
                        weight = exp(scores[other] - maxScore) / denom
                    }
                    value = value + weight * flatAt(v, other, head * headDim + d, hiddenSize)
                    other = other + 1
                }
                out[token * hiddenSize + head * headDim + d] = value
                d = d + 1
            }
            head = head + 1
        }
        token = token + 1
    }
    return out
}

fun attentionScore(q: Array<Float>, k: Array<Float>, queryRow: Int, keyRow: Int, head: Int, headDim: Int, hiddenSize: Int) r: Float {
    var sum = 0.0
    var d = 0
    while d < headDim {
        let col = head * headDim + d
        sum = sum + flatAt(q, queryRow, col, hiddenSize) * flatAt(k, keyRow, col, hiddenSize)
        d = d + 1
    }
    return sum
}

fun residualLayerNorm(values: Array<Float>, residual: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: EmbeddingTensorLoad, normBias: EmbeddingTensorLoad) r: Array<Float> {
    return residualLayerNormValues(values, residual, seqLen, hiddenSize, normWeight.values, normBias.values)
}

fun residualLayerNormBackend(values: Array<Float>, residual: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: EmbeddingTensorLoad, normBias: EmbeddingTensorLoad, backend: String) r: Array<Float> {
    return residualLayerNormValuesBackend(values, residual, seqLen, hiddenSize, normWeight.values, normBias.values, backend)
}

fun residualLayerNormValues(values: Array<Float>, residual: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: Array<Float>, normBias: Array<Float>) r: Array<Float> {
    return residualLayerNormValuesBackend(values, residual, seqLen, hiddenSize, normWeight, normBias, "cpu")
}

fun residualLayerNormValuesBackend(values: Array<Float>, residual: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: Array<Float>, normBias: Array<Float>, backend: String) r: Array<Float> {
    if miniLMBackendIsGpu(backend) {
        let merged = addFlatRows(values, residual, seqLen, hiddenSize)
        let normed = layerNormRowsBackend(merged, seqLen, hiddenSize, normWeight, normBias, backend)
        if normed.length() == seqLen * hiddenSize {
            releaseFloatArrayStorage(merged)
            return normed
        }
        releaseFloatArrayStorage(merged)
        releaseFloatArrayStorage(normed)
    }
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let merged = Array<Float>()
        var d = 0
        while d < hiddenSize {
            merged.push(flatAt(values, row, d, hiddenSize) + flatAt(residual, row, d, hiddenSize))
            d = d + 1
        }
        let normed = embeddingLayerNorm(merged, normWeight, normBias)
        d = 0
        while d < hiddenSize {
            out.push(normed[d])
            d = d + 1
        }
        releaseFloatArrayStorage(merged)
        releaseFloatArrayStorage(normed)
        row = row + 1
    }
    return out
}

fun feedForwardIntermediate(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad) r: Array<Float> {
    return feedForwardIntermediateWithDenseDelta(sequence, seqLen, hiddenSize, intermediateSize, weight, bias, DenseDeltaAdapter.identity(0, 0), false)
}

fun feedForwardIntermediateWithDenseDelta(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, intermediateDelta: DenseDeltaAdapter, applyDelta: Bool) r: Array<Float> {
    let pre = feedForwardPreActivationWithDenseDelta(sequence, seqLen, hiddenSize, intermediateSize, weight, bias, intermediateDelta, applyDelta)
    return geluFlat(pre)
}

fun feedForwardIntermediateWithDenseDeltaBackend(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, intermediateDelta: DenseDeltaAdapter, applyDelta: Bool, backend: String) r: Array<Float> {
    let pre = feedForwardPreActivationWithDenseDeltaBackend(sequence, seqLen, hiddenSize, intermediateSize, weight, bias, intermediateDelta, applyDelta, backend)
    return geluFlat(pre)
}

fun feedForwardPreActivationWithDenseDelta(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, intermediateDelta: DenseDeltaAdapter, applyDelta: Bool) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, hiddenSize)
        let projected = linearVector(input, weight, bias)
        let delta = if applyDelta { intermediateDelta.apply(input) } else { denseZeros(intermediateSize) }
        var i = 0
        while i < intermediateSize and i < projected.length() {
            var value = projected[i]
            if i < delta.length() {
                value = value + delta[i]
            }
            out.push(value)
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(projected)
        releaseFloatArrayStorage(delta)
        row = row + 1
    }
    return out
}

fun feedForwardPreActivationWithDenseDeltaBackend(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, intermediateDelta: DenseDeltaAdapter, applyDelta: Bool, backend: String) r: Array<Float> {
    return projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, intermediateSize, weight, bias, intermediateDelta, applyDelta, backend)
}

fun feedForwardOutput(sequence: Array<Float>, seqLen: Int, intermediateSize: Int, hiddenSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad) r: Array<Float> {
    return feedForwardOutputWithDenseAdapter(sequence, seqLen, intermediateSize, hiddenSize, weight, bias, DenseLoRAAdapter.identity(0, 0), DenseDeltaAdapter.identity(0, 0), false)
}

fun feedForwardOutputWithDenseAdapter(sequence: Array<Float>, seqLen: Int, intermediateSize: Int, hiddenSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, applyDenseAdapter: Bool) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, intermediateSize)
        let projected = linearVector(input, weight, bias)
        let delta = if applyDenseAdapter { denseAdapter.apply(input) } else { denseZeros(hiddenSize) }
        let fullDelta = if applyDenseAdapter { denseDelta.apply(input) } else { denseZeros(hiddenSize) }
        var i = 0
        while i < hiddenSize and i < projected.length() {
            var value = projected[i]
            if i < delta.length() {
                value = value + delta[i]
            }
            if i < fullDelta.length() {
                value = value + fullDelta[i]
            }
            out.push(value)
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(projected)
        releaseFloatArrayStorage(delta)
        releaseFloatArrayStorage(fullDelta)
        row = row + 1
    }
    return out
}

fun feedForwardOutputWithDenseAdapterBackend(sequence: Array<Float>, seqLen: Int, intermediateSize: Int, hiddenSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, applyDenseAdapter: Bool, backend: String) r: Array<Float> {
    let projected = projectSequenceLinearBackend(sequence, seqLen, intermediateSize, hiddenSize, weight, bias, backend)
    if projected.length() != seqLen * hiddenSize {
        releaseFloatArrayStorage(projected)
        return feedForwardOutputWithDenseAdapter(sequence, seqLen, intermediateSize, hiddenSize, weight, bias, denseAdapter, denseDelta, applyDenseAdapter)
    }
    if not applyDenseAdapter {
        return projected
    }
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, intermediateSize)
        let delta = denseAdapter.apply(input)
        let fullDelta = denseDelta.apply(input)
        var i = 0
        while i < hiddenSize {
            var value = flatAt(projected, row, i, hiddenSize)
            if i < delta.length() {
                value = value + delta[i]
            }
            if i < fullDelta.length() {
                value = value + fullDelta[i]
            }
            out.push(value)
            i = i + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(delta)
        releaseFloatArrayStorage(fullDelta)
        row = row + 1
    }
    releaseFloatArrayStorage(projected)
    return out
}

fun denseAdapterTrace(cache: MiniLMForwardCache, info: SafeTensorInfo, tokenIds: Array<Int>, mask: Array<Int>, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, readyLayers: Int, targetLayer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, backend: String) r: MiniLMDenseTrace {
    if targetLayer < 0 or targetLayer >= readyLayers {
        return MiniLMDenseTrace.failure()
    }
    let word = wordEmbeddingTensorForTokens(cache, info, tokenIds, mask, maxLoadElements)
    if not word.ok { return MiniLMDenseTrace.failure() }
    let position = cachedEmbeddingTensor(cache, info, "embeddings.position_embeddings.weight", maxLoadElements)
    if not position.ok { return MiniLMDenseTrace.failure() }
    let tokenType = cachedEmbeddingTensor(cache, info, "embeddings.token_type_embeddings.weight", maxLoadElements)
    if not tokenType.ok { return MiniLMDenseTrace.failure() }
    let normWeight = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.weight", maxLoadElements)
    if not normWeight.ok { return MiniLMDenseTrace.failure() }
    let normBias = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.bias", maxLoadElements)
    if not normBias.ok { return MiniLMDenseTrace.failure() }

    let sequence = Array<Float>()
    var tokenCount = 0
    var i = 0
    while i < tokenIds.length() and i < mask.length() {
        if mask[i] == 1 {
            tokenCount = tokenCount + 1
            let embedded = encodeTokenWithTables(tokenIds[i], i, hiddenSize, word, position, tokenType, normWeight, normBias)
            var d = 0
            while d < hiddenSize {
                sequence.push(embedded[d])
                d = d + 1
            }
        }
        i = i + 1
    }
    if tokenCount == 0 {
        return MiniLMDenseTrace.failure()
    }

    var encoded = sequence
    var layer = 0
    while layer < targetLayer {
        let layerOut = applyEncoderLayerMaybeCachedBase(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        if layerOut.length() != encoded.length() {
            return MiniLMDenseTrace.failure()
        }
        encoded = layerOut
        layer = layer + 1
    }
    let targetTrace = applyFinalDenseTraceMaybeCached(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, targetLayer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, backend)
    if not targetTrace.ok {
        return targetTrace
    }
    var tail = targetTrace.outputSequence
    layer = targetLayer + 1
    while layer < readyLayers {
        let layerOut = applyEncoderLayerMaybeCachedBase(cache, info, tail, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        if layerOut.length() != tail.length() {
            return MiniLMDenseTrace.failure()
        }
        tail = layerOut
        layer = layer + 1
    }
    let finalMean = meanPoolFlat(tail, tokenCount, hiddenSize)
    return MiniLMDenseTrace.success(targetTrace.seqLen, targetTrace.inputDim, targetTrace.hiddenSize, targetTrace.intermediateInput, targetTrace.intermediatePreActivation, targetTrace.ffInput, targetTrace.attentionSequenceInput, targetTrace.attentionQ, targetTrace.attentionK, targetTrace.attentionV, targetTrace.attentionContext, targetTrace.attentionOutputDenseWeight, targetTrace.attentionLayerNormInput, targetTrace.attentionNormWeight, targetTrace.intermediateDenseWeight, targetTrace.layerNormInput, targetTrace.normWeight, targetTrace.normBias, targetTrace.outputDenseWeight, targetTrace.outputSequence, finalMean)
}

fun denseAdapterTraceWithLayerDeltas(cache: MiniLMForwardCache, info: SafeTensorInfo, tokenIds: Array<Int>, mask: Array<Int>, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, readyLayers: Int, targetLayer: Int, layerDeltas: MiniLMLayerDeltas, embeddingDeltas: MiniLMEmbeddingDeltas, backend: String) r: MiniLMDenseTrace {
    if targetLayer < 0 or targetLayer >= readyLayers or not layerDeltas.hasLayer(targetLayer) {
        return MiniLMDenseTrace.failure()
    }
    let word = wordEmbeddingTensorForTokens(cache, info, tokenIds, mask, maxLoadElements)
    if not word.ok { return MiniLMDenseTrace.failure() }
    let position = cachedEmbeddingTensor(cache, info, "embeddings.position_embeddings.weight", maxLoadElements)
    if not position.ok { return MiniLMDenseTrace.failure() }
    let tokenType = cachedEmbeddingTensor(cache, info, "embeddings.token_type_embeddings.weight", maxLoadElements)
    if not tokenType.ok { return MiniLMDenseTrace.failure() }
    let normWeight = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.weight", maxLoadElements)
    if not normWeight.ok { return MiniLMDenseTrace.failure() }
    let normBias = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.bias", maxLoadElements)
    if not normBias.ok { return MiniLMDenseTrace.failure() }

    let sequence = Array<Float>()
    var tokenCount = 0
    var i = 0
    while i < tokenIds.length() and i < mask.length() {
        if mask[i] == 1 {
            tokenCount = tokenCount + 1
            let embedded = encodeTokenWithEmbeddingDeltas(tokenIds[i], i, hiddenSize, word, position, tokenType, normWeight, normBias, embeddingDeltas)
            var d = 0
            while d < hiddenSize {
                sequence.push(embedded[d])
                d = d + 1
            }
        }
        i = i + 1
    }
    if tokenCount == 0 {
        return MiniLMDenseTrace.failure()
    }

    var encoded = sequence
    var layer = 0
    while layer < targetLayer {
        var layerOut = Array<Float>()
        if layerDeltas.hasLayer(layer) {
            layerOut = applyEncoderLayerMaybeCached(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), layerDeltas.outputDeltas[layer], layerDeltas.intermediateDeltas[layer], layerDeltas.queryDeltas[layer], layerDeltas.keyDeltas[layer], layerDeltas.valueDeltas[layer], layerDeltas.attentionDenseDeltas[layer], layerDeltas.attentionLayerNormDeltas[layer], layerDeltas.outputLayerNormDeltas[layer], true, backend)
        } else {
            layerOut = applyEncoderLayerMaybeCachedBase(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        }
        if layerOut.length() != encoded.length() {
            return MiniLMDenseTrace.failure()
        }
        encoded = layerOut
        layer = layer + 1
    }
    let targetTrace = applyFinalDenseTraceMaybeCached(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, targetLayer, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), layerDeltas.outputDeltas[targetLayer], layerDeltas.intermediateDeltas[targetLayer], layerDeltas.queryDeltas[targetLayer], layerDeltas.keyDeltas[targetLayer], layerDeltas.valueDeltas[targetLayer], layerDeltas.attentionDenseDeltas[targetLayer], layerDeltas.attentionLayerNormDeltas[targetLayer], layerDeltas.outputLayerNormDeltas[targetLayer], backend)
    if not targetTrace.ok {
        return targetTrace
    }
    var tail = targetTrace.outputSequence
    layer = targetLayer + 1
    while layer < readyLayers {
        var layerOut = Array<Float>()
        if layerDeltas.hasLayer(layer) {
            layerOut = applyEncoderLayerMaybeCached(cache, info, tail, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), layerDeltas.outputDeltas[layer], layerDeltas.intermediateDeltas[layer], layerDeltas.queryDeltas[layer], layerDeltas.keyDeltas[layer], layerDeltas.valueDeltas[layer], layerDeltas.attentionDenseDeltas[layer], layerDeltas.attentionLayerNormDeltas[layer], layerDeltas.outputLayerNormDeltas[layer], true, backend)
        } else {
            layerOut = applyEncoderLayerMaybeCachedBase(cache, info, tail, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        }
        if layerOut.length() != tail.length() {
            return MiniLMDenseTrace.failure()
        }
        tail = layerOut
        layer = layer + 1
    }
    let finalMean = meanPoolFlat(tail, tokenCount, hiddenSize)
    return MiniLMDenseTrace.success(targetTrace.seqLen, targetTrace.inputDim, targetTrace.hiddenSize, targetTrace.intermediateInput, targetTrace.intermediatePreActivation, targetTrace.ffInput, targetTrace.attentionSequenceInput, targetTrace.attentionQ, targetTrace.attentionK, targetTrace.attentionV, targetTrace.attentionContext, targetTrace.attentionOutputDenseWeight, targetTrace.attentionLayerNormInput, targetTrace.attentionNormWeight, targetTrace.intermediateDenseWeight, targetTrace.layerNormInput, targetTrace.normWeight, targetTrace.normBias, targetTrace.outputDenseWeight, targetTrace.outputSequence, finalMean)
}

fun embeddingDeltaTrace(cache: MiniLMForwardCache, info: SafeTensorInfo, tokenIds: Array<Int>, mask: Array<Int>, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, readyLayers: Int, embeddingDeltas: MiniLMEmbeddingDeltas, layerDeltas: MiniLMLayerDeltas, backend: String) r: MiniLMEmbeddingTrace {
    let word = wordEmbeddingTensorForTokens(cache, info, tokenIds, mask, maxLoadElements)
    if not word.ok { return MiniLMEmbeddingTrace.failure() }
    let position = cachedEmbeddingTensor(cache, info, "embeddings.position_embeddings.weight", maxLoadElements)
    if not position.ok { return MiniLMEmbeddingTrace.failure() }
    let tokenType = cachedEmbeddingTensor(cache, info, "embeddings.token_type_embeddings.weight", maxLoadElements)
    if not tokenType.ok { return MiniLMEmbeddingTrace.failure() }
    let normWeight = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.weight", maxLoadElements)
    if not normWeight.ok { return MiniLMEmbeddingTrace.failure() }
    let normBias = cachedEmbeddingTensor(cache, info, "embeddings.LayerNorm.bias", maxLoadElements)
    if not normBias.ok { return MiniLMEmbeddingTrace.failure() }

    let rawSequence = Array<Float>()
    let outputSequence = Array<Float>()
    let wordRows = Array<Int>()
    let positionRows = Array<Int>()
    let tokenTypeRows = Array<Int>()
    var tokenCount = 0
    var i = 0
    while i < tokenIds.length() and i < mask.length() {
        if mask[i] == 1 {
            tokenCount = tokenCount + 1
            let wordRow = positiveMod(tokenIds[i], word.rows)
            let posRow = positiveMod(i, position.rows)
            let typeRow = 0
            wordRows.push(wordRow)
            positionRows.push(posRow)
            tokenTypeRows.push(typeRow)
            let raw = encodeTokenRawWithEmbeddingDeltas(tokenIds[i], i, hiddenSize, word, position, tokenType, embeddingDeltas)
            let embedded = embeddingLayerNormWithEmbeddingDeltas(raw, normWeight.values, normBias.values, embeddingDeltas)
            var d = 0
            while d < hiddenSize {
                rawSequence.push(raw[d])
                outputSequence.push(embedded[d])
                d = d + 1
            }
        }
        i = i + 1
    }
    if tokenCount == 0 {
        return MiniLMEmbeddingTrace.failure()
    }

    var encoded = outputSequence
    var layer = 0
    while layer < readyLayers {
        var layerOut = Array<Float>()
        if layerDeltas.hasLayer(layer) {
            layerOut = applyEncoderLayerMaybeCached(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), layerDeltas.outputDeltas[layer], layerDeltas.intermediateDeltas[layer], layerDeltas.queryDeltas[layer], layerDeltas.keyDeltas[layer], layerDeltas.valueDeltas[layer], layerDeltas.attentionDenseDeltas[layer], layerDeltas.attentionLayerNormDeltas[layer], layerDeltas.outputLayerNormDeltas[layer], true, backend)
        } else {
            layerOut = applyEncoderLayerMaybeCachedBase(cache, info, encoded, tokenCount, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        }
        if layerOut.length() != encoded.length() {
            return MiniLMEmbeddingTrace.failure()
        }
        encoded = layerOut
        layer = layer + 1
    }
    return MiniLMEmbeddingTrace.success(tokenCount, hiddenSize, rawSequence, outputSequence, wordRows, positionRows, tokenTypeRows, meanPoolFlat(encoded, tokenCount, hiddenSize))
}

fun applyFinalDenseTrace(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, backend: String) r: MiniLMDenseTrace {
    let layerCache = MiniLMEncoderLayerCache.load(info, layer, maxLoadElements)
    let result = applyFinalDenseTraceCached(layerCache, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, backend)
    releaseMiniLMEncoderLayerCacheStorage(layerCache)
    return result
}

fun applyFinalDenseTraceMaybeCached(cache: MiniLMForwardCache, info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, backend: String) r: MiniLMDenseTrace {
    if cache.hasLayer(layer) {
        return applyFinalDenseTraceCached(cache.layerAt(layer), sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, backend)
    }
    return applyFinalDenseTrace(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, backend)
}

fun applyFinalDenseTraceCached(layerCache: MiniLMEncoderLayerCache, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, backend: String) r: MiniLMDenseTrace {
    if not layerCache.ok {
        return MiniLMDenseTrace.failure()
    }
    let qWeight = layerCache.qWeight
    let qBias = layerCache.qBias
    let kWeight = layerCache.kWeight
    let kBias = layerCache.kBias
    let vWeight = layerCache.vWeight
    let vBias = layerCache.vBias
    let attnOutWeight = layerCache.attentionOutputWeight
    let attnOutBias = layerCache.attentionOutputBias
    let attnLnWeight = layerCache.attentionNormWeight
    let attnLnBias = layerCache.attentionNormBias
    let intermediateWeight = layerCache.intermediateWeight
    let intermediateBias = layerCache.intermediateBias
    let outputWeight = layerCache.outputWeight
    let outputBias = layerCache.outputBias
    let outputLnWeight = layerCache.outputNormWeight
    let outputLnBias = layerCache.outputNormBias

    let q = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, qWeight, qBias, queryDelta, true, backend)
    let k = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, kWeight, kBias, keyDelta, true, backend)
    let v = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, vWeight, vBias, valueDelta, true, backend)
    let context = attentionContextBackend(q, k, v, seqLen, hiddenSize, attentionHeads, backend)
    if context.length() != sequence.length() {
        return MiniLMDenseTrace.failure()
    }
    let attnDense = projectSequenceWithDenseDeltaBackend(context, seqLen, hiddenSize, hiddenSize, attnOutWeight, attnOutBias, attentionDenseDelta, true, backend)
    let attnLnInput = addFlatRows(attnDense, sequence, seqLen, hiddenSize)
    let effectiveAttnWeight = layerNormDeltaEffectiveWeight(attnLnWeight.values, attentionLayerNormDelta)
    let effectiveAttnBias = layerNormDeltaEffectiveBias(attnLnBias.values, attentionLayerNormDelta)
    let attnNorm = layerNormRowsBackend(attnLnInput, seqLen, hiddenSize, effectiveAttnWeight, effectiveAttnBias, backend)
    let interPre = feedForwardPreActivationWithDenseDeltaBackend(attnNorm, seqLen, hiddenSize, intermediateSize, intermediateWeight, intermediateBias, intermediateDelta, true, backend)
    let ffIntermediate = geluFlat(interPre)
    let ffOutput = feedForwardOutputWithDenseAdapterBackend(ffIntermediate, seqLen, intermediateSize, hiddenSize, outputWeight, outputBias, denseAdapter, denseDelta, true, backend)
    let lnInput = addFlatRows(ffOutput, attnNorm, seqLen, hiddenSize)
    let effectiveWeight = layerNormDelta.effectiveWeight(outputLnWeight.values)
    let effectiveBias = layerNormDelta.effectiveBias(outputLnBias.values)
    let output = layerNormRowsBackend(lnInput, seqLen, hiddenSize, effectiveWeight, effectiveBias, backend)
    return MiniLMDenseTrace.success(seqLen, intermediateSize, hiddenSize, attnNorm, interPre, ffIntermediate, sequence, q, k, v, context, attnOutWeight.values, attnLnInput, effectiveAttnWeight, intermediateWeight.values, lnInput, effectiveWeight, effectiveBias, outputWeight.values, output, meanPoolFlat(output, seqLen, hiddenSize))
}

fun meanPoolFlat(sequence: Array<Float>, seqLen: Int, hiddenSize: Int) r: Array<Float> {
    let out = zerosFloat(hiddenSize)
    if seqLen <= 0 {
        return out
    }
    var row = 0
    while row < seqLen {
        var d = 0
        while d < hiddenSize {
            out[d] = out[d] + flatAt(sequence, row, d, hiddenSize)
            d = d + 1
        }
        row = row + 1
    }
    var i = 0
    while i < hiddenSize {
        out[i] = out[i] / seqLen.toFloat()
        i = i + 1
    }
    return out
}

fun addFlatRows(a: Array<Float>, b: Array<Float>, seqLen: Int, hiddenSize: Int) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    let total = seqLen * hiddenSize
    while i < total {
        var value = 0.0
        if i < a.length() {
            value = value + a[i]
        }
        if i < b.length() {
            value = value + b[i]
        }
        out.push(value)
        i = i + 1
    }
    return out
}

fun layerNormRows(values: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: Array<Float>, normBias: Array<Float>) r: Array<Float> {
    return layerNormRowsBackend(values, seqLen, hiddenSize, normWeight, normBias, "cpu")
}

fun layerNormRowsBackend(values: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: Array<Float>, normBias: Array<Float>, backend: String) r: Array<Float> {
    if miniLMBackendIsGpu(backend) and seqLen > 0 and hiddenSize > 0 and values.length() >= seqLen * hiddenSize and normWeight.length() >= hiddenSize and normBias.length() >= hiddenSize {
        let input = Tensor.fromArray(seqLen, hiddenSize, values, backend)
        let normalized = input.layerNormRows()
        if normalized.values.length() == seqLen * hiddenSize {
            let repeatedWeights = repeatLayerNormParameters(normWeight, seqLen, hiddenSize)
            let repeatedBiases = repeatLayerNormParameters(normBias, seqLen, hiddenSize)
            let weights = Tensor.fromArray(seqLen, hiddenSize, repeatedWeights, backend)
            let biases = Tensor.fromArray(seqLen, hiddenSize, repeatedBiases, backend)
            let scaled = normalized.mulElementwise(weights)
            let out = scaled.add(biases)
            if out.values.length() == seqLen * hiddenSize {
                releaseFloatArrayStorage(normalized.values)
                releaseFloatArrayStorage(scaled.values)
                releaseFloatArrayStorage(repeatedWeights)
                releaseFloatArrayStorage(repeatedBiases)
                return out.values
            }
            releaseFloatArrayStorage(out.values)
            releaseFloatArrayStorage(scaled.values)
            releaseFloatArrayStorage(repeatedWeights)
            releaseFloatArrayStorage(repeatedBiases)
        }
        releaseFloatArrayStorage(normalized.values)
    }
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(values, row, hiddenSize)
        let normed = embeddingLayerNorm(input, normWeight, normBias)
        var d = 0
        while d < hiddenSize {
            out.push(normed[d])
            d = d + 1
        }
        releaseFloatArrayStorage(input)
        releaseFloatArrayStorage(normed)
        row = row + 1
    }
    return out
}

fun repeatLayerNormParameters(values: Array<Float>, seqLen: Int, hiddenSize: Int) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        var d = 0
        while d < hiddenSize {
            var value = 0.0
            if d >= 0 and d < values.length() {
                value = values[d]
            }
            out.push(value)
            d = d + 1
        }
        row = row + 1
    }
    return out
}

fun layerNormDeltaEffectiveWeight(base: Array<Float>, delta: LayerNormDeltaAdapter) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < delta.dim {
        var value = 1.0
        if i < base.length() {
            value = base[i]
        }
        if i < delta.weightDelta.length() {
            value = value + delta.weightDelta[i]
        }
        out.push(value)
        i = i + 1
    }
    return out
}

fun layerNormDeltaEffectiveBias(base: Array<Float>, delta: LayerNormDeltaAdapter) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < delta.dim {
        var value = 0.0
        if i < base.length() {
            value = base[i]
        }
        if i < delta.biasDelta.length() {
            value = value + delta.biasDelta[i]
        }
        out.push(value)
        i = i + 1
    }
    return out
}

fun accumulateDenseTraceGradWithTail(info: SafeTensorInfo, trace: MiniLMDenseTrace, gradMean: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, gradA: Array<Float>, gradB: Array<Float>, gradDW: Array<Float>, gradDB: Array<Float>, gradIW: Array<Float>, gradIB: Array<Float>, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, gradADW: Array<Float>, gradADB: Array<Float>, gradALNW: Array<Float>, gradALNB: Array<Float>, gradLNW: Array<Float>, gradLNB: Array<Float>, targetLayer: Int, readyLayers: Int, attentionHeads: Int, maxLoadElements: Int, backend: String) r: Void {
    if targetLayer == readyLayers - 1 {
        accumulateDenseTraceGrad(trace, gradMean, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, attentionHeads, backend)
        return
    }
    if targetLayer < readyLayers - 1 {
        let gradRows = tailInputGradientBackend(info, trace.outputSequence, trace.seqLen, trace.hiddenSize, attentionHeads, trace.inputDim, maxLoadElements, targetLayer + 1, readyLayers, gradMean, backend)
        if gradRows.length() == trace.seqLen * trace.hiddenSize {
            accumulateDenseTraceGradRows(trace, gradRows, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, layerNormDelta, gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, attentionHeads, backend)
        }
    }
}

fun accumulateDenseTraceGradWithLayerDeltaTail(info: SafeTensorInfo, trace: MiniLMDenseTrace, gradMean: Array<Float>, denseAdapter: DenseLoRAAdapter, layerDeltas: MiniLMLayerDeltas, gradA: Array<Float>, gradB: Array<Float>, gradDW: Array<Float>, gradDB: Array<Float>, gradIW: Array<Float>, gradIB: Array<Float>, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, gradADW: Array<Float>, gradADB: Array<Float>, gradALNW: Array<Float>, gradALNB: Array<Float>, gradLNW: Array<Float>, gradLNB: Array<Float>, targetLayer: Int, readyLayers: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, backend: String) r: Void {
    if targetLayer < 0 or targetLayer >= readyLayers or not layerDeltas.hasLayer(targetLayer) {
        return
    }
    if targetLayer == readyLayers - 1 {
        accumulateDenseTraceGrad(trace, gradMean, denseAdapter, layerDeltas.outputDeltas[targetLayer], layerDeltas.intermediateDeltas[targetLayer], layerDeltas.queryDeltas[targetLayer], layerDeltas.keyDeltas[targetLayer], layerDeltas.valueDeltas[targetLayer], layerDeltas.attentionDenseDeltas[targetLayer], layerDeltas.attentionLayerNormDeltas[targetLayer], layerDeltas.outputLayerNormDeltas[targetLayer], gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, attentionHeads, backend)
        return
    }
    let gradRows = tailInputGradientWithLayerDeltasBackend(info, trace.outputSequence, trace.seqLen, trace.hiddenSize, attentionHeads, intermediateSize, maxLoadElements, targetLayer + 1, readyLayers, gradMean, layerDeltas, backend)
    if gradRows.length() == trace.seqLen * trace.hiddenSize {
        accumulateDenseTraceGradRows(trace, gradRows, denseAdapter, layerDeltas.outputDeltas[targetLayer], layerDeltas.intermediateDeltas[targetLayer], layerDeltas.queryDeltas[targetLayer], layerDeltas.keyDeltas[targetLayer], layerDeltas.valueDeltas[targetLayer], layerDeltas.attentionDenseDeltas[targetLayer], layerDeltas.attentionLayerNormDeltas[targetLayer], layerDeltas.outputLayerNormDeltas[targetLayer], gradA, gradB, gradDW, gradDB, gradIW, gradIB, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, gradLNW, gradLNB, attentionHeads, backend)
    }
}

fun accumulateDenseTraceGrad(trace: MiniLMDenseTrace, gradMean: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, gradA: Array<Float>, gradB: Array<Float>, gradDW: Array<Float>, gradDB: Array<Float>, gradIW: Array<Float>, gradIB: Array<Float>, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, gradADW: Array<Float>, gradADB: Array<Float>, gradALNW: Array<Float>, gradALNB: Array<Float>, gradLNW: Array<Float>, gradLNB: Array<Float>, attentionHeads: Int, backend: String) r: Void {
    if not trace.ok or trace.seqLen <= 0 {
        return
    }
    var row = 0
    while row < trace.seqLen {
        let lnInput = rowVector(trace.layerNormInput, row, trace.hiddenSize)
        let gradY = Array<Float>()
        var d = 0
        while d < trace.hiddenSize {
            var value = 0.0
            if d < gradMean.length() {
                value = gradMean[d] / trace.seqLen.toFloat()
            }
            gradY.push(value)
            d = d + 1
        }
        accumulateLayerNormDeltaGrad(lnInput, gradY, layerNormDelta, gradLNW, gradLNB)
        let gradZ = layerNormInputGradient(lnInput, trace.normWeight, gradY)
        let ffInput = rowVector(trace.ffInput, row, trace.inputDim)
        accumulateDenseLoRAGrad(ffInput, gradZ, denseAdapter, gradA, gradB)
        accumulateDenseDeltaGrad(ffInput, gradZ, denseDelta, gradDW, gradDB)
        accumulateIntermediateDeltaGradFromOutput(trace, row, gradZ, denseAdapter, denseDelta, intermediateDelta, gradIW, gradIB, backend)
        accumulateAttentionDeltaGradFromOutput(trace, row, gradZ, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, attentionHeads, backend)
        row = row + 1
    }
}

fun accumulateDenseTraceGradRows(trace: MiniLMDenseTrace, gradRows: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, layerNormDelta: LayerNormDeltaAdapter, gradA: Array<Float>, gradB: Array<Float>, gradDW: Array<Float>, gradDB: Array<Float>, gradIW: Array<Float>, gradIB: Array<Float>, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, gradADW: Array<Float>, gradADB: Array<Float>, gradALNW: Array<Float>, gradALNB: Array<Float>, gradLNW: Array<Float>, gradLNB: Array<Float>, attentionHeads: Int, backend: String) r: Void {
    if not trace.ok or trace.seqLen <= 0 {
        return
    }
    var row = 0
    while row < trace.seqLen {
        let lnInput = rowVector(trace.layerNormInput, row, trace.hiddenSize)
        let gradY = rowVector(gradRows, row, trace.hiddenSize)
        accumulateLayerNormDeltaGrad(lnInput, gradY, layerNormDelta, gradLNW, gradLNB)
        let gradZ = layerNormInputGradient(lnInput, trace.normWeight, gradY)
        let ffInput = rowVector(trace.ffInput, row, trace.inputDim)
        accumulateDenseLoRAGrad(ffInput, gradZ, denseAdapter, gradA, gradB)
        accumulateDenseDeltaGrad(ffInput, gradZ, denseDelta, gradDW, gradDB)
        accumulateIntermediateDeltaGradFromOutput(trace, row, gradZ, denseAdapter, denseDelta, intermediateDelta, gradIW, gradIB, backend)
        accumulateAttentionDeltaGradFromOutput(trace, row, gradZ, denseAdapter, denseDelta, intermediateDelta, queryDelta, keyDelta, valueDelta, attentionDenseDelta, attentionLayerNormDelta, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, gradADW, gradADB, gradALNW, gradALNB, attentionHeads, backend)
        row = row + 1
    }
}

fun accumulateEmbeddingTraceGrad(info: SafeTensorInfo, trace: MiniLMEmbeddingTrace, gradMean: Array<Float>, embeddingDeltas: MiniLMEmbeddingDeltas, layerDeltas: MiniLMLayerDeltas, gradWordRows: Array<Int>, gradWord: Array<Float>, gradPositionRows: Array<Int>, gradPosition: Array<Float>, gradTokenTypeRows: Array<Int>, gradTokenType: Array<Float>, gradLnW: Array<Float>, gradLnB: Array<Float>, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, readyLayers: Int, backend: String) r: Void {
    if not trace.ok or trace.seqLen <= 0 {
        return
    }
    var gradRows = Array<Float>()
    if readyLayers > 0 {
        gradRows = tailInputGradientWithLayerDeltasBackend(info, trace.outputSequence, trace.seqLen, trace.hiddenSize, attentionHeads, intermediateSize, maxLoadElements, 0, readyLayers, gradMean, layerDeltas, backend)
    } else {
        gradRows = meanGradRows(gradMean, trace.seqLen, trace.hiddenSize)
    }
    if gradRows.length() != trace.seqLen * trace.hiddenSize {
        return
    }
    let effectiveWeight = embeddingDeltas.effectiveLayerNormWeight(embeddingLoadNormWeight(info, maxLoadElements))
    var row = 0
    while row < trace.seqLen {
        let raw = rowVector(trace.rawSequence, row, trace.hiddenSize)
        let gradOut = rowVector(gradRows, row, trace.hiddenSize)
        accumulateEmbeddingLayerNormDeltaGrad(raw, gradOut, gradLnW, gradLnB)
        let gradRaw = layerNormInputGradient(raw, effectiveWeight, gradOut)
        if row < trace.wordRows.length() {
            addEmbeddingSparseGrad(gradWordRows, gradWord, trace.wordRows[row], gradRaw, trace.hiddenSize)
        }
        if row < trace.positionRows.length() {
            addEmbeddingSparseGrad(gradPositionRows, gradPosition, trace.positionRows[row], gradRaw, trace.hiddenSize)
        }
        if row < trace.tokenTypeRows.length() {
            addEmbeddingSparseGrad(gradTokenTypeRows, gradTokenType, trace.tokenTypeRows[row], gradRaw, trace.hiddenSize)
        }
        row = row + 1
    }
}

fun embeddingLoadNormWeight(info: SafeTensorInfo, maxLoadElements: Int) r: Array<Float> {
    let normWeight = loadEmbeddingTensor(info, "embeddings.LayerNorm.weight", maxLoadElements)
    if normWeight.ok {
        return normWeight.values
    }
    return Array<Float>()
}

fun addEmbeddingSparseGrad(rowIds: Array<Int>, values: Array<Float>, row: Int, grad: Array<Float>, hiddenSize: Int) r: Void {
    var slot = -1
    var i = 0
    while i < rowIds.length() {
        if rowIds[i] == row {
            slot = i
        }
        i = i + 1
    }
    if slot < 0 {
        rowIds.push(row)
        var d = 0
        while d < hiddenSize {
            values.push(0.0)
            d = d + 1
        }
        slot = rowIds.length() - 1
    }
    var d = 0
    while d < hiddenSize and d < grad.length() {
        values[slot * hiddenSize + d] = values[slot * hiddenSize + d] + grad[d]
        d = d + 1
    }
}

fun accumulateEmbeddingLayerNormDeltaGrad(values: Array<Float>, gradOut: Array<Float>, gradWeight: Array<Float>, gradBias: Array<Float>) r: Void {
    var mean = 0.0
    var i = 0
    while i < values.length() {
        mean = mean + values[i]
        i = i + 1
    }
    if values.length() > 0 {
        mean = mean / values.length().toFloat()
    }
    var variance = 0.0
    i = 0
    while i < values.length() {
        let centered = values[i] - mean
        variance = variance + centered * centered
        i = i + 1
    }
    if values.length() > 0 {
        variance = variance / values.length().toFloat()
    }
    let denom = sqrt(variance + 0.000000000001)
    i = 0
    while i < values.length() and i < gradOut.length() and i < gradWeight.length() and i < gradBias.length() {
        let normed = (values[i] - mean) / denom
        gradWeight[i] = gradWeight[i] + gradOut[i] * normed
        gradBias[i] = gradBias[i] + gradOut[i]
        i = i + 1
    }
}

fun tailInputGradient(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, readyLayers: Int, gradMean: Array<Float>) r: Array<Float> {
    return tailInputGradientBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, readyLayers, gradMean, "cpu")
}

fun tailInputGradientBackend(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, readyLayers: Int, gradMean: Array<Float>, backend: String) r: Array<Float> {
    if startLayer >= readyLayers {
        return meanGradRows(gradMean, seqLen, hiddenSize)
    }
    var gradRows = meanGradRows(gradMean, seqLen, hiddenSize)
    var layer = readyLayers - 1
    while layer >= startLayer {
        let layerInput = tailLayerInputSequenceBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, layer, backend)
        if layerInput.length() != startSequence.length() {
            return Array<Float>()
        }
        gradRows = transformerLayerInputGradientBackend(info, layerInput, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, gradRows, backend)
        if gradRows.length() != startSequence.length() {
            return Array<Float>()
        }
        layer = layer - 1
    }
    return gradRows
}

fun tailInputGradientWithLayerDeltas(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, readyLayers: Int, gradMean: Array<Float>, layerDeltas: MiniLMLayerDeltas) r: Array<Float> {
    return tailInputGradientWithLayerDeltasBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, readyLayers, gradMean, layerDeltas, "cpu")
}

fun tailInputGradientWithLayerDeltasBackend(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, readyLayers: Int, gradMean: Array<Float>, layerDeltas: MiniLMLayerDeltas, backend: String) r: Array<Float> {
    if startLayer >= readyLayers {
        return meanGradRows(gradMean, seqLen, hiddenSize)
    }
    var gradRows = meanGradRows(gradMean, seqLen, hiddenSize)
    var layer = readyLayers - 1
    while layer >= startLayer {
        let layerInput = tailLayerInputSequenceWithLayerDeltasBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, layer, layerDeltas, backend)
        if layerInput.length() != startSequence.length() {
            return Array<Float>()
        }
        gradRows = transformerLayerInputGradientWithLayerDeltasBackend(info, layerInput, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, gradRows, layerDeltas, backend)
        if gradRows.length() != startSequence.length() {
            return Array<Float>()
        }
        layer = layer - 1
    }
    return gradRows
}

fun tailLayerInputSequence(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, endLayer: Int) r: Array<Float> {
    return tailLayerInputSequenceBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, endLayer, "cpu")
}

fun tailLayerInputSequenceBackend(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, endLayer: Int, backend: String) r: Array<Float> {
    var out = startSequence
    var layer = startLayer
    while layer < endLayer {
        let layerOut = applyEncoderLayerBackend(info, out, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        if layerOut.length() != out.length() {
            return Array<Float>()
        }
        out = layerOut
        layer = layer + 1
    }
    return out
}

fun tailLayerInputSequenceWithLayerDeltas(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, endLayer: Int, layerDeltas: MiniLMLayerDeltas) r: Array<Float> {
    return tailLayerInputSequenceWithLayerDeltasBackend(info, startSequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, startLayer, endLayer, layerDeltas, "cpu")
}

fun tailLayerInputSequenceWithLayerDeltasBackend(info: SafeTensorInfo, startSequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, startLayer: Int, endLayer: Int, layerDeltas: MiniLMLayerDeltas, backend: String) r: Array<Float> {
    var out = startSequence
    var layer = startLayer
    while layer < endLayer {
        var layerOut = Array<Float>()
        if layerDeltas.hasLayer(layer) {
            layerOut = applyEncoderLayerWithDenseAdapterBackend(info, out, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), layerDeltas.outputDeltas[layer], layerDeltas.intermediateDeltas[layer], layerDeltas.queryDeltas[layer], layerDeltas.keyDeltas[layer], layerDeltas.valueDeltas[layer], layerDeltas.attentionDenseDeltas[layer], layerDeltas.attentionLayerNormDeltas[layer], layerDeltas.outputLayerNormDeltas[layer], true, backend)
        } else {
            layerOut = applyEncoderLayerBackend(info, out, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, backend)
        }
        if layerOut.length() != out.length() {
            return Array<Float>()
        }
        out = layerOut
        layer = layer + 1
    }
    return out
}

fun transformerLayerInputGradient(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, gradRows: Array<Float>) r: Array<Float> {
    return transformerLayerInputGradientBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, gradRows, "cpu")
}

fun transformerLayerInputGradientBackend(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, gradRows: Array<Float>, backend: String) r: Array<Float> {
    let prefix = "encoder.layer." + layer.toString() + "."
    let qWeight = loadEmbeddingTensor(info, prefix + "attention.self.query.weight", maxLoadElements)
    let qBias = loadEmbeddingTensor(info, prefix + "attention.self.query.bias", maxLoadElements)
    let kWeight = loadEmbeddingTensor(info, prefix + "attention.self.key.weight", maxLoadElements)
    let kBias = loadEmbeddingTensor(info, prefix + "attention.self.key.bias", maxLoadElements)
    let vWeight = loadEmbeddingTensor(info, prefix + "attention.self.value.weight", maxLoadElements)
    let vBias = loadEmbeddingTensor(info, prefix + "attention.self.value.bias", maxLoadElements)
    let attnOutWeight = loadEmbeddingTensor(info, prefix + "attention.output.dense.weight", maxLoadElements)
    let attnOutBias = loadEmbeddingTensor(info, prefix + "attention.output.dense.bias", maxLoadElements)
    let attnLnWeight = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.weight", maxLoadElements)
    let attnLnBias = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.bias", maxLoadElements)
    let intermediateWeight = loadEmbeddingTensor(info, prefix + "intermediate.dense.weight", maxLoadElements)
    let intermediateBias = loadEmbeddingTensor(info, prefix + "intermediate.dense.bias", maxLoadElements)
    let outputWeight = loadEmbeddingTensor(info, prefix + "output.dense.weight", maxLoadElements)
    let outputBias = loadEmbeddingTensor(info, prefix + "output.dense.bias", maxLoadElements)
    let outputLnWeight = loadEmbeddingTensor(info, prefix + "output.LayerNorm.weight", maxLoadElements)
    let outputLnBias = loadEmbeddingTensor(info, prefix + "output.LayerNorm.bias", maxLoadElements)
    if not qWeight.ok or not qBias.ok or not kWeight.ok or not kBias.ok or not vWeight.ok or not vBias.ok {
        return Array<Float>()
    }
    if not attnOutWeight.ok or not attnOutBias.ok or not attnLnWeight.ok or not attnLnBias.ok {
        return Array<Float>()
    }
    if not intermediateWeight.ok or not intermediateBias.ok or not outputWeight.ok or not outputBias.ok {
        return Array<Float>()
    }
    if not outputLnWeight.ok or not outputLnBias.ok {
        return Array<Float>()
    }

    let q = projectSequenceLinearBackend(sequence, seqLen, hiddenSize, hiddenSize, qWeight, qBias, backend)
    let k = projectSequenceLinearBackend(sequence, seqLen, hiddenSize, hiddenSize, kWeight, kBias, backend)
    let v = projectSequenceLinearBackend(sequence, seqLen, hiddenSize, hiddenSize, vWeight, vBias, backend)
    let context = attentionContextBackend(q, k, v, seqLen, hiddenSize, attentionHeads, backend)
    if context.length() != sequence.length() {
        return Array<Float>()
    }
    let attnDense = projectSequenceLinearBackend(context, seqLen, hiddenSize, hiddenSize, attnOutWeight, attnOutBias, backend)
    let attnLnInput = addFlatRows(attnDense, sequence, seqLen, hiddenSize)
    let attnNorm = layerNormRowsBackend(attnLnInput, seqLen, hiddenSize, attnLnWeight.values, attnLnBias.values, backend)
    let interPre = projectSequenceLinearBackend(attnNorm, seqLen, hiddenSize, intermediateSize, intermediateWeight, intermediateBias, backend)
    let ffIntermediate = geluFlat(interPre)
    let ffOutput = projectSequenceLinearBackend(ffIntermediate, seqLen, intermediateSize, hiddenSize, outputWeight, outputBias, backend)
    let outputLnInput = addFlatRows(ffOutput, attnNorm, seqLen, hiddenSize)

    let gradOutput = gradRows
    let gradOutputLnInput = layerNormRowsInputGradient(outputLnInput, seqLen, hiddenSize, outputLnWeight.values, gradOutput)
    let gradFfIntermediate = projectSequenceInputGradientBackend(gradOutputLnInput, seqLen, intermediateSize, outputWeight, backend)
    let gradInterPre = applyGeluGradientBackend(interPre, gradFfIntermediate, backend)
    let gradAttnNorm = copyFlat(gradOutputLnInput)
    let gradAttnFromIntermediate = projectSequenceInputGradientBackend(gradInterPre, seqLen, hiddenSize, intermediateWeight, backend)
    addFlatInPlace(gradAttnNorm, gradAttnFromIntermediate)
    let gradAttnLnInput = layerNormRowsInputGradient(attnLnInput, seqLen, hiddenSize, attnLnWeight.values, gradAttnNorm)
    let gradSequence = copyFlat(gradAttnLnInput)
    let gradContext = projectSequenceInputGradientBackend(gradAttnLnInput, seqLen, hiddenSize, attnOutWeight, backend)
    let gradAttentionInput = attentionSequenceInputGradientBackend(q, k, v, gradContext, qWeight, kWeight, vWeight, seqLen, hiddenSize, attentionHeads, backend)
    addFlatInPlace(gradSequence, gradAttentionInput)
    return gradSequence
}

fun transformerLayerInputGradientWithLayerDeltas(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, gradRows: Array<Float>, layerDeltas: MiniLMLayerDeltas) r: Array<Float> {
    return transformerLayerInputGradientWithLayerDeltasBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, gradRows, layerDeltas, "cpu")
}

fun transformerLayerInputGradientWithLayerDeltasBackend(info: SafeTensorInfo, sequence: Array<Float>, seqLen: Int, hiddenSize: Int, attentionHeads: Int, intermediateSize: Int, maxLoadElements: Int, layer: Int, gradRows: Array<Float>, layerDeltas: MiniLMLayerDeltas, backend: String) r: Array<Float> {
    if not layerDeltas.hasLayer(layer) {
        return transformerLayerInputGradientBackend(info, sequence, seqLen, hiddenSize, attentionHeads, intermediateSize, maxLoadElements, layer, gradRows, backend)
    }
    let prefix = "encoder.layer." + layer.toString() + "."
    let qWeight = loadEmbeddingTensor(info, prefix + "attention.self.query.weight", maxLoadElements)
    let qBias = loadEmbeddingTensor(info, prefix + "attention.self.query.bias", maxLoadElements)
    let kWeight = loadEmbeddingTensor(info, prefix + "attention.self.key.weight", maxLoadElements)
    let kBias = loadEmbeddingTensor(info, prefix + "attention.self.key.bias", maxLoadElements)
    let vWeight = loadEmbeddingTensor(info, prefix + "attention.self.value.weight", maxLoadElements)
    let vBias = loadEmbeddingTensor(info, prefix + "attention.self.value.bias", maxLoadElements)
    let attnOutWeight = loadEmbeddingTensor(info, prefix + "attention.output.dense.weight", maxLoadElements)
    let attnOutBias = loadEmbeddingTensor(info, prefix + "attention.output.dense.bias", maxLoadElements)
    let attnLnWeight = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.weight", maxLoadElements)
    let attnLnBias = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.bias", maxLoadElements)
    let intermediateWeight = loadEmbeddingTensor(info, prefix + "intermediate.dense.weight", maxLoadElements)
    let intermediateBias = loadEmbeddingTensor(info, prefix + "intermediate.dense.bias", maxLoadElements)
    let outputWeight = loadEmbeddingTensor(info, prefix + "output.dense.weight", maxLoadElements)
    let outputBias = loadEmbeddingTensor(info, prefix + "output.dense.bias", maxLoadElements)
    let outputLnWeight = loadEmbeddingTensor(info, prefix + "output.LayerNorm.weight", maxLoadElements)
    let outputLnBias = loadEmbeddingTensor(info, prefix + "output.LayerNorm.bias", maxLoadElements)
    if not qWeight.ok or not qBias.ok or not kWeight.ok or not kBias.ok or not vWeight.ok or not vBias.ok {
        return Array<Float>()
    }
    if not attnOutWeight.ok or not attnOutBias.ok or not attnLnWeight.ok or not attnLnBias.ok {
        return Array<Float>()
    }
    if not intermediateWeight.ok or not intermediateBias.ok or not outputWeight.ok or not outputBias.ok {
        return Array<Float>()
    }
    if not outputLnWeight.ok or not outputLnBias.ok {
        return Array<Float>()
    }

    let qDelta = layerDeltas.queryDeltas[layer]
    let kDelta = layerDeltas.keyDeltas[layer]
    let vDelta = layerDeltas.valueDeltas[layer]
    let attnDenseDelta = layerDeltas.attentionDenseDeltas[layer]
    let attnLayerNormDelta = layerDeltas.attentionLayerNormDeltas[layer]
    let intermediateDelta = layerDeltas.intermediateDeltas[layer]
    let outputDelta = layerDeltas.outputDeltas[layer]
    let outputLayerNormDelta = layerDeltas.outputLayerNormDeltas[layer]
    let q = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, qWeight, qBias, qDelta, true, backend)
    let k = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, kWeight, kBias, kDelta, true, backend)
    let v = projectSequenceWithDenseDeltaBackend(sequence, seqLen, hiddenSize, hiddenSize, vWeight, vBias, vDelta, true, backend)
    let context = attentionContextBackend(q, k, v, seqLen, hiddenSize, attentionHeads, backend)
    if context.length() != sequence.length() {
        return Array<Float>()
    }
    let attnDense = projectSequenceWithDenseDeltaBackend(context, seqLen, hiddenSize, hiddenSize, attnOutWeight, attnOutBias, attnDenseDelta, true, backend)
    let attnLnInput = addFlatRows(attnDense, sequence, seqLen, hiddenSize)
    let attnWeight = layerNormDeltaEffectiveWeight(attnLnWeight.values, attnLayerNormDelta)
    let attnBias = layerNormDeltaEffectiveBias(attnLnBias.values, attnLayerNormDelta)
    let attnNorm = layerNormRowsBackend(attnLnInput, seqLen, hiddenSize, attnWeight, attnBias, backend)
    let interPre = feedForwardPreActivationWithDenseDeltaBackend(attnNorm, seqLen, hiddenSize, intermediateSize, intermediateWeight, intermediateBias, intermediateDelta, true, backend)
    let ffIntermediate = geluFlat(interPre)
    let ffOutput = feedForwardOutputWithDenseAdapterBackend(ffIntermediate, seqLen, intermediateSize, hiddenSize, outputWeight, outputBias, DenseLoRAAdapter.identity(intermediateSize, hiddenSize), outputDelta, true, backend)
    let outputLnInput = addFlatRows(ffOutput, attnNorm, seqLen, hiddenSize)
    let effectiveOutputLnWeight = outputLayerNormDelta.effectiveWeight(outputLnWeight.values)

    let gradOutputLnInput = layerNormRowsInputGradient(outputLnInput, seqLen, hiddenSize, effectiveOutputLnWeight, gradRows)
    let gradFfIntermediate = projectSequenceInputGradientWithDenseDeltaBackend(gradOutputLnInput, seqLen, intermediateSize, outputWeight, outputDelta, backend)
    let gradInterPre = applyGeluGradientBackend(interPre, gradFfIntermediate, backend)
    let gradAttnNorm = copyFlat(gradOutputLnInput)
    let gradAttnFromIntermediate = projectSequenceInputGradientWithDenseDeltaBackend(gradInterPre, seqLen, hiddenSize, intermediateWeight, intermediateDelta, backend)
    addFlatInPlace(gradAttnNorm, gradAttnFromIntermediate)
    let gradAttnLnInput = layerNormRowsInputGradient(attnLnInput, seqLen, hiddenSize, attnWeight, gradAttnNorm)
    let gradSequence = copyFlat(gradAttnLnInput)
    let gradContext = projectSequenceInputGradientWithDenseDeltaBackend(gradAttnLnInput, seqLen, hiddenSize, attnOutWeight, attnDenseDelta, backend)
    let gradAttentionInput = attentionSequenceInputGradientWithDeltasBackend(q, k, v, gradContext, qWeight, kWeight, vWeight, qDelta, kDelta, vDelta, seqLen, hiddenSize, attentionHeads, backend)
    addFlatInPlace(gradSequence, gradAttentionInput)
    return gradSequence
}

fun feedForwardPreActivation(sequence: Array<Float>, seqLen: Int, hiddenSize: Int, intermediateSize: Int, weight: EmbeddingTensorLoad, bias: EmbeddingTensorLoad) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(sequence, row, hiddenSize)
        let projected = linearVector(input, weight, bias)
        var i = 0
        while i < intermediateSize and i < projected.length() {
            out.push(projected[i])
            i = i + 1
        }
        row = row + 1
    }
    return out
}

fun geluFlat(values: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < values.length() {
        out.push(gelu(values[i]))
        i = i + 1
    }
    return out
}

fun meanGradRows(gradMean: Array<Float>, seqLen: Int, hiddenSize: Int) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        var d = 0
        while d < hiddenSize {
            var value = 0.0
            if d < gradMean.length() and seqLen > 0 {
                value = gradMean[d] / seqLen.toFloat()
            }
            out.push(value)
            d = d + 1
        }
        row = row + 1
    }
    return out
}

fun layerNormRowsInputGradient(values: Array<Float>, seqLen: Int, hiddenSize: Int, normWeight: Array<Float>, gradRows: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        let input = rowVector(values, row, hiddenSize)
        let grad = rowVector(gradRows, row, hiddenSize)
        let gradInput = layerNormInputGradient(input, normWeight, grad)
        var d = 0
        while d < hiddenSize {
            if d < gradInput.length() {
                out.push(gradInput[d])
            } else {
                out.push(0.0)
            }
            d = d + 1
        }
        row = row + 1
    }
    return out
}

fun projectSequenceInputGradient(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad) r: Array<Float> {
    return projectSequenceInputGradientBackend(gradOutput, seqLen, inputSize, weight, "cpu")
}

fun projectSequenceInputGradientBackend(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad, backend: String) r: Array<Float> {
    if seqLen <= 0 or inputSize <= 0 or not weight.ok {
        return Array<Float>()
    }
    if gradOutput.length() < seqLen * weight.rows or weight.values.length() < weight.rows * weight.cols or weight.cols < inputSize {
        return projectSequenceInputGradientScalar(gradOutput, seqLen, inputSize, weight)
    }
    let gradTensor = Tensor.fromArray(seqLen, weight.rows, gradOutput, backend)
    let weightTensor = Tensor.fromArray(weight.rows, inputSize, denseWeightSlice(weight.values, weight.rows, weight.cols, inputSize), backend)
    let gradInput = gradTensor.denseInputGradient(weightTensor)
    if gradInput.values.length() == seqLen * inputSize {
        return gradInput.values
    }
    return projectSequenceInputGradientScalar(gradOutput, seqLen, inputSize, weight)
}

fun projectSequenceInputGradientScalar(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad) r: Array<Float> {
    let out = zerosFloat(seqLen * inputSize)
    var row = 0
    while row < seqLen {
        var i = 0
        while i < inputSize and i < weight.cols {
            var sum = 0.0
            var o = 0
            while o < weight.rows {
                sum = sum + flatAt(gradOutput, row, o, weight.rows) * embeddingAt(weight.values, o, i, weight.cols)
                o = o + 1
            }
            out[row * inputSize + i] = sum
            i = i + 1
        }
        row = row + 1
    }
    return out
}

fun projectSequenceInputGradientWithDenseDelta(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad, delta: DenseDeltaAdapter) r: Array<Float> {
    return projectSequenceInputGradientWithDenseDeltaBackend(gradOutput, seqLen, inputSize, weight, delta, "cpu")
}

fun projectSequenceInputGradientWithDenseDeltaBackend(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad, delta: DenseDeltaAdapter, backend: String) r: Array<Float> {
    if seqLen <= 0 or inputSize <= 0 or not weight.ok {
        return Array<Float>()
    }
    if gradOutput.length() < seqLen * weight.rows or weight.values.length() < weight.rows * weight.cols or weight.cols < inputSize {
        return projectSequenceInputGradientWithDenseDeltaScalar(gradOutput, seqLen, inputSize, weight, delta)
    }
    let gradTensor = Tensor.fromArray(seqLen, weight.rows, gradOutput, backend)
    let effectiveWeight = effectiveDenseWeightSlice(weight.values, weight.rows, weight.cols, inputSize, delta)
    let weightTensor = Tensor.fromArray(weight.rows, inputSize, effectiveWeight, backend)
    let gradInput = gradTensor.denseInputGradient(weightTensor)
    if gradInput.values.length() == seqLen * inputSize {
        return gradInput.values
    }
    return projectSequenceInputGradientWithDenseDeltaScalar(gradOutput, seqLen, inputSize, weight, delta)
}

fun projectSequenceInputGradientWithDenseDeltaScalar(gradOutput: Array<Float>, seqLen: Int, inputSize: Int, weight: EmbeddingTensorLoad, delta: DenseDeltaAdapter) r: Array<Float> {
    let out = zerosFloat(seqLen * inputSize)
    var row = 0
    while row < seqLen {
        var i = 0
        while i < inputSize and i < weight.cols {
            var sum = 0.0
            var o = 0
            while o < weight.rows {
                let deltaIdx = o * inputSize + i
                var effective = embeddingAt(weight.values, o, i, weight.cols)
                if deltaIdx >= 0 and deltaIdx < delta.weightDelta.length() {
                    effective = effective + delta.weightDelta[deltaIdx]
                }
                sum = sum + flatAt(gradOutput, row, o, weight.rows) * effective
                o = o + 1
            }
            out[row * inputSize + i] = sum
            i = i + 1
        }
        row = row + 1
    }
    return out
}

fun denseWeightSlice(values: Array<Float>, rows: Int, cols: Int, inputSize: Int) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < rows {
        var col = 0
        while col < inputSize {
            var value = 0.0
            let idx = row * cols + col
            if idx >= 0 and idx < values.length() {
                value = values[idx]
            }
            out.push(value)
            col = col + 1
        }
        row = row + 1
    }
    return out
}

fun effectiveDenseWeightSlice(values: Array<Float>, rows: Int, cols: Int, inputSize: Int, delta: DenseDeltaAdapter) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < rows {
        var col = 0
        while col < inputSize {
            var value = 0.0
            let sourceIdx = row * cols + col
            if sourceIdx >= 0 and sourceIdx < values.length() {
                value = values[sourceIdx]
            }
            let deltaIdx = row * inputSize + col
            if deltaIdx >= 0 and deltaIdx < delta.weightDelta.length() {
                value = value + delta.weightDelta[deltaIdx]
            }
            out.push(value)
            col = col + 1
        }
        row = row + 1
    }
    return out
}

fun applyGeluGradient(preActivation: Array<Float>, gradOutput: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < preActivation.length() {
        var grad = 0.0
        if i < gradOutput.length() {
            grad = gradOutput[i]
        }
        out.push(grad * geluDerivativeApprox(preActivation[i]))
        i = i + 1
    }
    return out
}

fun applyGeluGradientBackend(preActivation: Array<Float>, gradOutput: Array<Float>, backend: String) r: Array<Float> {
    if miniLMBackendIsGpu(backend) and preActivation.length() > 0 and gradOutput.length() >= preActivation.length() {
        let pre = Tensor.fromArray(1, preActivation.length(), preActivation, backend)
        let grad = Tensor.fromArray(1, preActivation.length(), gradOutput, backend)
        let out = pre.geluBackward(grad)
        if out.values.length() == preActivation.length() {
            return out.values
        }
    }
    return applyGeluGradient(preActivation, gradOutput)
}

fun miniLMBackendIsGpu(backend: String) r: Bool {
    if backend.length() != 3 {
        return false
    }
    return backend.charAt(0) == 103 and backend.charAt(1) == 112 and backend.charAt(2) == 117
}

fun geluDerivativeApprox(x: Float) r: Float {
    let c = 0.7978845608
    let cubic = x * x * x
    let inner = c * (x + 0.044715 * cubic)
    let t = meTanhApprox(inner)
    let sechSq = 1.0 - t * t
    let innerGrad = c * (1.0 + 0.134145 * x * x)
    return 0.5 * (1.0 + t) + 0.5 * x * sechSq * innerGrad
}

fun attentionWeightsForHeadBackend(q: Array<Float>, k: Array<Float>, queryRow: Int, head: Int, headDim: Int, hiddenSize: Int, seqLen: Int, scale: Float, backend: String) r: Array<Float> {
    if seqLen <= 0 {
        return Array<Float>()
    }
    if miniLMBackendIsGpu(backend) {
        let qTokenTensor = Tensor.fromArray(1, headDim, attentionHeadVector(rowVector(q, queryRow, hiddenSize), head, headDim), backend)
        let kHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(k, seqLen, hiddenSize, head, headDim), backend)
        let scoresTensor = qTokenTensor.matmul(kHeadTensor.transpose()).scale(1.0 / scale)
        if scoresTensor.values.length() == seqLen {
            return attentionSoftmaxWeightsBackend(scoresTensor.values, backend)
        }
    }
    let scores = Array<Float>()
    var other = 0
    while other < seqLen {
        scores.push(attentionScore(q, k, queryRow, other, head, headDim, hiddenSize) / scale)
        other = other + 1
    }
    return attentionSoftmaxWeightsBackend(scores, backend)
}

fun attentionSoftmaxWeightsBackend(scores: Array<Float>, backend: String) r: Array<Float> {
    if scores.length() <= 0 {
        return Array<Float>()
    }
    let scoreTensor = Tensor.fromArray(1, scores.length(), scores, backend)
    let weights = scoreTensor.softmaxRows()
    if weights.values.length() == scores.length() {
        return weights.values
    }
    return attentionSoftmaxWeightsScalar(scores)
}

fun attentionSoftmaxWeightsScalar(scores: Array<Float>) r: Array<Float> {
    let weights = Array<Float>()
    if scores.length() <= 0 {
        return weights
    }
    var maxScore = scores[0]
    var i = 1
    while i < scores.length() {
        if scores[i] > maxScore {
            maxScore = scores[i]
        }
        i = i + 1
    }
    var denom = 0.0
    i = 0
    while i < scores.length() {
        let value = exp(scores[i] - maxScore)
        weights.push(value)
        denom = denom + value
        i = i + 1
    }
    if denom > 0.000000001 {
        i = 0
        while i < weights.length() {
            weights[i] = weights[i] / denom
            i = i + 1
        }
    }
    return weights
}

fun attentionSoftmaxBackwardBackend(weights: Array<Float>, gradWeights: Array<Float>, backend: String) r: Array<Float> {
    if weights.length() <= 0 or gradWeights.length() < weights.length() {
        return Array<Float>()
    }
    let weightsTensor = Tensor.fromArray(1, weights.length(), weights, backend)
    let gradTensor = Tensor.fromArray(1, weights.length(), gradWeights, backend)
    let gradScores = weightsTensor.softmaxBackwardRows(gradTensor)
    if gradScores.values.length() == weights.length() {
        return gradScores.values
    }
    return attentionSoftmaxBackwardScalar(weights, gradWeights)
}

fun attentionSoftmaxBackwardScalar(weights: Array<Float>, gradWeights: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    if weights.length() <= 0 or gradWeights.length() < weights.length() {
        return out
    }
    var weightedGrad = 0.0
    var i = 0
    while i < weights.length() {
        weightedGrad = weightedGrad + gradWeights[i] * weights[i]
        i = i + 1
    }
    i = 0
    while i < weights.length() {
        out.push(weights[i] * (gradWeights[i] - weightedGrad))
        i = i + 1
    }
    return out
}

fun attentionHeadRows(values: Array<Float>, seqLen: Int, hiddenSize: Int, head: Int, headDim: Int) r: Array<Float> {
    let out = Array<Float>()
    var row = 0
    while row < seqLen {
        var d = 0
        while d < headDim {
            out.push(flatAt(values, row, head * headDim + d, hiddenSize))
            d = d + 1
        }
        row = row + 1
    }
    return out
}

fun attentionHeadVector(values: Array<Float>, head: Int, headDim: Int) r: Array<Float> {
    let out = Array<Float>()
    var d = 0
    while d < headDim {
        let col = head * headDim + d
        if col >= 0 and col < values.length() {
            out.push(values[col])
        } else {
            out.push(0.0)
        }
        d = d + 1
    }
    return out
}

fun addAttentionHeadRowsInPlace(target: Array<Float>, values: Array<Float>, seqLen: Int, hiddenSize: Int, head: Int, headDim: Int) r: Void {
    var row = 0
    while row < seqLen {
        var d = 0
        while d < headDim {
            let sourceIndex = row * headDim + d
            let targetIndex = row * hiddenSize + head * headDim + d
            if sourceIndex >= 0 and sourceIndex < values.length() and targetIndex >= 0 and targetIndex < target.length() {
                target[targetIndex] = target[targetIndex] + values[sourceIndex]
            }
            d = d + 1
        }
        row = row + 1
    }
}

fun addAttentionHeadRowInPlace(target: Array<Float>, row: Int, values: Array<Float>, hiddenSize: Int, head: Int, headDim: Int) r: Void {
    var d = 0
    while d < headDim {
        let targetIndex = row * hiddenSize + head * headDim + d
        if d < values.length() and targetIndex >= 0 and targetIndex < target.length() {
            target[targetIndex] = target[targetIndex] + values[d]
        }
        d = d + 1
    }
}

fun accumulateAttentionHeadBackwardBackend(q: Array<Float>, k: Array<Float>, v: Array<Float>, gradContextRow: Array<Float>, token: Int, head: Int, headDim: Int, hiddenSize: Int, seqLen: Int, scale: Float, backend: String, gradQ: Array<Float>, gradK: Array<Float>, gradV: Array<Float>) r: Void {
    let weights = attentionWeightsForHeadBackend(q, k, token, head, headDim, hiddenSize, seqLen, scale, backend)
    if weights.length() != seqLen {
        return
    }
    let gradContextHead = attentionHeadVector(gradContextRow, head, headDim)
    let gradContextTensor = Tensor.fromArray(1, headDim, gradContextHead, backend)
    let vHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(v, seqLen, hiddenSize, head, headDim), backend)
    let gradWeightsTensor = gradContextTensor.matmul(vHeadTensor.transpose())
    let gradWeights = gradWeightsTensor.values
    let weightsColumn = Tensor.fromArray(seqLen, 1, weights, backend)
    let gradVHead = weightsColumn.matmul(gradContextTensor)
    addAttentionHeadRowsInPlace(gradV, gradVHead.values, seqLen, hiddenSize, head, headDim)

    let gradScores = attentionSoftmaxBackwardBackend(weights, gradWeights, backend)
    if gradScores.length() != seqLen {
        return
    }
    let gradScoresRow = Tensor.fromArray(1, seqLen, gradScores, backend)
    let gradScoresColumn = Tensor.fromArray(seqLen, 1, gradScores, backend)
    let kHeadTensor = Tensor.fromArray(seqLen, headDim, attentionHeadRows(k, seqLen, hiddenSize, head, headDim), backend)
    let gradQHead = gradScoresRow.matmul(kHeadTensor).scale(1.0 / scale)
    addAttentionHeadRowInPlace(gradQ, token, gradQHead.values, hiddenSize, head, headDim)

    let qTokenHead = Tensor.fromArray(1, headDim, attentionHeadVector(rowVector(q, token, hiddenSize), head, headDim), backend)
    let gradKHead = gradScoresColumn.matmul(qTokenHead).scale(1.0 / scale)
    addAttentionHeadRowsInPlace(gradK, gradKHead.values, seqLen, hiddenSize, head, headDim)
}

fun attentionSequenceInputGradient(q: Array<Float>, k: Array<Float>, v: Array<Float>, gradContext: Array<Float>, qWeight: EmbeddingTensorLoad, kWeight: EmbeddingTensorLoad, vWeight: EmbeddingTensorLoad, seqLen: Int, hiddenSize: Int, attentionHeads: Int) r: Array<Float> {
    return attentionSequenceInputGradientBackend(q, k, v, gradContext, qWeight, kWeight, vWeight, seqLen, hiddenSize, attentionHeads, "cpu")
}

fun attentionSequenceInputGradientBackend(q: Array<Float>, k: Array<Float>, v: Array<Float>, gradContext: Array<Float>, qWeight: EmbeddingTensorLoad, kWeight: EmbeddingTensorLoad, vWeight: EmbeddingTensorLoad, seqLen: Int, hiddenSize: Int, attentionHeads: Int, backend: String) r: Array<Float> {
    if attentionHeads <= 0 or hiddenSize % attentionHeads != 0 {
        return Array<Float>()
    }
    let headDim = hiddenSize / attentionHeads
    let scale = sqrt(headDim.toFloat())
    let gradQ = zerosFloat(seqLen * hiddenSize)
    let gradK = zerosFloat(seqLen * hiddenSize)
    let gradV = zerosFloat(seqLen * hiddenSize)
    var token = 0
    while token < seqLen {
        var head = 0
        while head < attentionHeads {
            accumulateAttentionHeadBackwardBackend(q, k, v, rowVector(gradContext, token, hiddenSize), token, head, headDim, hiddenSize, seqLen, scale, backend, gradQ, gradK, gradV)
            head = head + 1
        }
        token = token + 1
    }

    let gradSequence = projectSequenceInputGradientBackend(gradQ, seqLen, hiddenSize, qWeight, backend)
    let gradFromK = projectSequenceInputGradientBackend(gradK, seqLen, hiddenSize, kWeight, backend)
    let gradFromV = projectSequenceInputGradientBackend(gradV, seqLen, hiddenSize, vWeight, backend)
    addFlatInPlace(gradSequence, gradFromK)
    addFlatInPlace(gradSequence, gradFromV)
    return gradSequence
}

fun attentionSequenceInputGradientWithDeltas(q: Array<Float>, k: Array<Float>, v: Array<Float>, gradContext: Array<Float>, qWeight: EmbeddingTensorLoad, kWeight: EmbeddingTensorLoad, vWeight: EmbeddingTensorLoad, qDelta: DenseDeltaAdapter, kDelta: DenseDeltaAdapter, vDelta: DenseDeltaAdapter, seqLen: Int, hiddenSize: Int, attentionHeads: Int) r: Array<Float> {
    return attentionSequenceInputGradientWithDeltasBackend(q, k, v, gradContext, qWeight, kWeight, vWeight, qDelta, kDelta, vDelta, seqLen, hiddenSize, attentionHeads, "cpu")
}

fun attentionSequenceInputGradientWithDeltasBackend(q: Array<Float>, k: Array<Float>, v: Array<Float>, gradContext: Array<Float>, qWeight: EmbeddingTensorLoad, kWeight: EmbeddingTensorLoad, vWeight: EmbeddingTensorLoad, qDelta: DenseDeltaAdapter, kDelta: DenseDeltaAdapter, vDelta: DenseDeltaAdapter, seqLen: Int, hiddenSize: Int, attentionHeads: Int, backend: String) r: Array<Float> {
    if attentionHeads <= 0 or hiddenSize % attentionHeads != 0 {
        return Array<Float>()
    }
    let headDim = hiddenSize / attentionHeads
    let scale = sqrt(headDim.toFloat())
    let gradQ = zerosFloat(seqLen * hiddenSize)
    let gradK = zerosFloat(seqLen * hiddenSize)
    let gradV = zerosFloat(seqLen * hiddenSize)
    var token = 0
    while token < seqLen {
        var head = 0
        while head < attentionHeads {
            accumulateAttentionHeadBackwardBackend(q, k, v, rowVector(gradContext, token, hiddenSize), token, head, headDim, hiddenSize, seqLen, scale, backend, gradQ, gradK, gradV)
            head = head + 1
        }
        token = token + 1
    }

    let gradSequence = projectSequenceInputGradientWithDenseDeltaBackend(gradQ, seqLen, hiddenSize, qWeight, qDelta, backend)
    let gradFromK = projectSequenceInputGradientWithDenseDeltaBackend(gradK, seqLen, hiddenSize, kWeight, kDelta, backend)
    let gradFromV = projectSequenceInputGradientWithDenseDeltaBackend(gradV, seqLen, hiddenSize, vWeight, vDelta, backend)
    addFlatInPlace(gradSequence, gradFromK)
    addFlatInPlace(gradSequence, gradFromV)
    return gradSequence
}

fun copyFlat(values: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < values.length() {
        out.push(values[i])
        i = i + 1
    }
    return out
}

fun addFlatInPlace(target: Array<Float>, source: Array<Float>) r: Void {
    var i = 0
    while i < target.length() and i < source.length() {
        target[i] = target[i] + source[i]
        i = i + 1
    }
}

fun applyMiniLMLayerDeltaGradients(layerDeltas: MiniLMLayerDeltas, gradDeltas: MiniLMLayerDeltas, readyLayers: Int, lr: Float, weightDecay: Float, gradClip: Float) r: Void {
    var scale = 1.0
    if gradClip > 0.0 {
        let norm = miniLMLayerDeltaGradNorm(gradDeltas, readyLayers)
        if norm > gradClip {
            scale = gradClip / norm
        }
    }
    if scale != 1.0 {
        scaleMiniLMLayerDeltaGradients(gradDeltas, readyLayers, scale)
    }
    var layer = 0
    while layer < readyLayers and layer < layerDeltas.layers and layer < gradDeltas.layers {
        if layerDeltas.hasLayer(layer) and gradDeltas.hasLayer(layer) {
            layerDeltas.queryDeltas[layer].applyGradients(gradDeltas.queryDeltas[layer].weightDelta, gradDeltas.queryDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.keyDeltas[layer].applyGradients(gradDeltas.keyDeltas[layer].weightDelta, gradDeltas.keyDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.valueDeltas[layer].applyGradients(gradDeltas.valueDeltas[layer].weightDelta, gradDeltas.valueDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.attentionDenseDeltas[layer].applyGradients(gradDeltas.attentionDenseDeltas[layer].weightDelta, gradDeltas.attentionDenseDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.attentionLayerNormDeltas[layer].applyGradients(gradDeltas.attentionLayerNormDeltas[layer].weightDelta, gradDeltas.attentionLayerNormDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.intermediateDeltas[layer].applyGradients(gradDeltas.intermediateDeltas[layer].weightDelta, gradDeltas.intermediateDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.outputDeltas[layer].applyGradients(gradDeltas.outputDeltas[layer].weightDelta, gradDeltas.outputDeltas[layer].biasDelta, lr, weightDecay, 0.0)
            layerDeltas.outputLayerNormDeltas[layer].applyGradients(gradDeltas.outputLayerNormDeltas[layer].weightDelta, gradDeltas.outputLayerNormDeltas[layer].biasDelta, lr, weightDecay, 0.0)
        }
        layer = layer + 1
    }
}

fun applyMiniLMLayerBaseParameterGradients(info: SafeTensorInfo, parameterRegistry: MiniLMParameterRegistry, layerDeltas: MiniLMLayerDeltas, gradDeltas: MiniLMLayerDeltas, readyLayers: Int, maxLoadElements: Int, lr: Float, weightDecay: Float, gradClip: Float) r: Void {
    var scale = 1.0
    if gradClip > 0.0 {
        let norm = miniLMLayerDeltaGradNorm(gradDeltas, readyLayers)
        if norm > gradClip {
            scale = gradClip / norm
        }
    }
    if scale != 1.0 {
        scaleMiniLMLayerDeltaGradients(gradDeltas, readyLayers, scale)
    }
    var layer = 0
    while layer < readyLayers and layer < layerDeltas.layers and layer < gradDeltas.layers {
        if layerDeltas.hasLayer(layer) and gradDeltas.hasLayer(layer) {
            applyMiniLMLayerBaseParameterGradientsAt(info, parameterRegistry, layerDeltas, gradDeltas, layer, maxLoadElements, lr, weightDecay)
        }
        layer = layer + 1
    }
}

fun applyRegistryDenseDeltaOrFallback(parameterRegistry: MiniLMParameterRegistry, logicalWeightName: String, logicalBiasName: String, baseWeight: Array<Float>, baseBias: Array<Float>, delta: DenseDeltaAdapter, grad: DenseDeltaAdapter, lr: Float, weightDecay: Float) r: Void {
    let step = delta.stepCount + 1
    if parameterRegistry.applyDenseBaseAdamW(logicalWeightName, logicalBiasName, baseWeight, baseBias, delta.weightDelta, delta.biasDelta, delta.weightM, delta.weightV, delta.biasM, delta.biasV, grad.weightDelta, grad.biasDelta, step, lr, weightDecay, 0.0, 0.0, 0.0) {
        delta.stepCount = step
        delta.loaded = true
    } else {
        delta.applyBaseParameterGradients(baseWeight, baseBias, grad.weightDelta, grad.biasDelta, lr, weightDecay, 0.0)
    }
}

fun applyRegistryLayerNormDeltaOrFallback(parameterRegistry: MiniLMParameterRegistry, logicalWeightName: String, logicalBiasName: String, baseWeight: Array<Float>, baseBias: Array<Float>, delta: LayerNormDeltaAdapter, grad: LayerNormDeltaAdapter, lr: Float, weightDecay: Float) r: Void {
    let step = delta.stepCount + 1
    if parameterRegistry.applyDenseBaseAdamW(logicalWeightName, logicalBiasName, baseWeight, baseBias, delta.weightDelta, delta.biasDelta, delta.weightM, delta.weightV, delta.biasM, delta.biasV, grad.weightDelta, grad.biasDelta, step, lr, weightDecay, 0.0, 1.0, 0.0) {
        delta.stepCount = step
        delta.loaded = true
    } else {
        delta.applyBaseParameterGradients(baseWeight, baseBias, grad.weightDelta, grad.biasDelta, lr, weightDecay, 0.0)
    }
}

fun applyMiniLMLayerBaseParameterGradientsAt(info: SafeTensorInfo, parameterRegistry: MiniLMParameterRegistry, layerDeltas: MiniLMLayerDeltas, gradDeltas: MiniLMLayerDeltas, layer: Int, maxLoadElements: Int, lr: Float, weightDecay: Float) r: Void {
    let prefix = "encoder.layer." + layer.toString() + "."
    let logicalPrefix = "layer." + layer.toString() + "."
    let qWeight = loadEmbeddingTensor(info, prefix + "attention.self.query.weight", maxLoadElements)
    let qBias = loadEmbeddingTensor(info, prefix + "attention.self.query.bias", maxLoadElements)
    if qWeight.ok and qBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "attention.query.weight", logicalPrefix + "attention.query.bias", qWeight.values, qBias.values, layerDeltas.queryDeltas[layer], gradDeltas.queryDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.queryDeltas[layer].applyGradients(gradDeltas.queryDeltas[layer].weightDelta, gradDeltas.queryDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let kWeight = loadEmbeddingTensor(info, prefix + "attention.self.key.weight", maxLoadElements)
    let kBias = loadEmbeddingTensor(info, prefix + "attention.self.key.bias", maxLoadElements)
    if kWeight.ok and kBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "attention.key.weight", logicalPrefix + "attention.key.bias", kWeight.values, kBias.values, layerDeltas.keyDeltas[layer], gradDeltas.keyDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.keyDeltas[layer].applyGradients(gradDeltas.keyDeltas[layer].weightDelta, gradDeltas.keyDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let vWeight = loadEmbeddingTensor(info, prefix + "attention.self.value.weight", maxLoadElements)
    let vBias = loadEmbeddingTensor(info, prefix + "attention.self.value.bias", maxLoadElements)
    if vWeight.ok and vBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "attention.value.weight", logicalPrefix + "attention.value.bias", vWeight.values, vBias.values, layerDeltas.valueDeltas[layer], gradDeltas.valueDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.valueDeltas[layer].applyGradients(gradDeltas.valueDeltas[layer].weightDelta, gradDeltas.valueDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let attnWeight = loadEmbeddingTensor(info, prefix + "attention.output.dense.weight", maxLoadElements)
    let attnBias = loadEmbeddingTensor(info, prefix + "attention.output.dense.bias", maxLoadElements)
    if attnWeight.ok and attnBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "attention.output.weight", logicalPrefix + "attention.output.bias", attnWeight.values, attnBias.values, layerDeltas.attentionDenseDeltas[layer], gradDeltas.attentionDenseDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.attentionDenseDeltas[layer].applyGradients(gradDeltas.attentionDenseDeltas[layer].weightDelta, gradDeltas.attentionDenseDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let attnLnWeight = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.weight", maxLoadElements)
    let attnLnBias = loadEmbeddingTensor(info, prefix + "attention.output.LayerNorm.bias", maxLoadElements)
    if attnLnWeight.ok and attnLnBias.ok {
        applyRegistryLayerNormDeltaOrFallback(parameterRegistry, logicalPrefix + "attention.layer_norm.weight", logicalPrefix + "attention.layer_norm.bias", attnLnWeight.values, attnLnBias.values, layerDeltas.attentionLayerNormDeltas[layer], gradDeltas.attentionLayerNormDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.attentionLayerNormDeltas[layer].applyGradients(gradDeltas.attentionLayerNormDeltas[layer].weightDelta, gradDeltas.attentionLayerNormDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let intermediateWeight = loadEmbeddingTensor(info, prefix + "intermediate.dense.weight", maxLoadElements)
    let intermediateBias = loadEmbeddingTensor(info, prefix + "intermediate.dense.bias", maxLoadElements)
    if intermediateWeight.ok and intermediateBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "intermediate.weight", logicalPrefix + "intermediate.bias", intermediateWeight.values, intermediateBias.values, layerDeltas.intermediateDeltas[layer], gradDeltas.intermediateDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.intermediateDeltas[layer].applyGradients(gradDeltas.intermediateDeltas[layer].weightDelta, gradDeltas.intermediateDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let outputWeight = loadEmbeddingTensor(info, prefix + "output.dense.weight", maxLoadElements)
    let outputBias = loadEmbeddingTensor(info, prefix + "output.dense.bias", maxLoadElements)
    if outputWeight.ok and outputBias.ok {
        applyRegistryDenseDeltaOrFallback(parameterRegistry, logicalPrefix + "output.weight", logicalPrefix + "output.bias", outputWeight.values, outputBias.values, layerDeltas.outputDeltas[layer], gradDeltas.outputDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.outputDeltas[layer].applyGradients(gradDeltas.outputDeltas[layer].weightDelta, gradDeltas.outputDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }

    let outputLnWeight = loadEmbeddingTensor(info, prefix + "output.LayerNorm.weight", maxLoadElements)
    let outputLnBias = loadEmbeddingTensor(info, prefix + "output.LayerNorm.bias", maxLoadElements)
    if outputLnWeight.ok and outputLnBias.ok {
        applyRegistryLayerNormDeltaOrFallback(parameterRegistry, logicalPrefix + "output.layer_norm.weight", logicalPrefix + "output.layer_norm.bias", outputLnWeight.values, outputLnBias.values, layerDeltas.outputLayerNormDeltas[layer], gradDeltas.outputLayerNormDeltas[layer], lr, weightDecay)
    } else {
        layerDeltas.outputLayerNormDeltas[layer].applyGradients(gradDeltas.outputLayerNormDeltas[layer].weightDelta, gradDeltas.outputLayerNormDeltas[layer].biasDelta, lr, weightDecay, 0.0)
    }
}

fun miniLMLayerDeltaGradNorm(gradDeltas: MiniLMLayerDeltas, readyLayers: Int) r: Float {
    var sum = 0.0
    var layer = 0
    while layer < readyLayers and layer < gradDeltas.layers {
        if gradDeltas.hasLayer(layer) {
            sum = sum + floatArraySquareSum(gradDeltas.queryDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.queryDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.keyDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.keyDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.valueDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.valueDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.attentionDenseDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.attentionDenseDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.attentionLayerNormDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.attentionLayerNormDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.intermediateDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.intermediateDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.outputDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.outputDeltas[layer].biasDelta)
            sum = sum + floatArraySquareSum(gradDeltas.outputLayerNormDeltas[layer].weightDelta)
            sum = sum + floatArraySquareSum(gradDeltas.outputLayerNormDeltas[layer].biasDelta)
        }
        layer = layer + 1
    }
    return sqrt(sum)
}

fun scaleMiniLMLayerDeltaGradients(gradDeltas: MiniLMLayerDeltas, readyLayers: Int, scale: Float) r: Void {
    var layer = 0
    while layer < readyLayers and layer < gradDeltas.layers {
        if gradDeltas.hasLayer(layer) {
            scaleFloatArrayInPlace(gradDeltas.queryDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.queryDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.keyDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.keyDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.valueDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.valueDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.attentionDenseDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.attentionDenseDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.attentionLayerNormDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.attentionLayerNormDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.intermediateDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.intermediateDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.outputDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.outputDeltas[layer].biasDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.outputLayerNormDeltas[layer].weightDelta, scale)
            scaleFloatArrayInPlace(gradDeltas.outputLayerNormDeltas[layer].biasDelta, scale)
        }
        layer = layer + 1
    }
}

fun floatArraySquareSum(values: Array<Float>) r: Float {
    var sum = 0.0
    var i = 0
    while i < values.length() {
        sum = sum + values[i] * values[i]
        i = i + 1
    }
    return sum
}

fun scaleFloatArrayInPlace(values: Array<Float>, scale: Float) r: Void {
    var i = 0
    while i < values.length() {
        values[i] = values[i] * scale
        i = i + 1
    }
}

fun meTanhApprox(x: Float) r: Float {
    if x > 9.0 {
        return 1.0
    }
    if x < -9.0 {
        return -1.0
    }
    let two = 2.0 * x
    let e = exp(two)
    return (e - 1.0) / (e + 1.0)
}

fun accumulateIntermediateDeltaGradFromOutput(trace: MiniLMDenseTrace, row: Int, gradOutputDense: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, gradIW: Array<Float>, gradIB: Array<Float>, backend: String) r: Void {
    if not trace.ok {
        return
    }
    let gradFf = outputDenseInputGradientWithAdapters(gradOutputDense, trace.outputDenseWeight, trace.inputDim, trace.hiddenSize, denseAdapter, denseDelta)
    let interPre = rowVector(trace.intermediatePreActivation, row, trace.inputDim)
    let gradInterPre = applyGeluGradientBackend(interPre, gradFf, backend)
    let interInput = rowVector(trace.intermediateInput, row, trace.hiddenSize)
    accumulateDenseDeltaGrad(interInput, gradInterPre, intermediateDelta, gradIW, gradIB)
}

fun accumulateAttentionDeltaGradFromOutput(trace: MiniLMDenseTrace, row: Int, gradOutputDense: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, attentionDenseDelta: DenseDeltaAdapter, attentionLayerNormDelta: LayerNormDeltaAdapter, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, gradADW: Array<Float>, gradADB: Array<Float>, gradALNW: Array<Float>, gradALNB: Array<Float>, attentionHeads: Int, backend: String) r: Void {
    if not trace.ok {
        return
    }
    let gradAttnNorm = attentionNormGradientFromOutput(trace, row, gradOutputDense, denseAdapter, denseDelta, intermediateDelta, backend)
    let attnLnInput = rowVector(trace.attentionLayerNormInput, row, trace.hiddenSize)
    accumulateLayerNormDeltaGrad(attnLnInput, gradAttnNorm, attentionLayerNormDelta, gradALNW, gradALNB)
    let gradAttnLnInput = layerNormInputGradient(attnLnInput, trace.attentionNormWeight, gradAttnNorm)
    let contextInput = rowVector(trace.attentionContext, row, trace.hiddenSize)
    accumulateDenseDeltaGrad(contextInput, gradAttnLnInput, attentionDenseDelta, gradADW, gradADB)
    let gradContext = denseInputGradientWithDelta(gradAttnLnInput, trace.attentionOutputDenseWeight, trace.hiddenSize, trace.hiddenSize, attentionDenseDelta)
    accumulateSelfAttentionDeltaGradForRow(trace, row, gradContext, queryDelta, keyDelta, valueDelta, gradQW, gradQB, gradKW, gradKB, gradVW, gradVB, attentionHeads, backend)
}

fun attentionNormGradientFromOutput(trace: MiniLMDenseTrace, row: Int, gradOutputDense: Array<Float>, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter, intermediateDelta: DenseDeltaAdapter, backend: String) r: Array<Float> {
    let gradAttnNorm = copyFlat(gradOutputDense)
    let gradFf = outputDenseInputGradientWithAdapters(gradOutputDense, trace.outputDenseWeight, trace.inputDim, trace.hiddenSize, denseAdapter, denseDelta)
    let interPre = rowVector(trace.intermediatePreActivation, row, trace.inputDim)
    let gradInterPre = applyGeluGradientBackend(interPre, gradFf, backend)
    let gradFromIntermediate = denseInputGradientWithDelta(gradInterPre, trace.intermediateDenseWeight, trace.hiddenSize, trace.inputDim, intermediateDelta)
    addFlatInPlace(gradAttnNorm, gradFromIntermediate)
    return gradAttnNorm
}

fun denseInputGradientWithDelta(gradOut: Array<Float>, baseWeight: Array<Float>, inputDim: Int, outputDim: Int, denseDelta: DenseDeltaAdapter) r: Array<Float> {
    let out = denseZeros(inputDim)
    var i = 0
    while i < inputDim {
        var value = 0.0
        var o = 0
        while o < outputDim and o < gradOut.length() {
            let idx = o * inputDim + i
            if idx < baseWeight.length() {
                value = value + gradOut[o] * baseWeight[idx]
            }
            if idx < denseDelta.weightDelta.length() {
                value = value + gradOut[o] * denseDelta.weightDelta[idx]
            }
            o = o + 1
        }
        out[i] = value
        i = i + 1
    }
    return out
}

fun accumulateSelfAttentionDeltaGradForRow(trace: MiniLMDenseTrace, token: Int, gradContextRow: Array<Float>, queryDelta: DenseDeltaAdapter, keyDelta: DenseDeltaAdapter, valueDelta: DenseDeltaAdapter, gradQW: Array<Float>, gradQB: Array<Float>, gradKW: Array<Float>, gradKB: Array<Float>, gradVW: Array<Float>, gradVB: Array<Float>, attentionHeads: Int, backend: String) r: Void {
    if attentionHeads <= 0 or trace.hiddenSize % attentionHeads != 0 {
        return
    }
    let headDim = trace.hiddenSize / attentionHeads
    let scale = sqrt(headDim.toFloat())
    let gradQRows = denseZeros(trace.seqLen * trace.hiddenSize)
    let gradKRows = denseZeros(trace.seqLen * trace.hiddenSize)
    let gradVRows = denseZeros(trace.seqLen * trace.hiddenSize)
    var head = 0
    while head < attentionHeads {
        accumulateAttentionHeadBackwardBackend(trace.attentionQ, trace.attentionK, trace.attentionV, gradContextRow, token, head, headDim, trace.hiddenSize, trace.seqLen, scale, backend, gradQRows, gradKRows, gradVRows)
        head = head + 1
    }

    let tokenInput = rowVector(trace.attentionSequenceInput, token, trace.hiddenSize)
    let gradQRow = rowVector(gradQRows, token, trace.hiddenSize)
    accumulateDenseDeltaGrad(tokenInput, gradQRow, queryDelta, gradQW, gradQB)
    var row = 0
    while row < trace.seqLen {
        let sourceInput = rowVector(trace.attentionSequenceInput, row, trace.hiddenSize)
        let gradK = rowVector(gradKRows, row, trace.hiddenSize)
        let gradV = rowVector(gradVRows, row, trace.hiddenSize)
        accumulateDenseDeltaGrad(sourceInput, gradK, keyDelta, gradKW, gradKB)
        accumulateDenseDeltaGrad(sourceInput, gradV, valueDelta, gradVW, gradVB)
        row = row + 1
    }
}

fun outputDenseInputGradientWithAdapters(gradOut: Array<Float>, outputWeight: Array<Float>, inputDim: Int, outputDim: Int, denseAdapter: DenseLoRAAdapter, denseDelta: DenseDeltaAdapter) r: Array<Float> {
    let out = denseZeros(inputDim)
    var i = 0
    while i < inputDim {
        var value = 0.0
        var o = 0
        while o < outputDim and o < gradOut.length() {
            let idx = o * inputDim + i
            if idx < outputWeight.length() {
                value = value + gradOut[o] * outputWeight[idx]
            }
            if idx < denseDelta.weightDelta.length() {
                value = value + gradOut[o] * denseDelta.weightDelta[idx]
            }
            var rankIndex = 0
            while rankIndex < denseAdapter.rank {
                let aIndex = rankIndex * denseAdapter.inputDim + i
                if aIndex < denseAdapter.rankA.length() {
                    value = value + gradOut[o] * denseRankBAt(denseAdapter.rankB, o, rankIndex, denseAdapter.rank) * denseAdapter.rankA[aIndex]
                }
                rankIndex = rankIndex + 1
            }
            o = o + 1
        }
        out[i] = value
        i = i + 1
    }
    return out
}

fun accumulateLayerNormDeltaGrad(values: Array<Float>, gradOut: Array<Float>, layerNormDelta: LayerNormDeltaAdapter, gradWeight: Array<Float>, gradBias: Array<Float>) r: Void {
    let n = values.length()
    if n <= 0 or layerNormDelta.dim <= 0 {
        return
    }
    var mean = 0.0
    var i = 0
    while i < n {
        mean = mean + values[i]
        i = i + 1
    }
    mean = mean / n.toFloat()
    var variance = 0.0
    i = 0
    while i < n {
        let centered = values[i] - mean
        variance = variance + centered * centered
        i = i + 1
    }
    variance = variance / n.toFloat()
    let invStd = 1.0 / sqrt(variance + 0.000000000001)
    i = 0
    while i < n and i < layerNormDelta.dim {
        var grad = 0.0
        if i < gradOut.length() {
            grad = gradOut[i]
        }
        let xhat = (values[i] - mean) * invStd
        if i < gradWeight.length() {
            gradWeight[i] = gradWeight[i] + grad * xhat
        }
        if i < gradBias.length() {
            gradBias[i] = gradBias[i] + grad
        }
        i = i + 1
    }
}

fun accumulateDenseDeltaGrad(input: Array<Float>, gradOut: Array<Float>, denseDelta: DenseDeltaAdapter, gradDW: Array<Float>, gradDB: Array<Float>) r: Void {
    var o = 0
    while o < denseDelta.outputDim and o < gradOut.length() {
        if o < gradDB.length() {
            gradDB[o] = gradDB[o] + gradOut[o]
        }
        var i = 0
        while i < denseDelta.inputDim and i < input.length() {
            let idx = o * denseDelta.inputDim + i
            if idx < gradDW.length() {
                gradDW[idx] = gradDW[idx] + gradOut[o] * input[i]
            }
            i = i + 1
        }
        o = o + 1
    }
}

fun accumulateDenseLoRAGrad(input: Array<Float>, gradOut: Array<Float>, denseAdapter: DenseLoRAAdapter, gradA: Array<Float>, gradB: Array<Float>) r: Void {
    var o = 0
    while o < denseAdapter.outputDim and o < gradOut.length() {
        var rankIndex = 0
        while rankIndex < denseAdapter.rank {
            let bIndex = o * denseAdapter.rank + rankIndex
            if bIndex < gradB.length() {
                let bottle = denseRankBottleneckAt(input, denseAdapter.rankA, denseAdapter.rank, denseAdapter.inputDim, rankIndex)
                gradB[bIndex] = gradB[bIndex] + gradOut[o] * bottle
            }
            rankIndex = rankIndex + 1
        }
        o = o + 1
    }

    var rankAIndex = 0
    while rankAIndex < denseAdapter.rank {
        var scale = 0.0
        o = 0
        while o < denseAdapter.outputDim and o < gradOut.length() {
            scale = scale + gradOut[o] * denseRankBAt(denseAdapter.rankB, o, rankAIndex, denseAdapter.rank)
            o = o + 1
        }
        var i = 0
        while i < denseAdapter.inputDim and i < input.length() {
            let aIndex = rankAIndex * denseAdapter.inputDim + i
            if aIndex < gradA.length() {
                gradA[aIndex] = gradA[aIndex] + scale * input[i]
            }
            i = i + 1
        }
        rankAIndex = rankAIndex + 1
    }
}

fun layerNormInputGradient(values: Array<Float>, normWeight: Array<Float>, gradOut: Array<Float>) r: Array<Float> {
    let out = Array<Float>()
    let n = values.length()
    if n <= 0 {
        return out
    }
    var mean = 0.0
    var i = 0
    while i < n {
        mean = mean + values[i]
        i = i + 1
    }
    mean = mean / n.toFloat()
    var variance = 0.0
    i = 0
    while i < n {
        let centered = values[i] - mean
        variance = variance + centered * centered
        i = i + 1
    }
    variance = variance / n.toFloat()
    let invStd = 1.0 / sqrt(variance + 0.000000000001)
    let xhat = Array<Float>()
    var meanDy = 0.0
    var meanDyX = 0.0
    i = 0
    while i < n {
        let x = (values[i] - mean) * invStd
        xhat.push(x)
        var dy = 0.0
        if i < gradOut.length() and i < normWeight.length() {
            dy = gradOut[i] * normWeight[i]
        }
        meanDy = meanDy + dy
        meanDyX = meanDyX + dy * x
        i = i + 1
    }
    meanDy = meanDy / n.toFloat()
    meanDyX = meanDyX / n.toFloat()
    i = 0
    while i < n {
        var dy = 0.0
        if i < gradOut.length() and i < normWeight.length() {
            dy = gradOut[i] * normWeight[i]
        }
        out.push((dy - meanDy - xhat[i] * meanDyX) * invStd)
        i = i + 1
    }
    return out
}

fun denseMeanTripletGradQ(q: Array<Float>, p: Array<Float>, n: Array<Float>, posStats: MiniLMPairStats, negStats: MiniLMPairStats) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < q.length() {
        out.push(mePairGradAAt(q, n, negStats, i) - mePairGradAAt(q, p, posStats, i))
        i = i + 1
    }
    return out
}

fun denseMeanTripletGradP(q: Array<Float>, p: Array<Float>, posStats: MiniLMPairStats) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < p.length() {
        out.push(0.0 - mePairGradBAt(q, p, posStats, i))
        i = i + 1
    }
    return out
}

fun denseMeanTripletGradN(q: Array<Float>, n: Array<Float>, negStats: MiniLMPairStats) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < n.length() {
        out.push(mePairGradBAt(q, n, negStats, i))
        i = i + 1
    }
    return out
}

fun mePairStats(a: Array<Float>, b: Array<Float>) r: MiniLMPairStats {
    var dot = 0.0
    var normASq = 0.0
    var normBSq = 0.0
    var i = 0
    while i < a.length() and i < b.length() {
        dot = dot + a[i] * b[i]
        normASq = normASq + a[i] * a[i]
        normBSq = normBSq + b[i] * b[i]
        i = i + 1
    }
    if normASq <= 0.000000000001 or normBSq <= 0.000000000001 {
        return MiniLMPairStats.invalid()
    }
    let normA = sqrt(normASq)
    let normB = sqrt(normBSq)
    if normA <= 0.000000001 or normB <= 0.000000001 {
        return MiniLMPairStats.invalid()
    }
    return MiniLMPairStats.new(dot / (normA * normB), normA, normB)
}

fun mePairGradAAt(a: Array<Float>, b: Array<Float>, stats: MiniLMPairStats, index: Int) r: Float {
    if not stats.valid or index < 0 or index >= a.length() or index >= b.length() {
        return 0.0
    }
    let ab = stats.normA * stats.normB
    let aa = stats.normA * stats.normA
    if ab <= 0.000000001 or aa <= 0.000000001 {
        return 0.0
    }
    return b[index] / ab - stats.cosine * a[index] / aa
}

fun mePairGradBAt(a: Array<Float>, b: Array<Float>, stats: MiniLMPairStats, index: Int) r: Float {
    if not stats.valid or index < 0 or index >= a.length() or index >= b.length() {
        return 0.0
    }
    let ab = stats.normA * stats.normB
    let bb = stats.normB * stats.normB
    if ab <= 0.000000001 or bb <= 0.000000001 {
        return 0.0
    }
    return a[index] / ab - stats.cosine * b[index] / bb
}

fun meRelu(value: Float) r: Float {
    if value > 0.0 {
        return value
    }
    return 0.0
}

fun rowVector(sequence: Array<Float>, row: Int, width: Int) r: Array<Float> {
    let out = Array<Float>()
    var d = 0
    while d < width {
        out.push(flatAt(sequence, row, d, width))
        d = d + 1
    }
    return out
}

fun flatAt(values: Array<Float>, row: Int, col: Int, cols: Int) r: Float {
    let index = row * cols + col
    if index < 0 or index >= values.length() {
        return 0.0
    }
    return values[index]
}

fun zerosFloat(count: Int) r: Array<Float> {
    let out = Array<Float>()
    var i = 0
    while i < count {
        out.push(0.0)
        i = i + 1
    }
    return out
}

fun encodeTokenWithTables(tokenId: Int, positionIndex: Int, hiddenSize: Int, word: EmbeddingTensorLoad, position: EmbeddingTensorLoad, tokenType: EmbeddingTensorLoad, normWeight: EmbeddingTensorLoad, normBias: EmbeddingTensorLoad) r: Array<Float> {
    let raw = Array<Float>()
    let wordRow = positiveMod(tokenId, word.rows)
    let posRow = positiveMod(positionIndex, position.rows)
    let typeRow = 0
    var d = 0
    while d < hiddenSize {
        raw.push(word.valueAt(wordRow, d)
            + position.valueAt(posRow, d)
            + tokenType.valueAt(typeRow, d))
        d = d + 1
    }
    return embeddingLayerNorm(raw, normWeight.values, normBias.values)
}

fun encodeTokenWithEmbeddingDeltas(tokenId: Int, positionIndex: Int, hiddenSize: Int, word: EmbeddingTensorLoad, position: EmbeddingTensorLoad, tokenType: EmbeddingTensorLoad, normWeight: EmbeddingTensorLoad, normBias: EmbeddingTensorLoad, embeddingDeltas: MiniLMEmbeddingDeltas) r: Array<Float> {
    let raw = encodeTokenRawWithEmbeddingDeltas(tokenId, positionIndex, hiddenSize, word, position, tokenType, embeddingDeltas)
    return embeddingLayerNormWithEmbeddingDeltas(raw, normWeight.values, normBias.values, embeddingDeltas)
}

fun encodeTokenRawWithEmbeddingDeltas(tokenId: Int, positionIndex: Int, hiddenSize: Int, word: EmbeddingTensorLoad, position: EmbeddingTensorLoad, tokenType: EmbeddingTensorLoad, embeddingDeltas: MiniLMEmbeddingDeltas) r: Array<Float> {
    let raw = Array<Float>()
    let wordRow = positiveMod(tokenId, word.rows)
    let posRow = positiveMod(positionIndex, position.rows)
    let typeRow = 0
    var d = 0
    while d < hiddenSize {
        raw.push(word.valueAt(wordRow, d)
            + embeddingDeltas.wordDeltaAt(wordRow, d)
            + position.valueAt(posRow, d)
            + embeddingDeltas.positionDeltaAt(posRow, d)
            + tokenType.valueAt(typeRow, d)
            + embeddingDeltas.tokenTypeDeltaAt(typeRow, d))
        d = d + 1
    }
    return raw
}

fun embeddingLayerNormWithEmbeddingDeltas(values: Array<Float>, normWeight: Array<Float>, normBias: Array<Float>, embeddingDeltas: MiniLMEmbeddingDeltas) r: Array<Float> {
    let effectiveWeight = embeddingDeltas.effectiveLayerNormWeight(normWeight)
    let effectiveBias = embeddingDeltas.effectiveLayerNormBias(normBias)
    let out = embeddingLayerNorm(values, effectiveWeight, effectiveBias)
    releaseFloatArrayStorage(effectiveWeight)
    releaseFloatArrayStorage(effectiveBias)
    return out
}

fun embeddingLayerNorm(values: Array<Float>, normWeight: Array<Float>, normBias: Array<Float>) r: Array<Float> {
    var mean = 0.0
    var i = 0
    while i < values.length() {
        mean = mean + values[i]
        i = i + 1
    }
    if values.length() > 0 {
        mean = mean / values.length().toFloat()
    }

    var variance = 0.0
    i = 0
    while i < values.length() {
        let centered = values[i] - mean
        variance = variance + centered * centered
        i = i + 1
    }
    if values.length() > 0 {
        variance = variance / values.length().toFloat()
    }
    let denom = sqrt(variance + 0.000000000001)
    let out = Array<Float>()
    i = 0
    while i < values.length() {
        let normed = (values[i] - mean) / denom
        out.push(normed * normWeight[i] + normBias[i])
        i = i + 1
    }
    return out
}

fun embeddingAt(values: Array<Float>, row: Int, col: Int, cols: Int) r: Float {
    let index = row * cols + col
    if index < 0 or index >= values.length() {
        return 0.0
    }
    return values[index]
}

fun positiveMod(value: Int, modulus: Int) r: Int {
    if modulus <= 0 {
        return 0
    }
    var out = value % modulus
    if out < 0 {
        out = out + modulus
    }
    return out
}

fun meReadF32Le(bytes: Array<Int>, offset: Int) r: Float {
    if offset + 3 >= bytes.length() {
        return 0.0
    }
    var bits = bytes[offset]
        + bytes[offset + 1] * 256
        + bytes[offset + 2] * 65536
        + bytes[offset + 3] * 16777216
    var sign = 1.0
    if bits >= 2147483648 {
        sign = -1.0
        bits = bits - 2147483648
    }
    let exponent = bits / 8388608
    let mantissa = bits % 8388608
    if exponent == 0 {
        if mantissa == 0 {
            return sign * 0.0
        }
        return sign * (mantissa.toFloat() / 8388608.0) * mePow2(-126)
    }
    if exponent == 255 {
        if mantissa == 0 {
            return sign * mePow2(127)
        }
        return 0.0
    }
    return sign * (1.0 + mantissa.toFloat() / 8388608.0) * mePow2(exponent - 127)
}

fun mePow2(exponent: Int) r: Float {
    var value = 1.0
    if exponent >= 0 {
        var i = 0
        while i < exponent {
            value = value * 2.0
            i = i + 1
        }
        return value
    }
    var j = 0
    while j < 0 - exponent {
        value = value / 2.0
        j = j + 1
    }
    return value
}
