fun minilmLayerAdapterManifestJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + "  \"format\": \"seen-minilm-layer-adapter-manifest-v1\",\n"
        + "  \"minilm_layer_adapter_path\": \"" + cfg.minilmLayerAdapterPath() + "\",\n"
        + "  \"minilm_layer_adapter_exists\": " + exists(cfg.minilmLayerAdapterPath()).toString() + ",\n"
        + "  \"adapter_type\": \"minilm_layer_low_rank_projection\",\n"
        + "  \"adapter_gradient\": \"normalized_cosine_low_rank_projection_on_layer_mean\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"attached_to\": \"encoder.layer." + cfg.minilmAdapterLayer.toString() + ".output.LayerNorm\",\n"
        + "  \"applied_to\": \"token_hidden_states_before_downstream_layers\",\n"
        + "  \"applied_before_pooling\": true,\n"
        + "  \"applied_before_output_adapters\": true\n"
        + "}\n"
}

fun layerAdapterManifestJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + "  \"format\": \"seen-layer-adapter-manifest-v1\",\n"
        + "  \"layer_adapter_path\": \"" + cfg.layerAdapterPath() + "\",\n"
        + "  \"layer_adapter_exists\": " + exists(cfg.layerAdapterPath()).toString() + ",\n"
        + "  \"adapter_type\": \"minilm_output_low_rank_projection\",\n"
        + "  \"adapter_gradient\": \"normalized_cosine_low_rank_projection\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"attached_to\": \"minilm_mean_pooled_output\",\n"
        + "  \"applied_before_final_adapter\": true\n"
        + "}\n"
}
