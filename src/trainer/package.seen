fun materializePackagedLayerNormDelta(cfg: TrainerConfig, layers: Int, hiddenSize: Int) r: Bool {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return false
    }
    if not exists(cfg.minilmLayerNormDeltaPath()) {
        return false
    }
    let layer = normalizePackageDenseLayer(cfg.minilmDenseAdapterLayer, layers)
    if layer < 0 {
        return false
    }
    let info = SafeTensorInfo.inspect(packaged)
    let prefix = "encoder.layer." + layer.toString() + "."
    return materializeLayerNormDeltaSafetensors(info, packaged, prefix + "output.LayerNorm.weight", prefix + "output.LayerNorm.bias", cfg.minilmLayerNormDeltaPath(), hiddenSize)
}

fun normalizePackageDenseLayer(configured: Int, layers: Int) r: Int {
    if layers <= 0 {
        return -1
    }
    if configured < 0 {
        return layers - 1
    }
    if configured >= layers {
        return layers - 1
    }
    return configured
}

fun packageWeightsManifestNote(denseMaterialized: Bool, intermediateMaterialized: Bool, queryMaterialized: Bool, keyMaterialized: Bool, valueMaterialized: Bool, attentionDenseMaterialized: Bool, attentionLayerNormMaterialized: Bool, layerNormMaterialized: Bool, allLayerMaterialized: Int, embeddingMaterialized: Bool) r: String {
    if allLayerMaterialized > 0 and embeddingMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM sparse embedding deltas and all-ready-layer delta surfaces have been materialized into packaged model.safetensors"
    }
    if allLayerMaterialized > 0 {
        return "Seen-native safetensors metadata; trained MiniLM all-ready-layer delta surfaces have been materialized into packaged model.safetensors"
    }
    if embeddingMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM sparse embedding deltas have been materialized into packaged model.safetensors"
    }
    if denseMaterialized and intermediateMaterialized and queryMaterialized and keyMaterialized and valueMaterialized and attentionDenseMaterialized and attentionLayerNormMaterialized and layerNormMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM target-layer query, key, value, attention-output-dense, attention-output-LayerNorm, intermediate-dense, output-dense, and output-LayerNorm deltas have been materialized into packaged model.safetensors"
    }
    if queryMaterialized or keyMaterialized or valueMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM target-layer self-attention and feed-forward deltas were partially materialized into packaged model.safetensors"
    }
    if attentionDenseMaterialized or attentionLayerNormMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM attention-block and feed-forward deltas were partially materialized into packaged model.safetensors"
    }
    if denseMaterialized and layerNormMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM output-dense and output-LayerNorm deltas have been materialized into packaged model.safetensors"
    }
    if intermediateMaterialized and denseMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM intermediate-dense and output-dense deltas have been materialized into packaged model.safetensors"
    }
    if intermediateMaterialized and layerNormMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM intermediate-dense and output-LayerNorm deltas have been materialized into packaged model.safetensors"
    }
    if denseMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM output-dense delta has been materialized into packaged model.safetensors"
    }
    if intermediateMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM intermediate-dense delta has been materialized into packaged model.safetensors"
    }
    if layerNormMaterialized {
        return "Seen-native safetensors metadata; trained MiniLM output-LayerNorm delta has been materialized into packaged model.safetensors"
    }
    return "Seen-native safetensors metadata; no trained MiniLM intermediate-dense, output-dense, or output-LayerNorm delta was materialized into packaged weights"
}

fun copyBaseModelArtifacts(cfg: TrainerConfig) r: Int {
    if cfg.baseModelPath.length() == 0 {
        return 0
    }
    var count = 0
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "config.json")
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "tokenizer.json")
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "tokenizer_config.json")
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "special_tokens_map.json")
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "vocab.txt")
    count = count + copyArtifact(cfg.baseModelPath, cfg.outputModelDir, "model.safetensors")
    return count
}

fun copyArtifact(base: String, out: String, name: String) r: Int {
    let src = base + "/" + name
    if copyFileBytes(src, out + "/" + name) {
        return 1
    }
    return 0
}

fun copyIfPresent(src: String, dst: String) r: Bool {
    if not exists(src) {
        return false
    }
    return writeAtomicText(dst, readText(src))
}

fun modulesJson() r: String {
    return "[\n"
        + "  {\"idx\": 0, \"name\": \"0_Transformer\", \"path\": \"\", \"type\": \"sentence_transformers.models.Transformer\"},\n"
        + "  {\"idx\": 1, \"name\": \"1_Pooling\", \"path\": \"1_Pooling\", \"type\": \"sentence_transformers.models.Pooling\"}\n"
        + "]\n"
}

fun sentenceBertConfigJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + "  \"max_seq_length\": " + cfg.maxSequenceLength.toString() + ",\n"
        + "  \"do_lower_case\": true\n"
        + "}\n"
}

fun poolingConfigJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + "  \"word_embedding_dimension\": " + cfg.embeddingDim.toString() + ",\n"
        + "  \"pooling_mode_cls_token\": false,\n"
        + "  \"pooling_mode_mean_tokens\": true,\n"
        + "  \"pooling_mode_max_tokens\": false,\n"
        + "  \"pooling_mode_mean_sqrt_len_tokens\": false\n"
        + "}\n"
}

fun packageReadme(cfg: TrainerConfig) r: String {
    return "# Seen-native Sinai trainer package\n\n"
        + "This package was produced by the 100% Seen trainer project.\n"
        + "The active pooling contract is mean pooling for training, evaluation, and inference.\n\n"
        + trainerPackageReadmeNote(cfg)
}

fun adapterManifestJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + "  \"format\": \"seen-adapter-manifest-v1\",\n"
        + "  \"adapter_path\": \"" + cfg.adapterPath() + "\",\n"
        + "  \"minilm_intermediate_delta_path\": \"" + cfg.minilmIntermediateDeltaPath() + "\",\n"
        + "  \"minilm_intermediate_delta_exists\": " + exists(cfg.minilmIntermediateDeltaPath()).toString() + ",\n"
        + "  \"minilm_query_delta_path\": \"" + cfg.minilmQueryDeltaPath() + "\",\n"
        + "  \"minilm_query_delta_exists\": " + exists(cfg.minilmQueryDeltaPath()).toString() + ",\n"
        + "  \"minilm_key_delta_path\": \"" + cfg.minilmKeyDeltaPath() + "\",\n"
        + "  \"minilm_key_delta_exists\": " + exists(cfg.minilmKeyDeltaPath()).toString() + ",\n"
        + "  \"minilm_value_delta_path\": \"" + cfg.minilmValueDeltaPath() + "\",\n"
        + "  \"minilm_value_delta_exists\": " + exists(cfg.minilmValueDeltaPath()).toString() + ",\n"
        + "  \"minilm_attention_dense_delta_path\": \"" + cfg.minilmAttentionDenseDeltaPath() + "\",\n"
        + "  \"minilm_attention_dense_delta_exists\": " + exists(cfg.minilmAttentionDenseDeltaPath()).toString() + ",\n"
        + "  \"minilm_attention_layernorm_delta_path\": \"" + cfg.minilmAttentionLayerNormDeltaPath() + "\",\n"
        + "  \"minilm_attention_layernorm_delta_exists\": " + exists(cfg.minilmAttentionLayerNormDeltaPath()).toString() + ",\n"
        + "  \"minilm_dense_delta_path\": \"" + cfg.minilmDenseDeltaPath() + "\",\n"
        + "  \"minilm_dense_delta_exists\": " + exists(cfg.minilmDenseDeltaPath()).toString() + ",\n"
        + "  \"minilm_layernorm_delta_path\": \"" + cfg.minilmLayerNormDeltaPath() + "\",\n"
        + "  \"minilm_layernorm_delta_exists\": " + exists(cfg.minilmLayerNormDeltaPath()).toString() + ",\n"
        + "  \"minilm_dense_adapter_path\": \"" + cfg.minilmDenseAdapterPath() + "\",\n"
        + "  \"minilm_dense_adapter_exists\": " + exists(cfg.minilmDenseAdapterPath()).toString() + ",\n"
        + "  \"minilm_layer_adapter_path\": \"" + cfg.minilmLayerAdapterPath() + "\",\n"
        + "  \"minilm_layer_adapter_exists\": " + exists(cfg.minilmLayerAdapterPath()).toString() + ",\n"
        + "  \"layer_adapter_path\": \"" + cfg.layerAdapterPath() + "\",\n"
        + "  \"layer_adapter_exists\": " + exists(cfg.layerAdapterPath()).toString() + ",\n"
        + "  \"adapter_exists\": " + exists(cfg.adapterPath()).toString() + ",\n"
        + "  \"adapter_type\": \"low_rank_projection\",\n"
        + "  \"adapter_gradient\": \"normalized_cosine_low_rank_projection\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"applied_before_normalization\": true\n"
        + "}\n"
}

fun minilmDenseDeltaManifestJson(cfg: TrainerConfig, materialized: Bool) r: String {
    return "{\n"
        + "  \"format\": \"seen-minilm-output-dense-delta-manifest-v1\",\n"
        + "  \"minilm_dense_delta_path\": \"" + cfg.minilmDenseDeltaPath() + "\",\n"
        + "  \"minilm_dense_delta_exists\": " + exists(cfg.minilmDenseDeltaPath()).toString() + ",\n"
        + "  \"adapter_type\": \"minilm_output_dense_weight_bias_delta\",\n"
        + "  \"adapter_gradient\": \"output_dense_weight_bias_delta_to_output_layernorm_through_downstream_transformer_tail_to_mean_pool\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"attached_to\": \"" + minilmDenseAttachedTo(cfg) + "\",\n"
        + "  \"configured_layer\": " + cfg.minilmDenseAdapterLayer.toString() + ",\n"
        + "  \"gradient_scope\": \"output_dense_weight_bias_delta_to_output_layernorm_downstream_transformer_tail_to_mean_pool\",\n"
        + "  \"downstream_tail_transformer_backprop\": true,\n"
        + "  \"applied_before_output_layer_norm\": true,\n"
        + "  \"applied_before_pooling\": true,\n"
        + "  \"packaged_safetensors_path\": \"" + packagedWeightsPath(cfg) + "\",\n"
        + "  \"base_safetensors_rewritten\": " + materialized.toString() + "\n"
        + "}\n"
}

fun minilmAllLayerDeltasManifestJson(cfg: TrainerConfig, layers: Int, materialized: Int) r: String {
    return "{\n"
        + "  \"format\": \"seen-minilm-all-layer-deltas-manifest-v1\",\n"
        + "  \"layers\": " + layers.toString() + ",\n"
        + "  \"surfaces_per_layer\": 8,\n"
        + "  \"surface_names\": [\"attention.self.query\", \"attention.self.key\", \"attention.self.value\", \"attention.output.dense\", \"attention.output.LayerNorm\", \"intermediate.dense\", \"output.dense\", \"output.LayerNorm\"],\n"
        + "  \"delta_path_pattern\": \"" + cfg.outputModelDir + "/minilm_layer_{layer}_{surface}_delta.json\",\n"
        + "  \"adapter_gradient\": \"simultaneous_delta_aware_per_triplet_gradients_through_layer_tail_to_mean_pool\",\n"
        + "  \"update_mode\": \"accumulate_all_ready_layer_gradients_then_global_clip_then_base_parameter_adamw\",\n"
        + "  \"optimizer_parameterization\": \"loaded_safetensors_base_value_plus_seen_delta\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"packaged_safetensors_path\": \"" + packagedWeightsPath(cfg) + "\",\n"
        + "  \"materialized_surface_count\": " + materialized.toString() + ",\n"
        + "  \"base_safetensors_rewritten\": " + (materialized > 0).toString() + "\n"
        + "}\n"
}

fun minilmEmbeddingDeltasManifestJson(cfg: TrainerConfig, materialized: Bool) r: String {
    let path = miniLMEmbeddingDeltasPath(cfg.outputModelDir)
    return "{\n"
        + "  \"format\": \"seen-minilm-embedding-deltas-manifest-v1\",\n"
        + "  \"minilm_embedding_delta_path\": \"" + path + "\",\n"
        + "  \"minilm_embedding_delta_exists\": " + exists(path).toString() + ",\n"
        + "  \"adapter_type\": \"minilm_sparse_embedding_rows_and_embedding_layernorm_delta\",\n"
        + "  \"adapter_gradient\": \"sparse_embedding_rows_and_embedding_layernorm_through_delta_aware_all_ready_transformer_layers_to_mean_pool\",\n"
        + "  \"adapter_optimizer\": \"adamw\",\n"
        + "  \"update_mode\": \"sparse_row_gradients_then_base_parameter_adamw\",\n"
        + "  \"optimizer_parameterization\": \"loaded_safetensors_base_value_plus_seen_delta\",\n"
        + "  \"surface_names\": [\"embeddings.word_embeddings.sparse_rows\", \"embeddings.position_embeddings.sparse_rows\", \"embeddings.token_type_embeddings.sparse_rows\", \"embeddings.LayerNorm\"],\n"
        + "  \"packaged_safetensors_path\": \"" + packagedWeightsPath(cfg) + "\",\n"
        + "  \"base_safetensors_rewritten\": " + materialized.toString() + "\n"
        + "}\n"
}

fun minilmIntermediateDeltaManifestJson(cfg: TrainerConfig, materialized: Bool) r: String {
    return "{\n"
        + "  \"format\": \"seen-minilm-intermediate-dense-delta-manifest-v1\",\n"
        + "  \"minilm_intermediate_delta_path\": \"" + cfg.minilmIntermediateDeltaPath() + "\",\n"
        + "  \"minilm_intermediate_delta_exists\": " + exists(cfg.minilmIntermediateDeltaPath()).toString() + ",\n"
        + "  \"adapter_type\": \"minilm_intermediate_dense_weight_bias_delta\",\n"
