        + "  \"gradient_scope\": \"intermediate_dense_delta_to_mean_pool_via_target_layer_output_and_downstream_tail\",\n"
        + "  \"downstream_tail_transformer_backprop\": true,\n"
        + "  \"applied_before_gelu\": true,\n"
