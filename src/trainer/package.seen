fun minilmDenseAttachedTo(cfg: TrainerConfig) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.output.dense"
    }
    return "encoder.layer." + cfg.minilmDenseAdapterLayer.toString() + ".output.dense"
}

fun minilmIntermediateAttachedTo(cfg: TrainerConfig) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.intermediate.dense"
    }
    return "encoder.layer." + cfg.minilmDenseAdapterLayer.toString() + ".intermediate.dense"
}

fun minilmSelfAttentionAttachedTo(cfg: TrainerConfig, projection: String) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.attention.self." + projection
    }
    return "encoder.layer." + cfg.minilmDenseAdapterLayer.toString() + ".attention.self." + projection
}

fun minilmAttentionDenseAttachedTo(cfg: TrainerConfig) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.attention.output.dense"
    }
    return "encoder.layer." + cfg.minilmDenseAdapterLayer.toString() + ".attention.output.dense"
}

fun minilmAttentionLayerNormAttachedTo(cfg: TrainerConfig) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.attention.output.LayerNorm"
    }
    return "encoder.layer." + cfg.minilmDenseAdapterLayer.toString() + ".attention.output.LayerNorm"
}

fun minilmLayerNormAttachedTo(cfg: TrainerConfig) r: String {
    if cfg.minilmDenseAdapterLayer < 0 {
        return "encoder.layer.final_ready.output.LayerNorm"
