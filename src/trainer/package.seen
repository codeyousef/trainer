    if not exists(cfg.minilmIntermediateDeltaPath()) {
        return false
    }
    let layer = normalizePackageDenseLayer(cfg.minilmDenseAdapterLayer, layers)
    if layer < 0 {
        return false
    }
    let info = SafeTensorInfo.inspect(packaged)
    let prefix = "encoder.layer." + layer.toString() + "."
    return materializeDenseDeltaSafetensors(info, packaged, prefix + "intermediate.dense.weight", prefix + "intermediate.dense.bias", cfg.minilmIntermediateDeltaPath(), hiddenSize, intermediateSize)
}

fun materializePackagedSelfAttentionDelta(cfg: TrainerConfig, layers: Int, hiddenSize: Int, projection: String, deltaPath: String) r: Bool {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return false
    }
    if not exists(deltaPath) {
        return false
    }
    let layer = normalizePackageDenseLayer(cfg.minilmDenseAdapterLayer, layers)
    if layer < 0 {
        return false
    }
    let info = SafeTensorInfo.inspect(packaged)
    let prefix = "encoder.layer." + layer.toString() + ".attention.self." + projection + "."
    return materializeDenseDeltaSafetensors(info, packaged, prefix + "weight", prefix + "bias", deltaPath, hiddenSize, hiddenSize)
}

