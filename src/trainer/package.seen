import io.file.{copyFileBytes, exists, readText}
import capabilities.{trainerCapabilitiesJson, trainerPackageReadmeNote}
import config.{TrainerConfig, resolvedParameterRegistryLoadCap}
import dense_lora.{miniLMLayerAttentionDenseDeltaPath, miniLMLayerAttentionLayerNormDeltaPath, miniLMLayerIntermediateDeltaPath, miniLMLayerKeyDeltaPath, miniLMLayerOutputDeltaPath, miniLMLayerOutputLayerNormDeltaPath, miniLMLayerQueryDeltaPath, miniLMLayerValueDeltaPath}
import embedding_delta.{miniLMEmbeddingDeltasPath}
import io_utils.{writeAtomicText}
import minilm_weights.{MiniLMWeightMap, writeMiniLMWeightMap}
import model.{readBertConfig}
import parameter_registry.{MiniLMParameterRegistry, writeMiniLMParameterRegistry}
import safetensors.{SafeTensorInfo, materializeDenseDeltaSafetensors, materializeEmbeddingDeltasSafetensors, materializeLayerNormDeltaSafetensors, writeSeenWeightsManifest}

class PackageResult {
    var outputDir: String
    var filesWritten: Int

    static fun new(outputDir: String, filesWritten: Int) r: PackageResult {
        return PackageResult{ outputDir: outputDir, filesWritten: filesWritten }
    }
}

fun writeModelPackage(cfg: TrainerConfig, parameterRegistry: MiniLMParameterRegistry) r: PackageResult {
    var files = 0
    let modelMeta = readBertConfig(cfg.modelConfigPath(), cfg.embeddingDim)
    if not exists(cfg.modelWeightsPath()) {
        return writeMinimalModelPackage(cfg)
    }
    if cfg.copyBaseArtifacts {
        files = files + copyBaseModelArtifacts(cfg)
    }
    let embeddingDeltaMaterialized = materializePackagedEmbeddingDeltas(cfg, modelMeta.hiddenSize)
    let allLayerDeltaMaterialized = materializePackagedAllLayerDeltas(cfg, modelMeta.layers, modelMeta.hiddenSize, modelMeta.intermediateSize)
    var denseDeltaMaterialized = false
    var intermediateDeltaMaterialized = false
    var queryDeltaMaterialized = false
    var keyDeltaMaterialized = false
    var valueDeltaMaterialized = false
    var attentionDenseDeltaMaterialized = false
    var attentionLayerNormDeltaMaterialized = false
    var layerNormDeltaMaterialized = false
    if allLayerDeltaMaterialized <= 0 {
        denseDeltaMaterialized = materializePackagedDenseDelta(cfg, modelMeta.layers, modelMeta.hiddenSize, modelMeta.intermediateSize)
        intermediateDeltaMaterialized = materializePackagedIntermediateDelta(cfg, modelMeta.layers, modelMeta.hiddenSize, modelMeta.intermediateSize)
        queryDeltaMaterialized = materializePackagedSelfAttentionDelta(cfg, modelMeta.layers, modelMeta.hiddenSize, "query", cfg.minilmQueryDeltaPath())
        keyDeltaMaterialized = materializePackagedSelfAttentionDelta(cfg, modelMeta.layers, modelMeta.hiddenSize, "key", cfg.minilmKeyDeltaPath())
        valueDeltaMaterialized = materializePackagedSelfAttentionDelta(cfg, modelMeta.layers, modelMeta.hiddenSize, "value", cfg.minilmValueDeltaPath())
        attentionDenseDeltaMaterialized = materializePackagedAttentionDenseDelta(cfg, modelMeta.layers, modelMeta.hiddenSize)
        attentionLayerNormDeltaMaterialized = materializePackagedAttentionLayerNormDelta(cfg, modelMeta.layers, modelMeta.hiddenSize)
        layerNormDeltaMaterialized = materializePackagedLayerNormDelta(cfg, modelMeta.layers, modelMeta.hiddenSize)
    }
    if writeAtomicText(cfg.outputModelDir + "/modules.json", modulesJson()) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/sentence_bert_config.json", sentenceBertConfigJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/1_Pooling/config.json", poolingConfigJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/README.md", packageReadme(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_adapter_manifest.json", adapterManifestJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_layer_adapter_manifest.json", layerAdapterManifestJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_layer_adapter_manifest.json", minilmLayerAdapterManifestJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_dense_adapter_manifest.json", minilmDenseAdapterManifestJson(cfg)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_dense_delta_manifest.json", minilmDenseDeltaManifestJson(cfg, denseDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_embedding_deltas_manifest.json", minilmEmbeddingDeltasManifestJson(cfg, embeddingDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_all_layer_deltas_manifest.json", minilmAllLayerDeltasManifestJson(cfg, modelMeta.layers, allLayerDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_intermediate_delta_manifest.json", minilmIntermediateDeltaManifestJson(cfg, intermediateDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_query_delta_manifest.json", minilmSelfAttentionDeltaManifestJson(cfg, "query", cfg.minilmQueryDeltaPath(), queryDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_key_delta_manifest.json", minilmSelfAttentionDeltaManifestJson(cfg, "key", cfg.minilmKeyDeltaPath(), keyDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_value_delta_manifest.json", minilmSelfAttentionDeltaManifestJson(cfg, "value", cfg.minilmValueDeltaPath(), valueDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_attention_dense_delta_manifest.json", minilmAttentionDenseDeltaManifestJson(cfg, attentionDenseDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_attention_layernorm_delta_manifest.json", minilmAttentionLayerNormDeltaManifestJson(cfg, attentionLayerNormDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_minilm_layernorm_delta_manifest.json", minilmLayerNormDeltaManifestJson(cfg, layerNormDeltaMaterialized)) { files = files + 1 }
    if writeAtomicText(cfg.outputModelDir + "/seen_trainer_capabilities.json", trainerCapabilitiesJson(cfg)) { files = files + 1 }
    let weights = SafeTensorInfo.inspect(packagedWeightsPathOrBase(cfg))
    let weightMap = MiniLMWeightMap.inspect(weights, modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, cfg.weightLoadCapElements)
    if writeMiniLMWeightMap(cfg.outputModelDir + "/minilm_weight_map.json", weightMap) {
        files = files + 1
    }
    var packageRegistry = parameterRegistry
    if parameterRegistry.optimizerUpdates <= 0 {
        packageRegistry = MiniLMParameterRegistry.inspect(weights, modelMeta.hiddenSize, modelMeta.layers, modelMeta.intermediateSize, resolvedParameterRegistryLoadCap(cfg), cfg.backend)
    }
    if writeMiniLMParameterRegistry(cfg.outputModelDir + "/minilm_parameter_registry.json", packageRegistry) {
        files = files + 1
    }
    if writeSeenWeightsManifest(cfg.outputModelDir + "/model.safetensors.manifest.json", cfg.embeddingDim, weights, packageWeightsManifestNote(denseDeltaMaterialized, intermediateDeltaMaterialized, queryDeltaMaterialized, keyDeltaMaterialized, valueDeltaMaterialized, attentionDenseDeltaMaterialized, attentionLayerNormDeltaMaterialized, layerNormDeltaMaterialized, allLayerDeltaMaterialized, embeddingDeltaMaterialized)) {
        files = files + 1
    }
    copyIfPresent(cfg.thresholdsPath, cfg.outputModelDir + "/thresholds.json")
    copyIfPresent(cfg.evalResultsPath, cfg.outputModelDir + "/eval_results.json")
    return PackageResult.new(cfg.outputModelDir, files)
}

fun writeMinimalModelPackage(cfg: TrainerConfig) r: PackageResult {
    var files = 0
    if writeAtomicText(cfg.outputModelDir + "/modules.json", modulesJson()) { files = files + 1 }
    return PackageResult.new(cfg.outputModelDir, files)
}

fun packagedWeightsPath(cfg: TrainerConfig) r: String {
    return cfg.outputModelDir + "/model.safetensors"
}

fun packagedWeightsPathOrBase(cfg: TrainerConfig) r: String {
    let packaged = packagedWeightsPath(cfg)
    if exists(packaged) {
        return packaged
    }
    return cfg.modelWeightsPath()
}

fun materializePackagedEmbeddingDeltas(cfg: TrainerConfig, hiddenSize: Int) r: Bool {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return false
    }
    let deltaPath = miniLMEmbeddingDeltasPath(cfg.outputModelDir)
    if not exists(deltaPath) {
        return false
    }
    let info = SafeTensorInfo.inspect(packaged)
    return materializeEmbeddingDeltasSafetensors(info, packaged, deltaPath, hiddenSize)
}

fun materializePackagedDenseDelta(cfg: TrainerConfig, layers: Int, hiddenSize: Int, intermediateSize: Int) r: Bool {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return false
    }
    if not exists(cfg.minilmDenseDeltaPath()) {
        return false
    }
    let layer = normalizePackageDenseLayer(cfg.minilmDenseAdapterLayer, layers)
    if layer < 0 {
        return false
    }
    let info = SafeTensorInfo.inspect(packaged)
    let prefix = "encoder.layer." + layer.toString() + "."
    return materializeDenseDeltaSafetensors(info, packaged, prefix + "output.dense.weight", prefix + "output.dense.bias", cfg.minilmDenseDeltaPath(), intermediateSize, hiddenSize)
}

fun materializePackagedAllLayerDeltas(cfg: TrainerConfig, layers: Int, hiddenSize: Int, intermediateSize: Int) r: Int {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return 0
    }
    let info = SafeTensorInfo.inspect(packaged)
    if not info.validHeader {
        return 0
    }
    var materialized = 0
    var layer = 0
    while layer < layers {
        let prefix = "encoder.layer." + layer.toString() + "."
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "attention.self.query.weight", prefix + "attention.self.query.bias", miniLMLayerQueryDeltaPath(cfg.outputModelDir, layer), hiddenSize, hiddenSize) { materialized = materialized + 1 }
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "attention.self.key.weight", prefix + "attention.self.key.bias", miniLMLayerKeyDeltaPath(cfg.outputModelDir, layer), hiddenSize, hiddenSize) { materialized = materialized + 1 }
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "attention.self.value.weight", prefix + "attention.self.value.bias", miniLMLayerValueDeltaPath(cfg.outputModelDir, layer), hiddenSize, hiddenSize) { materialized = materialized + 1 }
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "attention.output.dense.weight", prefix + "attention.output.dense.bias", miniLMLayerAttentionDenseDeltaPath(cfg.outputModelDir, layer), hiddenSize, hiddenSize) { materialized = materialized + 1 }
        if materializeLayerNormDeltaSafetensors(info, packaged, prefix + "attention.output.LayerNorm.weight", prefix + "attention.output.LayerNorm.bias", miniLMLayerAttentionLayerNormDeltaPath(cfg.outputModelDir, layer), hiddenSize) { materialized = materialized + 1 }
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "intermediate.dense.weight", prefix + "intermediate.dense.bias", miniLMLayerIntermediateDeltaPath(cfg.outputModelDir, layer), hiddenSize, intermediateSize) { materialized = materialized + 1 }
        if materializeDenseDeltaSafetensors(info, packaged, prefix + "output.dense.weight", prefix + "output.dense.bias", miniLMLayerOutputDeltaPath(cfg.outputModelDir, layer), intermediateSize, hiddenSize) { materialized = materialized + 1 }
        if materializeLayerNormDeltaSafetensors(info, packaged, prefix + "output.LayerNorm.weight", prefix + "output.LayerNorm.bias", miniLMLayerOutputLayerNormDeltaPath(cfg.outputModelDir, layer), hiddenSize) { materialized = materialized + 1 }
        layer = layer + 1
    }
    return materialized
}

fun materializePackagedIntermediateDelta(cfg: TrainerConfig, layers: Int, hiddenSize: Int, intermediateSize: Int) r: Bool {
    let packaged = packagedWeightsPath(cfg)
    if not exists(packaged) {
        return false
