        + "  \"packaged_safetensors_path\": \"" + packagedWeightsPath(cfg) + "\",\n"
        + "  \"base_safetensors_rewritten\": " + materialized.toString() + "\n"
        + "}\n"
}

fun minilmSelfAttentionDeltaManifestJson(cfg: TrainerConfig, projection: String, deltaPath: String, materialized: Bool) r: String {
    return "{\n"
        + "  \"format\": \"seen-minilm-attention-" + projection + "-delta-manifest-v1\",\n"
