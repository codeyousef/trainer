fun tensorGpuMatmul(a: Array<Float>, b: Array<Float>, rows: Int, shared: Int,
    cols: Int) r: TensorGpuFloatResult {

    if rows <= 0 or shared <= 0 or cols <= 0 {
        return TensorGpuFloatResult.failure()
    }
    if a.length() < rows * shared or b.length() < shared * cols {
        return TensorGpuFloatResult.failure()
    }

    let outValues = tensorGpuFloatArray(rows * cols, 0.0)
    let aBuf = tensorGpuFloatBuffer(a)
    let bBuf = tensorGpuFloatBuffer(b)
    let outBuf = tensorGpuFloatBuffer(outValues)
    let rowsBuf = tensorGpuIntScalar(rows)
    let sharedBuf = tensorGpuIntScalar(shared)
    let colsBuf = tensorGpuIntScalar(cols)
    if aBuf == 0 or bBuf == 0 or outBuf == 0 or rowsBuf == 0 or sharedBuf == 0 or colsBuf == 0 {
        tensorGpuDestroyBuffer(aBuf)
        tensorGpuDestroyBuffer(bBuf)
        tensorGpuDestroyBuffer(outBuf)
        tensorGpuDestroyBuffer(rowsBuf)
        tensorGpuDestroyBuffer(sharedBuf)
        tensorGpuDestroyBuffer(colsBuf)
        return TensorGpuFloatResult.failure()
    }

    let handles = Array<Int>()
    handles.push(aBuf)
    handles.push(bBuf)
    handles.push(outBuf)
    handles.push(rowsBuf)
    handles.push(sharedBuf)
    handles.push(colsBuf)
    let ok = tensorGpuRun("tensorMatmul", 6, tensorGpuDivCeil(cols, 16), tensorGpuDivCeil(rows, 16), 1, handles)
    if ok {
        let _ = seen_gpu_buffer_read_float_array(outBuf, outValues, outValues.length())
    }
    tensorGpuDestroyBuffer(aBuf)
    tensorGpuDestroyBuffer(bBuf)
    tensorGpuDestroyBuffer(outBuf)
    tensorGpuDestroyBuffer(rowsBuf)
    tensorGpuDestroyBuffer(sharedBuf)
    tensorGpuDestroyBuffer(colsBuf)
    if ok {
        return TensorGpuFloatResult.success(outValues)
    }
    return TensorGpuFloatResult.failure()
}

