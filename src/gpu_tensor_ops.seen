fun tensorGpuTopKInnerProductIndices(query: Array<Float>, candidates: Array<Float>,
    rows: Int, cols: Int, k: Int) r: TensorGpuIntResult {

    if rows <= 0 or cols <= 0 or k <= 0 or query.length() < cols or candidates.length() < rows * cols {
        return TensorGpuIntResult.failure()
    }
    var keep = k
    if keep > rows { keep = rows }
    let indices = tensorGpuIntArray(keep, -1)
    let scores = tensorGpuFloatArray(keep, -999999.0)
    let queryBuf = tensorGpuFloatBuffer(query)
    let candidatesBuf = tensorGpuFloatBuffer(candidates)
    let indicesBuf = tensorGpuIntBuffer(indices)
    let scoresBuf = tensorGpuFloatBuffer(scores)
    let rowsBuf = tensorGpuIntScalar(rows)
    let colsBuf = tensorGpuIntScalar(cols)
    let kBuf = tensorGpuIntScalar(keep)
    if queryBuf == 0 or candidatesBuf == 0 or indicesBuf == 0 or scoresBuf == 0 or rowsBuf == 0 or colsBuf == 0 or kBuf == 0 {
        tensorGpuDestroyBuffer(queryBuf)
        tensorGpuDestroyBuffer(candidatesBuf)
        tensorGpuDestroyBuffer(indicesBuf)
        tensorGpuDestroyBuffer(scoresBuf)
        tensorGpuDestroyBuffer(rowsBuf)
        tensorGpuDestroyBuffer(colsBuf)
        tensorGpuDestroyBuffer(kBuf)
        return TensorGpuIntResult.failure()
    }
    let handles = Array<Int>()
    handles.push(queryBuf)
    handles.push(candidatesBuf)
    handles.push(indicesBuf)
    handles.push(scoresBuf)
    handles.push(rowsBuf)
    handles.push(colsBuf)
    handles.push(kBuf)
    let ok = tensorGpuRun("tensorTopKInnerProduct", 7, 1, 1, 1, handles)
    if ok {
        let _ = seen_gpu_buffer_read_int_array(indicesBuf, indices, indices.length())
    }
    tensorGpuDestroyBuffer(queryBuf)
    tensorGpuDestroyBuffer(candidatesBuf)
    tensorGpuDestroyBuffer(indicesBuf)
    tensorGpuDestroyBuffer(scoresBuf)
    tensorGpuDestroyBuffer(rowsBuf)
    tensorGpuDestroyBuffer(colsBuf)
    tensorGpuDestroyBuffer(kBuf)
    if ok {
        return TensorGpuIntResult.success(indices)
    }
    return TensorGpuIntResult.failure()
}
