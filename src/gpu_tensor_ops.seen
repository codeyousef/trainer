fun tensorGpuMeanPool(values: Array<Float>, mask: Array<Int>, rows: Int,
    cols: Int) r: TensorGpuFloatResult {

    if rows <= 0 or cols <= 0 or values.length() < rows * cols or mask.length() < rows {
        return TensorGpuFloatResult.failure()
    }
    let outValues = tensorGpuFloatArray(cols, 0.0)
    let inBuf = tensorGpuFloatBuffer(values)
    let maskBuf = tensorGpuIntBuffer(mask)
    let outBuf = tensorGpuFloatBuffer(outValues)
    let rowsBuf = tensorGpuIntScalar(rows)
    let colsBuf = tensorGpuIntScalar(cols)
    if inBuf == 0 or maskBuf == 0 or outBuf == 0 or rowsBuf == 0 or colsBuf == 0 {
        tensorGpuDestroyBuffer(inBuf)
        tensorGpuDestroyBuffer(maskBuf)
        tensorGpuDestroyBuffer(outBuf)
        tensorGpuDestroyBuffer(rowsBuf)
        tensorGpuDestroyBuffer(colsBuf)
        return TensorGpuFloatResult.failure()
    }
    let handles = Array<Int>()
    handles.push(inBuf)
    handles.push(maskBuf)
    handles.push(outBuf)
    handles.push(rowsBuf)
    handles.push(colsBuf)
    let ok = tensorGpuRun("tensorMeanPool", 5, tensorGpuDivCeil(cols, 256), 1, 1, handles)
    if ok {
        let _ = seen_gpu_buffer_read_float_array(outBuf, outValues, outValues.length())
    }
    tensorGpuDestroyBuffer(inBuf)
    tensorGpuDestroyBuffer(maskBuf)
    tensorGpuDestroyBuffer(outBuf)
    tensorGpuDestroyBuffer(rowsBuf)
    tensorGpuDestroyBuffer(colsBuf)
    if ok {
        return TensorGpuFloatResult.success(outValues)
    }
    return TensorGpuFloatResult.failure()
}

