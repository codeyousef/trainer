import config.{TrainerConfig}
import io.file.{exists}

fun trainerTrainingMode() r: String {
    return "seen_native_minilm_embedding_and_layer_delta_v1"
}

fun trainerCapabilityFields(cfg: TrainerConfig) r: String {
    return "  \"implementation_language\": \"seen\",\n"
        + "  \"training_mode\": \"" + trainerTrainingMode() + "\",\n"
        + "  \"pooling_contract\": \"mean_pooling_for_training_eval_inference\",\n"
        + "  \"backend\": \"" + cfg.backend + "\",\n"
        + "  \"base_encoder_forward_ready_when_weights_loaded\": " + exists(cfg.modelWeightsPath()).toString() + ",\n"
        + "  \"source_input_streaming\": true,\n"
        + "  \"bounded_data_mode\": " + boundedDataMode(cfg).toString() + ",\n"
        + "  \"max_source_pairs\": " + cfg.maxSourcePairs.toString() + ",\n"
        + "  \"max_mined_triplets\": " + cfg.maxMinedTriplets.toString() + ",\n"
        + "  \"max_train_triplets\": " + cfg.maxTrainTriplets.toString() + ",\n"
        + "  \"max_calibration_triplets\": " + cfg.maxCalibrationTriplets.toString() + ",\n"
        + "  \"max_eval_triplets\": " + cfg.maxEvalTriplets.toString() + ",\n"
        + "  \"trainable_surface_summary\": \"MiniLM deltas and projection adapters\",\n"
        + "  \"copy_base_artifacts\": " + cfg.copyBaseArtifacts.toString() + ",\n"
        + "  \"train_all_minilm_layers\": " + cfg.trainAllMiniLMLayers.toString() + ",\n"
        + "  \"gpu_backend_requested\": " + (cfg.backendGpu == 1).toString() + ",\n"
        + "  \"hard_negative_mining\": \"normalized_top_k_with_domain_source_exclusion\",\n"
        + "  \"calibration\": \"per_domain_percentile_positive_cosine\",\n"
        + "  \"package_format\": \"sentence_transformer_compatible_with_seen_manifests\""
}

fun boundedDataMode(cfg: TrainerConfig) r: Bool {
    return cfg.maxSourcePairs > 0 or cfg.maxMinedTriplets > 0 or cfg.maxTrainTriplets > 0 or cfg.maxCalibrationTriplets > 0 or cfg.maxEvalTriplets > 0
}

fun trainerCapabilitiesJson(cfg: TrainerConfig) r: String {
    return "{\n"
        + trainerCapabilityFields(cfg) + "\n"
        + "}\n"
}

fun trainerPackageReadmeNote(cfg: TrainerConfig) r: String {
    return "The trainer is implemented in Seen, uses mean pooling for training/evaluation/inference, and emits a SentenceTransformer-compatible package with Seen manifests. This package " + packageBaseArtifactNote(cfg) + ".\n"
}

fun packageBaseArtifactNote(cfg: TrainerConfig) r: String {
    if cfg.copyBaseArtifacts {
        return "flushes Seen deltas into a safetensors base-weight artifact"
    }
    return "persists Seen deltas as package-side delta artifacts without copying base safetensors"
}
